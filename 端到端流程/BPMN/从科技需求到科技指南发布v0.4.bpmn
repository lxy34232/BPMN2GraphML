    <bpmn2:manualTask id="EBPM_a9e2962a-c6dc-45bd-8bb1-3ac6c1fb94c1" name="核验评估数据与统计口径">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="对各类评估资料开展完整性、一致性和可追溯性核验，统一统计口径，检查数据之间及不同评估周期之间的可比性，形成数据核验结果和问题清单。" />
          <b2g:property name="输入" value="规划任务完成情况表" />
          <b2g:property name="输入" value="科研项目立项与完成情况表" />
          <b2g:property name="输入" value="科技成果工程化应用情况表" />
          <b2g:property name="输入" value="平台化模块化成果运用情况表" />
          <b2g:property name="输入" value="科技人才梯队建设情况表" />
          <b2g:property name="输入" value="重大科技成果情况表" />
          <b2g:property name="输入" value="科研经费投入情况表" />
          <b2g:property name="输入" value="质量攻关问题情况表" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="公司技术架构" />
          <b2g:property name="输出" value="评估数据核验记录" />
          <b2g:property name="输出" value="核验后评估数据集" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_4deb2ba5-a470-4ccd-9270-3de9505f0335</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_863cc838-1af2-4332-95d1-68e90849893d</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_ce0e09d9-17d1-49c6-8cfb-35fdde610525" name="评估数据是否完整准确？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="检查关键评估资料是否完整、来源是否可靠、统计口径是否一致，相关成果是否能够对应规划任务和科研活动。满足要求后进入评估分析，否则补充核实。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_863cc838-1af2-4332-95d1-68e90849893d</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_2597c10b-9372-46f7-b452-445f8445c66e</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_2bb4b8c5-7071-4f38-b234-dad34b86ae9a</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_03bfc506-36e1-42e3-b0ce-afba92843bb6" name="补充核实评估数据">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="依据核验发现的问题，补充缺失资料、核实数据来源并修正不一致内容，完善必要的证明依据，形成满足分析要求的评估数据。" />
          <b2g:property name="输入" value="评估数据核验记录" />
          <b2g:property name="输出" value="核验后评估数据集" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_2bb4b8c5-7071-4f38-b234-dad34b86ae9a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_2c79d96c-51fa-4811-87e8-f00966511e53</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_9c48bafd-7da0-4c4c-ac3c-b94b20804eb0" name="评估数据录入DOORS并建立追溯">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="将科研项目和规划实施评估数据纳入DOORS，更新任务与项目状态，建立与规划、指南及相关成果的关联关系，形成可用于实施统计和历史比较的评估记录。" />
          <b2g:property name="输入" value="核验后评估数据集" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="科研项目指南正式基线" />
          <b2g:property name="输出" value="科研项目台账DOORS模块" />
          <b2g:property name="输出" value="规划实施评估DOORS模块" />
          <b2g:property name="输出" value="项目至指南追溯链接" />
          <b2g:property name="输出" value="评估至规划追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_2597c10b-9372-46f7-b452-445f8445c66e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d4bf1dff-ed59-4c64-85d4-583b89b8dc90</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_fb617bd5-b37b-4b7e-8d89-69dc24a373f6" name="开展追溯统计与完成度分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="沿规划任务、指南和科研项目之间的追溯关系，分析任务落实、目标达成和成果产出情况，结合阶段进度与技术架构判断资源投入、能力提升及重点方向的实施效果，识别偏差和薄弱环节。" />
          <b2g:property name="输入" value="规划实施评估DOORS模块" />
          <b2g:property name="输入" value="项目至指南追溯链接" />
          <b2g:property name="输入" value="评估至规划追溯链接" />
          <b2g:property name="输入" value="核验后评估数据集" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="技术架构多维统计数据" />
          <b2g:property name="输出" value="规划实施完成度分析表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
          <b2g:property name="信息系统" value="TechArchi技术地图" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d4bf1dff-ed59-4c64-85d4-583b89b8dc90</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_3aa43882-ec3d-474b-99e3-97247fcc7ff3</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_7ce65fdc-cffe-40e4-b296-c31133ae4fa5" name="分析偏差原因并提出调整建议">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="针对任务进度、指标达成和能力建设中的偏差，分析技术路径、资源条件及协同机制等方面的原因，提出改进措施和年度指南调整建议，必要时提出规划修编建议。" />
          <b2g:property name="输入" value="规划实施完成度分析表" />
          <b2g:property name="输入" value="核验后评估数据集" />
          <b2g:property name="输出" value="规划实施评估调整建议" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3aa43882-ec3d-474b-99e3-97247fcc7ff3</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_efc9db82-af3f-4dfa-a212-b479910e5189</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_01ec1ccd-e43a-4ab5-8084-38e569f7377d" name="形成规划实施评估报告">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="综合任务进展、目标达成、代表性成果及主要问题，形成与评估阶段相适应的实施评估报告，提出改进和调整建议，为年度安排、滚动修编及下一周期规划提供依据。" />
          <b2g:property name="输入" value="规划实施完成度分析表" />
          <b2g:property name="输入" value="规划实施评估调整建议" />
          <b2g:property name="输入" value="《规划实施评估工作方案》" />
          <b2g:property name="输出" value="《规划实施评估报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_efc9db82-af3f-4dfa-a212-b479910e5189</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_eaf7af08-36a9-4c39-bb87-593261d11295</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_70c8b9f6-76c8-4afc-aa94-3f294b2e2868" name="审定规划实施评估报告">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="对评估依据、分析结论和调整建议进行审核确认，形成经审定的评估成果，明确其在任务安排、资源配置和后续规划管理中的应用要求。" />
          <b2g:property name="输入" value="《规划实施评估报告》" />
          <b2g:property name="输出" value="评估报告审定意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_eaf7af08-36a9-4c39-bb87-593261d11295</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_994e6bf2-3a16-4374-b3c0-e823243a373f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_5af235f6-339d-4aca-a886-f7f1d7f8fe5a" name="发布规划实施评估基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="对评估记录及相关项目数据建立协调一致的基线，保留各期评估所依据的实施状态与分析成果，支持历史追溯、趋势比较和后续复核。" />
          <b2g:property name="输入" value="规划实施评估DOORS模块" />
          <b2g:property name="输入" value="科研项目台账DOORS模块" />
          <b2g:property name="输入" value="评估报告审定意见" />
          <b2g:property name="输出" value="规划实施评估基线" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_994e6bf2-3a16-4374-b3c0-e823243a373f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_90c04dac-7e1c-4fe1-b852-40dfbc8b00ff</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_6414c845-bb78-4fdf-b5c0-430343da1bfa" name="是否为规划期总结评估？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="根据评估阶段判断后续路径。属于规划期总结评估的，进入本周期收官；属于年度或中期评估的，继续判断是否需要滚动修编。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_90c04dac-7e1c-4fe1-b852-40dfbc8b00ff</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f308c21c-ce2d-4b86-837e-d805e19c8747</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_b9b2006f-dbdd-44c7-93a3-63b27c281f18</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="EBPM_3debe33b-0f59-406a-b899-ee50b62231f6" name="是否需要滚动修编规划？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="结合外部环境、发展要求和评估结论，判断规划目标、重点方向或重大任务是否需要实质性调整。需要调整的启动滚动修编；一般实施偏差通过后续年度任务和指南安排优化处理。" />
          <b2g:property name="输出" value="规划修编需求" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b9b2006f-dbdd-44c7-93a3-63b27c281f18</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_72220bfc-6c8c-45a5-a8dc-24c304a08b37</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_44b0ba9c-54fb-4cbe-aab0-fc07a528714d</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="EBPM_1c7ccfb5-0cd3-4b60-a6a5-89f9bb3d7c90" name="科技规划周期已收官">

    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_968dad0c-f9c0-477e-bbbe-928318c5b773" name="统稿形成规划初稿">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="整合各部分编制成果，统一术语、数据口径和表达风格，检查目标、任务与保障措施之间的一致性，协调交叉内容和衔接问题，形成完整的规划初稿。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="输入" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="输入" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="输入" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="输入" value="规划重点任务清单" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输出" value="科技发展规划初稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8afeb90d-7ac5-49a6-8306-6bc00aa3a1ca</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e280f967-5890-4902-9f3e-12d8f3c8212f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_dd4b9c3d-e46f-4dea-8513-32f5ce337b75" name="科技发展规划规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按照统一规范将规划初稿导入DOORS，保持章节结构和内容完整性，完善重点任务等必要信息，形成用于修订、追溯和后续实施管理的规划数据。" />
          <b2g:property name="输入" value="科技发展规划初稿" />
          <b2g:property name="输入" value="规划重点任务清单" />
          <b2g:property name="输入" value="DOORS模块模板与链接模块" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e280f967-5890-4902-9f3e-12d8f3c8212f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f4f4c1f2-b548-4aa9-b3e6-63fb55752c40</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_194f663b-7216-4080-a7c6-da9eaec2a7d3" name="创建科技发展规划与科技发展规划大纲的追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="建立规划内容与大纲条目之间的承接关系，明确规划目标和任务的大纲依据，形成需求、大纲与规划相互贯通的追溯链路。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="大纲与规划章节对应表" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />

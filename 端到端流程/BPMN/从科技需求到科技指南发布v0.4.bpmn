      <bpmn2:incoming>EBPM_848d6194-1c43-4fb7-9603-6741b6bb2730</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7997ffd7-0c38-4188-bc1b-6c4ebdce522c</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_8925c616-ad41-44f2-b328-85621b463068" name="总经理办公会是否审议通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="依据审议结论判断是否具备正式发布条件。审议通过且一般修改已落实的进入印发；存在实质性调整要求的，退回修订并按程序再次确认。" />
          <b2g:property name="责任主体" value="总经理办公会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7997ffd7-0c38-4188-bc1b-6c4ebdce522c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d82b28b0-76e9-47b6-8ca9-679959b89c8c</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_4bc403d1-e27a-4774-a5ae-572f2a85179a</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_9776faa1-9be9-4797-aafa-850b737328ee" name="印发科技发展规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="落实审议要求，完成规划文本及相关数据的最终核对，按照规定程序正式印发，形成对后续科技工作具有指导作用的规划文件。" />
          <b2g:property name="输入" value="总经理办公会审议意见" />

    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_191b9b59-872f-4b3a-baef-a7eb8f74c66d" name="提出科研指南修订意见">
      <bpmn2:extensionElements>
        <b2g:properties>

      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_146aaec5-0e2d-4b13-8e6d-5aa39d9df95b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e3703d16-7e92-4ced-9518-22d00672643b</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_1cee20f5-3628-4831-97be-de6dfd640d17" name="收集产品平台化模块化成果运用情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="收集产品平台与核心模块的建设、应用和复用情况，分析其对研发效率、开发周期和成本改善的作用，形成平台化模块化建设成效资料。" />
          <b2g:property name="输入" value="产品平台与核心模块目录" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="平台化模块化成果运用情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />

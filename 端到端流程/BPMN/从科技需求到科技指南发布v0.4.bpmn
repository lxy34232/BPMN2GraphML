    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_3e3061a3-caa8-4fdc-9dff-5884ccbc8e08" name="创建科研项目指南与科技发展规划的追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>

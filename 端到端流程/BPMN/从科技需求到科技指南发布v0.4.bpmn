      <bpmn2:incoming>EBPM_d82b28b0-76e9-47b6-8ca9-679959b89c8c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7720c214-c637-48b7-911f-909108988b9e</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_5e5b6c16-2a74-448d-8a33-3e9352083563" name="发布科技发展规划正式基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="对正式发布的规划及相关依据和意见处理成果建立受控基线，保证基线内容与发布文本一致，作为年度指南编制和实施评估的统一依据。后续变更按规定程序管理。" />
          <b2g:property name="输入" value="科技发展规划正式印发文件" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="科技发展规划正式基线" />

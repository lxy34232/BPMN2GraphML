          <b2g:property name="步骤描述" value="依据确认的意见处理结论修订指南条目，同步更新DOORS数据和相关追溯关系，核查修订后的规划一致性，形成指南修订稿。" />
          <b2g:property name="输入" value="指南意见处理表" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />

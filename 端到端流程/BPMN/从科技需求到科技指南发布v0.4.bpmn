      <bpmn2:outgoing>EBPM_6d874cc0-aa35-4361-8b56-9a01f3476718</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_4ae59c00-9294-43dd-b9b5-e774192fffb1">

      <bpmn2:outgoing>EBPM_3b9881c4-eba1-43c9-a260-3605b6d7227c</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_4e46afae-4ade-4ff4-aeb3-23d92829a964" name="调整指南条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="依据分析结果补充、整合或调整指南条目，完善规划关联关系，对暂缓安排的任务说明理由，形成依据充分、布局协调的指南内容。" />
          <b2g:property name="输入" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="指南至规划追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3b9881c4-eba1-43c9-a260-3605b6d7227c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f9f7581d-93dc-434d-b352-36403d891a65</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_9e3c32bd-8c5d-4e0c-9848-2d20ebc24651" name="发布科研项目指南征求意见稿基线">
      <bpmn2:extensionElements>
        <b2g:properties>

    <bpmn2:userTask id="EBPM_fa55cd12-bb3a-4231-8447-7a9d5f21ff84" name="开展需求覆盖性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="分析大纲对关键需求和一般需求的覆盖情况，核查大纲条目的依据是否充分，识别遗漏、重复及缺乏依据的内容，形成覆盖性分析结论和完善建议。" />
          <b2g:property name="输入" value="大纲至需求追溯链接" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输出" value="《需求覆盖性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8e707bb5-b307-4c9d-b97b-90ec079aa0e2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d591bfea-2779-4823-aa06-b40a3281f0c7</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_7cd80811-7843-4523-8ba3-abc683b3fb04" name="关键需求是否全部覆盖？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="检查关键需求是否已在大纲中体现，未纳入内容是否具有经确认的理由，大纲条目是否具备充分依据。满足要求后进入大纲审查，否则补充调整。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d591bfea-2779-4823-aa06-b40a3281f0c7</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_05257214-9ffb-42cf-95f5-2f73b08a39f4</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_8e75cf59-e471-4bf8-8377-e114f63b202b</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_9d3a75c0-a557-441c-acf5-7588ab7f41d1" name="组织大纲研讨审查">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="对大纲框架、主题设置和主要方向开展研讨审查，重点判断其与上位要求、发展战略及规划需求的衔接情况，形成大纲审查意见。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="《需求覆盖性分析报告》" />
          <b2g:property name="输出" value="大纲审查意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_05257214-9ffb-42cf-95f5-2f73b08a39f4</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_0b3e29d3-31d1-43fd-9f90-6f38965e541f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_27beeb3c-4d4b-4fde-966a-df1050836c1c" name="大纲是否通过审查？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="依据审查结论判断大纲是否满足编制要求。不存在影响框架和主要方向的实质性问题，且一般修改意见已明确处理安排的，进入基线发布；否则退回调整。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_0b3e29d3-31d1-43fd-9f90-6f38965e541f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_69b5201a-f2e0-42fc-97c9-8ef24e0ad116</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_e72b448a-5ce7-48f2-a697-df88bc86d15b</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="EBPM_17e71084-fd29-4c73-9363-53f9841220a2">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8e75cf59-e471-4bf8-8377-e114f63b202b</bpmn2:incoming>
      <bpmn2:incoming>EBPM_e72b448a-5ce7-48f2-a697-df88bc86d15b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_bee181ff-8077-46fa-bb95-15ec285fe41f</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_c8d52336-0808-4fa3-bcc5-28be131b9ea0" name="补充调整大纲条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="依据覆盖性分析和审查意见，补充、调整或整合大纲条目，同步完善需求依据和追溯关系，对未采纳内容说明理由，形成满足审查要求的大纲成果。" />
          <b2g:property name="输入" value="《需求覆盖性分析报告》" />
          <b2g:property name="输入" value="大纲审查意见" />
          <b2g:property name="输出" value="科技规划大纲DOORS模块" />
          <b2g:property name="输出" value="大纲至需求追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_bee181ff-8077-46fa-bb95-15ec285fe41f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_680e54a3-3702-4d8f-acb5-397ed45008f5</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_ec77a12a-0246-407d-aea0-71fae2a01cb6" name="科技规划大纲基线发布">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="对审查确认的大纲建立受控基线，作为规划文本编制和追溯管理的依据。后续大纲调整履行确认程序，并保留版本变化记录。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="大纲审查意见" />
          <b2g:property name="输出" value="科技规划大纲基线" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_69b5201a-f2e0-42fc-97c9-8ef24e0ad116</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_94f9ca2d-c025-45d0-b0a4-6bf256f86b32</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_dc1fe813-0de4-49be-954a-aa4d5e82e2d6" name="确定规划文本结构与编写分工">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="将大纲要求转化为规划文本的章节结构，明确各部分的内容边界、衔接关系和编写安排，统一表达要求，形成规划文本编制框架。" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="专题分工表" />
          <b2g:property name="输出" value="规划章节结构及编写分工表" />
          <b2g:property name="输出" value="大纲与规划章节对应表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_94f9ca2d-c025-45d0-b0a4-6bf256f86b32</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_750a2d69-af21-40cb-af67-09f6aa9b3c4b</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_92aa66c6-6607-4c5b-b351-2724880b3602" name="开展形势研判与差距分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="综合发展基础、外部形势、战略要求和技术趋势，分析现有能力与发展目标之间的主要差距，识别本周期需要重点解决的问题，为目标设定和任务布局提供依据。" />
          <b2g:property name="输入" value="上一周期发展基础与问题清单" />
          <b2g:property name="输入" value="科技规划需求基线" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="规划章节结构及编写分工表" />
          <b2g:property name="输入" value="技术架构多维统计数据" />
          <b2g:property name="输出" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_750a2d69-af21-40cb-af67-09f6aa9b3c4b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e2cb0507-58af-43c6-b461-86fe415c3620</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_44569e41-e153-42cf-94ad-6d4d7d2e0ac5" name="确定指导思想、基本原则与发展目标">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="依据战略要求和形势研判结果，明确规划的指导思想、基本原则与总体目标，分解形成相互支撑的发展目标，确保目标与主要问题及能力建设需求相对应。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="《规划需求研判报告》" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输出" value="规划第二章《总体要求》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e2cb0507-58af-43c6-b461-86fe415c3620</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_9ecf1a2a-2c1b-4af6-9328-aa6966164338</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_b4f57ba7-d172-4496-ae36-7f33458e3d20" name="测算主要指标并确认统计口径">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="围绕规划目标选取主要指标，结合历史基础、发展趋势和资源条件测算目标水平，明确统计口径、数据来源及阶段要求，形成可用于实施跟踪和评估的指标体系。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="《规划实施评估报告》" />
          <b2g:property name="输入" value="集团战略与科技规划文件集" />
          <b2g:property name="输出" value="主要指标表及口径说明" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_9ecf1a2a-2c1b-4af6-9328-aa6966164338</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_97f764ff-26b8-4525-b058-1ab2d0bf1fcd</bpmn2:outgoing>
    </bpmn2:manualTask>

    <bpmn2:userTask id="EBPM_7acaba1e-383f-4aa1-a33c-07b08256b19c" name="指南修订意见导入DOORS并形成处理结论">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="将指南征求意见及评审意见纳入DOORS统一管理，关联相应条目，逐项形成处理结论和理由，形成可追溯的指南意见处理成果。" />
          <b2g:property name="输入" value="科研指南修订意见" />
          <b2g:property name="输入" value="科研指南评审意见" />
          <b2g:property name="输出" value="修订意见DOORS模块" />
          <b2g:property name="输出" value="指南意见处理表" />
          <b2g:property name="责任主体" value="规划编制工作组" />

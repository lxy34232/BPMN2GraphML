      <bpmn2:incoming>EBPM_5c7d4f9b-105c-497a-a6ff-60dba5d18399</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_5cc147b6-bf4e-4a9b-8972-5b33dbe9201d</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_23c2c7e2-bdc7-469f-808d-58364f923e5e" name="修订科研项目指南并更新DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>

    <bpmn2:manualTask id="EBPM_472788b5-b588-4655-85b1-268b69d89e41" name="分解规划年度任务">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="结合规划实施安排、任务进展和在研项目情况，识别本年度需要启动、延续或调整的科研任务，统筹长期研究与阶段性应用需求，形成规划年度任务清单。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="《规划实施评估报告》" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输出" value="规划年度任务清单" />

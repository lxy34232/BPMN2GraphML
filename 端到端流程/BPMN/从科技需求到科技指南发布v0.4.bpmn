    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_aae4761b-114d-4268-941d-e42f6b737536" name="组织科研指南评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="对指南方向、项目布局、资源安排和成果评价要求开展评审，重点判断其与规划目标的一致性及实施可行性，形成评审意见。" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输入" value="指南意见处理表" />
          <b2g:property name="输入" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="输出" value="科研指南评审意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7685113a-49a0-4ab2-84f8-1d503b8f43b8</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a32c4b82-1414-4a1d-a0f7-137faad4874f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_aed2e494-4fbd-49e4-9634-7cb2e789d8c6" name="科研指南评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="依据评审结论判断指南是否具备发布条件。评审通过或一般修改已确认落实的进入发布；存在实质性问题的退回修订并重新评审。" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a32c4b82-1414-4a1d-a0f7-137faad4874f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b26251b4-2eb0-4983-8414-966104100087</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_f4384e3b-c5c9-4c5e-ae45-600f43a52dec</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_5a13fec4-d7a2-47ce-99a8-4b0192245612" name="科研项目指南发布">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="完成必要的审批确认，按照规定程序发布年度科研项目指南，作为当年度项目申报、遴选和立项评审的依据。" />
          <b2g:property name="输入" value="科研指南评审意见" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南正式发布文件" />
          <b2g:property name="责任主体" value="规划编制工作组" />

      <bpmn2:outgoing>EBPM_3b52be0b-56c9-4754-9335-40328a58e392</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_f8894dd9-d56a-4c23-a4ad-13a7f7d11130" name="收集重大科技成果情况">

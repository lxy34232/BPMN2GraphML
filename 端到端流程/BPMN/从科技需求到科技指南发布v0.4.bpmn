      <bpmn2:outgoing>EBPM_500baed7-5032-48d0-a077-894ece48c1a8</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_c2fdab93-b2e5-4050-9bc5-bed0b324e587" name="收集科研项目立项与完成情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="围绕年度指南及研究方向，汇总科研项目的申报立项、实施进展和结题验收情况，梳理项目与指南及技术方向的对应关系，反映科研任务的组织实施成效。" />
          <b2g:property name="输入" value="科研项目指南正式基线" />
          <b2g:property name="输入" value="科研项目管理台账" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="科研项目立项与完成情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8d4e5c26-c776-415f-a30a-f7821ddf7ee1</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b2270e87-e9c9-4c27-8a13-4804ffe98e08</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_467d3c02-d92d-4ad5-9ded-986c0dbfc243" name="收集科技成果工程化应用情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="收集科研成果向工程应用转化的情况，梳理成果基础、应用范围、成熟程度及实际效益，反映技术成果对产品和业务发展的支撑作用。" />
          <b2g:property name="输入" value="科研项目验收资料" />
          <b2g:property name="输入" value="工程化项目技术资料" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="科技成果工程化应用情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />

          <b2g:property name="步骤描述" value="对照规划任务与阶段安排，收集实施进展、阶段成果、主要偏差及后续计划，形成有事实依据的任务完成情况资料。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />

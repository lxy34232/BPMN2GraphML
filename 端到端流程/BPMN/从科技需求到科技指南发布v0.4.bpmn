    <bpmn2:manualTask id="EBPM_8f68b3f2-7372-4c5e-bc7f-926453ce035f" name="编写科技发展规划上会议案">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="围绕规划编制背景、主要内容、论证过程和意见处理情况，梳理需要决策的重点事项，形成内容完整、依据充分的审议议案。" />
          <b2g:property name="输入" value="科技发展规划送审稿" />
          <b2g:property name="输入" value="修订意见处理表" />

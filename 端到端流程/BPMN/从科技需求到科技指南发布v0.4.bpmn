    <bpmn2:userTask id="EBPM_8a3223fa-549c-41ca-916c-cc64971bd3bc" name="开展规划承接与重复性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="检查指南对规划年度任务和重点技术方向的承接情况，核实条目依据，结合历年指南及在研项目分析研究边界和新增价值，识别遗漏、重复和布局失衡问题。" />
          <b2g:property name="输入" value="指南至规划追溯链接" />
          <b2g:property name="输入" value="规划年度任务清单" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输入" value="技术架构多维统计数据" />
          <b2g:property name="输出" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
          <b2g:property name="信息系统" value="TechArchi技术地图" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_9ba89aca-198d-4aca-9ac2-d2f3d38657ba</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_623d977d-52b1-4355-b3e8-b40b202a32e8</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_50181728-6482-4d60-b052-3649d5eaba33" name="指南条目依据是否充分？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="检查指南条目的依据、年度任务承接和技术方向覆盖是否充分，是否存在重复安排或缺乏合理说明的内容。满足要求后进入征求意见，否则调整完善。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_623d977d-52b1-4355-b3e8-b40b202a32e8</bpmn2:incoming>

    <bpmn2:manualTask id="EBPM_4bde7bb2-9a97-463d-be1d-148503f37a5d" name="编制关键技术布局">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="结合技术架构、能力差距和发展需求，统筹基础共性技术、关键技术攻关及前沿技术储备，明确重点研究方向、能力建设目标和应用衔接要求，形成分层推进的技术布局。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="科技规划需求基线" />
          <b2g:property name="输入" value="公司技术架构" />
          <b2g:property name="输入" value="技术架构多维统计数据" />
          <b2g:property name="输出" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="TechArchi技术地图" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_63c60a57-22a5-4b33-8a5f-04caeb29795c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d2f5eb78-2063-4b01-95fc-f8b388942e6d</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_71afcce2-39aa-4c3e-be1b-8ea6e2e61bad" name="编制重点产品开发规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="面向市场需求和产业发展方向，确定重点产品布局与能力提升目标，明确关键技术支撑、成果承接和阶段推进要求，形成与技术布局协同的产品开发规划。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="业务单位与市场用户科技需求汇总表" />
          <b2g:property name="输出" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_bcf1474b-c3c0-4398-bee8-531e3b6f90cf</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_31ea05bd-b8d6-406c-a80f-a4d2f1acfd1d</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_9f3dd4ac-060e-4c24-b5de-f1e676979999" name="编制科技创新体系建设任务">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="针对科技创新体系中的主要问题，提出治理协同、研发管理、成果转化和支撑能力建设等方面的任务，明确需要完善的机制与能力，增强创新体系运行效能。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输出" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_db1711c4-5e6c-453b-8a17-266abc6f8732</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_8410ad3e-c3ba-419f-9906-c82c0d9a7c43</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_ba00ebf3-6ef0-410c-8d89-c7f42ec0eb00" name="编制规划实施保障">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="围绕规划落实需要，提出人才、投入、基础条件和协同机制等保障措施，明确阶段实施安排、跟踪评估、风险应对及滚动调整要求，形成与重点任务相匹配的实施保障体系。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="公司科研管理制度" />
          <b2g:property name="输出" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f3a57392-2c73-4916-8858-67793144a216</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f2ca8cb5-9055-49e4-9e56-3df3c078c5f4</bpmn2:outgoing>
    </bpmn2:manualTask>

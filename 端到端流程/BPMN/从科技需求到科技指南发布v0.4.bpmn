    <bpmn2:userTask id="EBPM_95122385-454a-421d-a25a-b5ac163a2fab" name="科研项目指南规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按照统一规范将年度指南导入DOORS，维护研究方向、项目分类和相关技术信息，保证内容层次完整、基础信息准确，支持后续追溯分析和实施管理。" />
          <b2g:property name="输入" value="科研项目指南初稿" />
          <b2g:property name="输入" value="DOORS模块模板与链接模块" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_1604eaad-17aa-41d0-b7ef-9fc45b052275</bpmn2:incoming>

    <bpmn2:manualTask id="EBPM_ad66beb8-e403-44ef-8682-a39e79674c8a" name="编制科研项目指南">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="围绕年度支持方向编制指南条目，明确研究目标、主要内容、已有基础、预期增量及成果评价要求，说明规划依据和应用衔接，形成目标清晰、边界明确的指南草稿。" />
          <b2g:property name="输入" value="年度指南方向及项目分类表" />

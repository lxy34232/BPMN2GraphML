    <bpmn2:userTask id="EBPM_e8428d92-7183-4df9-8131-fca5ca9c1253" name="开展大纲承接性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="检查规划对大纲要点和关键需求的承接情况，分析新增内容的合理性及重点技术方向的覆盖程度，识别承接缺口，形成完善规划内容与追溯关系的建议。" />
          <b2g:property name="输入" value="规划至大纲追溯链接" />
          <b2g:property name="输入" value="大纲至需求追溯链接" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输入" value="技术架构多维统计数据" />
          <b2g:property name="输出" value="《大纲承接性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6d210525-1f6e-4c72-90ec-fe9d2d243816</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_81eb9855-fb19-44cf-955a-043b62dc0d1a</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_dcf906b3-04ac-4524-ae13-d9781257b287" name="大纲条目是否全部承接？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="检查大纲要点和关键需求是否在规划中得到承接，未承接内容及新增内容是否具有经确认的依据。满足要求后进入征求意见阶段，否则补充调整。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_81eb9855-fb19-44cf-955a-043b62dc0d1a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_57bddbd3-7ba2-424a-99e4-d21a752cad53</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_70190fb0-7a07-4ea1-92d0-4d03f80e9330</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_210f45a9-7de0-4786-b95e-bacc4ff78109" name="补充调整规划条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="依据承接性分析结果，补充或调整规划内容，完善与大纲和需求的关联关系，对暂不承接的内容说明理由，并重新核查调整后的完整性与一致性。" />
          <b2g:property name="输入" value="《大纲承接性分析报告》" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_70190fb0-7a07-4ea1-92d0-4d03f80e9330</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_428b2945-d73c-4162-9a05-4c2862b34808</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_6f8b6cdf-8847-458a-92b8-33d81f89196f" name="发布科技发展规划基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="对需求、大纲和规划的阶段成果建立协调一致的基线，形成可用于征求意见的规划版本，为后续修订比较和意见处理提供稳定依据。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="《大纲承接性分析报告》" />
          <b2g:property name="输出" value="科技发展规划征求意见稿基线" />
          <b2g:property name="输出" value="科技发展规划征求意见稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_57bddbd3-7ba2-424a-99e4-d21a752cad53</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_5a6402ed-d377-4ee5-a321-c47e0674c69f</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_840f0885-6e0b-4d78-86ea-d215ce197647" name="进行科技发展规划修订意见征集">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="围绕规划征求意见稿开展意见征集，明确反馈范围、重点内容和时间要求，引导意见对应具体条目或主题，形成可供研究处理的修订意见。" />
          <b2g:property name="输入" value="科技发展规划征求意见稿" />
          <b2g:property name="输出" value="修订意见征集通知" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_5a6402ed-d377-4ee5-a321-c47e0674c69f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_4d7a6a71-ac28-41ee-9479-53dd402caf11</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_73ea5826-eaae-419d-90ca-8924a7cd2813" name="提出科技发展规划修订意见">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="结合发展需求和实际情况，对规划目标、重点方向、任务安排及保障措施提出修改建议，说明问题依据和调整理由，为规划完善提供参考。" />
          <b2g:property name="输入" value="修订意见征集通知" />
          <b2g:property name="输入" value="科技发展规划征求意见稿" />
          <b2g:property name="输出" value="科技发展规划修订意见" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
          <b2g:property name="责任主体" value="相关职能部门" />
          <b2g:property name="责任主体" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_4d7a6a71-ac28-41ee-9479-53dd402caf11</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_8e2f5132-7f39-40d4-88e4-842571106848</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_c39806da-5313-452f-b8e4-8aa2c38e53cf">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8e2f5132-7f39-40d4-88e4-842571106848</bpmn2:incoming>
      <bpmn2:incoming>EBPM_87c99391-55a6-4b6f-92e0-66f12695a763</bpmn2:incoming>
      <bpmn2:incoming>EBPM_603da004-da4d-4506-8188-577edec1d690</bpmn2:incoming>
      <bpmn2:incoming>EBPM_43fc4fc0-7b5b-472b-a244-2502f37f6b5e</bpmn2:incoming>
      <bpmn2:incoming>EBPM_4bc403d1-e27a-4774-a5ae-572f2a85179a</bpmn2:incoming>
      <bpmn2:incoming>EBPM_72220bfc-6c8c-45a5-a8dc-24c304a08b37</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_574fbc43-1f6b-4ef4-ade8-a23ae19441c7</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_11d53814-f8e5-4f50-beaf-fd658c2cfcaa" name="修订意见导入DOORS并关联被修订对象">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="将征求意见、评审审议意见及修编需求纳入DOORS统一管理，记录必要的来源和阶段信息，建立意见与相关规划内容的对应关系，支持逐项处理和过程追溯。" />
          <b2g:property name="输入" value="科技发展规划修订意见" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输入" value="党委会前置研究意见" />
          <b2g:property name="输入" value="总经理办公会审议意见" />
          <b2g:property name="输入" value="规划修编需求" />
          <b2g:property name="输出" value="修订意见DOORS模块" />
          <b2g:property name="输出" value="意见至规划追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_574fbc43-1f6b-4ef4-ade8-a23ae19441c7</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_1c52f12f-52aa-4a9b-9544-bd5c945c30a7</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_f0fc5346-3809-4199-a6f8-87e87527da11" name="逐条形成修订意见处理结论">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="对修订意见逐条分析论证，形成采纳、部分采纳或不采纳的处理结论并说明理由。涉及重大调整的履行必要的确认程序，形成修订意见处理成果。" />
          <b2g:property name="输入" value="修订意见DOORS模块" />
          <b2g:property name="输入" value="意见至规划追溯链接" />
          <b2g:property name="输出" value="修订意见处理表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_1c52f12f-52aa-4a9b-9544-bd5c945c30a7</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_288283d3-7f36-496f-8d5c-58daa44b73c5</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_a27e0ea1-4805-4c76-9b54-8cb969206ef4" name="修订规划文本并更新DOORS模块">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="依据确认的意见处理结论修订规划内容，同步更新DOORS中的相关数据，保留必要的变更记录，形成内容一致、过程可追溯的规划修订稿。" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="规划修订对照表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_288283d3-7f36-496f-8d5c-58daa44b73c5</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_42ab8259-d358-4ed5-a73a-b34db39e70ce</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_bcc57787-a008-4879-b485-b0a368af8073" name="处理疑似链接并复核追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="评估规划内容变更对需求、大纲及相关成果的影响，复核存在疑问的追溯关系，补充或调整关联内容，必要时同步修订大纲，确保追溯链路准确有效。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="规划修订对照表" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="输出" value="追溯关系复核记录" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_42ab8259-d358-4ed5-a73a-b34db39e70ce</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7df0a4f0-aa2f-4731-a8c5-5ac2df6ce88e</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_a5d685dc-0c4a-4227-a8bc-99400e310d49" name="组织进行一级评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="对规划修订稿开展专业评审，重点评价形势判断、目标指标、技术与产品方向及任务安排的合理性和可行性，结合意见处理情况形成一级评审结论。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="追溯关系复核记录" />
          <b2g:property name="输出" value="一级评审意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7df0a4f0-aa2f-4731-a8c5-5ac2df6ce88e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_cd01deb7-b9f1-4dd5-9785-de95a5610384</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_7d1f2836-c144-4236-96f5-daeafd0cad3c" name="一级评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="依据一级评审结论判断是否进入二级评审。评审通过或一般修改已确认落实的，继续后续流程；存在影响规划质量的实质性问题时，退回修订并重新评审。" />
          <b2g:property name="责任主体" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_cd01deb7-b9f1-4dd5-9785-de95a5610384</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_041a491c-a398-4f8b-88df-49e97f915123</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_87c99391-55a6-4b6f-92e0-66f12695a763</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_2be873bb-ab5e-4889-94ac-ce58e53f082f" name="组织进行二级评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="在专业评审基础上，对规划的战略一致性、重大方向、资源配置和实施可行性进行综合评审，形成二级评审意见及后续完善要求。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输出" value="二级评审意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_041a491c-a398-4f8b-88df-49e97f915123</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f447cdb1-e8bf-42d4-9a1f-a59879bf5ce6</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_4bb8f007-40c4-42e9-9b16-5234c29d9a55" name="二级评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="依据二级评审结论判断是否进入审议准备。评审通过的继续后续流程；需要调整的退回修订，并根据调整影响确定复评范围。" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f447cdb1-e8bf-42d4-9a1f-a59879bf5ce6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_438b86c7-ead0-4d1f-9a3c-34ee14f25937</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_603da004-da4d-4506-8188-577edec1d690</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_dfaaa3bb-57e0-44af-9baf-aeaaf57fcb99" name="发布科技发展规划送审稿基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="对评审确认的规划及相关依据、意见处理成果建立送审基线，保证提交审议的内容和形成过程可追溯，形成正式送审材料。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输出" value="科技发展规划送审稿基线" />
          <b2g:property name="输出" value="科技发展规划送审稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_438b86c7-ead0-4d1f-9a3c-34ee14f25937</bpmn2:incoming>

      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_15d320ec-c72f-4bc6-9cc8-a55f0ea36de2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d6464597-dc76-44b9-8b07-e6c431b98db6</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_db8f7e41-1183-48b6-80c0-41e1af3e98a9" name="收集年度科研项目需求">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="围绕规划部署和实际应用需求，收集年度科研项目建议，梳理需求来源、研究目标、预期成果和资源条件，形成与年度任务相衔接的科研需求汇总成果。" />
          <b2g:property name="输入" value="年度科研指南编制通知" />
          <b2g:property name="输入" value="业务单位科技需求反馈" />
          <b2g:property name="输出" value="年度科研项目需求汇总表" />

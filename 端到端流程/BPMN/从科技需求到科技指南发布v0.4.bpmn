      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a6072a2f-fcab-450b-8ec9-ad8a8fddaee0</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_4c6d2750-c798-43a9-9ae1-ac813d56772c</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_386ca65a-a541-41c2-b25d-ca684b37bff7" name="党委会是否同意提交审议？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="依据前置研究意见判断是否进入后续审议。同意提交的继续流程；提出修改要求的退回处理，并根据修改影响履行必要的复核程序。" />
          <b2g:property name="责任主体" value="公司党委会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_4c6d2750-c798-43a9-9ae1-ac813d56772c</bpmn2:incoming>

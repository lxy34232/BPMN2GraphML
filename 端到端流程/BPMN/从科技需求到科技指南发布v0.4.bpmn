    <bpmn2:manualTask id="EBPM_d024510a-e1fc-44ef-9c16-3cab083ef54a" name="提交党委会前置研究">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="按照重大事项决策要求开展规划前置研究，重点把握总体方向、战略一致性和重大事项，形成是否提交后续审议的研究意见。" />
          <b2g:property name="输入" value="科技发展规划上会议案" />
          <b2g:property name="输入" value="科技发展规划送审稿" />
          <b2g:property name="输出" value="党委会前置研究意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="公司党委会" />

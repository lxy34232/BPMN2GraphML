      <bpmn2:incoming>EBPM_7e1233ba-fe1f-46d0-b1b9-40948f265cc9</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_551e877b-2156-46f8-bfb9-efc558425af4</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_98f44d7f-f2d4-4435-825b-9528839b267c" name="进行科研指南意见征集">
      <bpmn2:extensionElements>
        <b2g:properties>

    <bpmn2:manualTask id="EBPM_30647f43-1794-4ce9-b3ee-40cbbbb1a4e6" name="确定年度指南方向与项目分类">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="综合年度任务、项目需求、技术能力短板和实施评估建议，确定指南重点支持方向及项目分类，统筹支持强度、资源配置和评价要求，形成与规划导向一致的年度布局。" />
          <b2g:property name="输入" value="规划年度任务清单" />
          <b2g:property name="输入" value="年度科研项目需求汇总表" />

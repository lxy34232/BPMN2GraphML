      <bpmn2:incoming>EBPM_f9532181-8f98-49bb-99ad-2870d1b8e370</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_0db5cbb2-432c-42a6-86f2-d8ed67f4139d</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_c01c4433-00b0-4ff1-a300-bdca7d1d923a" name="收集科技人才梯队建设情况">
      <bpmn2:extensionElements>

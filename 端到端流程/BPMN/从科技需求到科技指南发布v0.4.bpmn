      <bpmn2:outgoing>EBPM_43fc4fc0-7b5b-472b-a244-2502f37f6b5e</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_e14ee3c2-4468-4ad1-9aaf-8710aaa8e8ee" name="提交总经理办公会审议">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="按照规定程序对规划目标、重点任务、资源安排和实施要求进行审议，形成审议决定及相关落实要求。" />
          <b2g:property name="输入" value="科技发展规划上会议案" />

      <bpmn2:incoming>EBPM_2ddbf115-0516-41db-bc93-82f4dca988df</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f37ae263-3955-4ef8-9445-678de73542fd</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_e2a30b56-8a26-4bed-9619-43725ae51ea6" name="确定评估类型与评估方案">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="根据规划实施阶段确定年度、中期或总结评估的重点，明确评估范围、方法、数据口径和进度安排，形成能够评价实施成效并支撑后续决策的评估方案。" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="科研项目指南正式基线" />
          <b2g:property name="输出" value="《规划实施评估工作方案》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>

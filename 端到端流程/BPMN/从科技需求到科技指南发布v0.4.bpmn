    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_5d8fe299-b4d5-47c7-9687-8d999fc0f8b6" name="开展规划宣贯与任务分解">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="开展规划宣贯，明确总体目标、重点任务和实施要求，将规划任务分解为年度安排与阶段成果，形成支撑年度科研指南编制和实施跟踪的任务分解成果。" />
          <b2g:property name="输入" value="科技发展规划正式基线" />

    <node id="EBPM_67125cd0-74d4-4946-af07-5d3ed29507b9">
      <data key="n_bpmn_id">EBPM_67125cd0-74d4-4946-af07-5d3ed29507b9</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_67125cd0-74d4-4946-af07-5d3ed29507b9", "bpmn_type": "manualTask", "name": "研判需求并归纳规划主题", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划大纲制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"在DOORS中按“规划主题”分组查看需求，汇总每个主题下的上级要求、公司要求和发展短板。对每个主题回答三个问题：上级要求做什么、公司战略要求做什么、我们现在差在哪里。其中“差在哪里”结合技术架构统计分析报告，用各根技术和关键技术族的投入、成果和质量问题数据说明。把相近的需求归并成规划主题，识别需求之间的冲突和优先级，形成规划需求研判报告。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划需求基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"关键需求清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一周期发展基础与问题清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《规划需求研判报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 28, "source_id": null, "target_id": null}]</data>

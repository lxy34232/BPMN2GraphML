    <node id="EBPM_8ec3143d-b161-442c-83f3-afe51ad76f82">
      <data key="n_bpmn_id">EBPM_8ec3143d-b161-442c-83f3-afe51ad76f82</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_8ec3143d-b161-442c-83f3-afe51ad76f82", "bpmn_type": "manualTask", "name": "确定年度指南方向与项目分类", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"综合规划年度任务清单、年度项目需求和实施评估提出的调整建议，确定本年度指南支持方向。研究方向按技术架构组织：以根技术为一级方向、关键技术族为研究方向，指南条目落到应用技术，产品开发和体系建设类方向也注明所依托的关键技术族。各方向的优先级依据技术架构统计分析确定：规划重点方向和短板关键技术族加强支持，投入集中且成果稳定的方向维持，连续多年无项目响应或无成果的方向调整支持方式或退出。各方向按基础研究、共性技术、工程开发、成果转化分类，各类采用不同的支持方式和评价要求。结合年度科技投入预算按根技术和关键技术族确定各方向规模，检查投入结构与规划导向一致，并保证基础研究及应用基础研究投入占比满足规划指标。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划年度任务清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"年度科研项目需求汇总表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划实施评估调整建议\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"年度科技投入预算\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"年度指南方向及项目分类表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 87, "source_id": null, "target_id": null}]</data>

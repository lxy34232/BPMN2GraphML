      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_6cfc4950-6352-4b96-a066-3bb9e47ab12b", "bpmn_type": "manualTask", "name": "提取上一周期规划总结评估结论", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"以上一周期“科技规划实施评估”子流程形成的总结评估报告为依据，提取代表性成果（作为新规划的发展基础）、主要指标完成情况、未完成或退出的任务及原因、组织能力、技术管理和设计开发三个体系维度的问题（作为新规划的存在问题），形成上一周期发展基础与问题清单。上一周期未按本流程开展总结评估的，先按“科技规划实施评估”子流程补做一次总结评估。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"上一周期发展基础与问题清单\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 10, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_2e5e4233-f72c-4235-9ab4-dc886879abe7", "bpmn_type": "manualTask", "name": "收集规划任务完成情况", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按规划任务分解表逐项收集：任务编号、牵头单位、本期计划节点、实际进展、完成状态（未启动、进行中、已完成、延期、调整、退出）、阶段成果、偏差原因和下一步安排。由各任务牵头单位自评填报，附成果证明材料。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划任务分解表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划实施评估数据采集模板\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划任务完成情况表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"各业务单位及分子公司\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 109, "source_id": null, "target_id": null}]</data>

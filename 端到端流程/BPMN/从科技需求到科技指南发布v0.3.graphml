    <node id="EBPM_5cb8e83a-6295-466a-a35c-72dfb15bd715">
      <data key="n_bpmn_id">EBPM_5cb8e83a-6295-466a-a35c-72dfb15bd715</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_5cb8e83a-6295-466a-a35c-72dfb15bd715", "bpmn_type": "manualTask", "name": "历史科技数据按技术架构归类", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"技术架构构建与统计分析\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"把上一周期的科技数据挂接到技术架构节点，统一填写技术编码：科研项目按研究内容挂到应用技术，科研委外合同按研究对象挂到应用技术，质量攻关项目按问题所属技术挂到关键技术族或应用技术，专利、标准和技术组件挂到对应的应用技术。不能确定到应用技术的挂到关键技术族并标注。无法归入任何节点的数据集中登记，作为技术架构补充节点的建议，经工作组确认后补充节点并更新技术地图和DOORS模块。归类结果抽样复核，由数据提供部门确认。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目管理台账\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研委外合同台账\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"质量攻关项目台账\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"知识产权标准奖励及认证台账\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构维护与数据挂接规则》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"按技术架构归类的科技数据集\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"各业务单位及分子公司\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"相关职能部门\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 26, "source_id": null, "target_id": null}]</data>

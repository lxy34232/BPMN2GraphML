    <node id="EBPM_044f5d84-d357-49f5-83da-160fb9543417">
      <data key="n_bpmn_id">EBPM_044f5d84-d357-49f5-83da-160fb9543417</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_044f5d84-d357-49f5-83da-160fb9543417", "bpmn_type": "manualTask", "name": "确定科技规划大纲框架", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划大纲制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"依据研判结果确定大纲的一、二级章节，原则上承接上位科技规划的结构并对应公司战略工程。参考框架：总体要求、双赛道产业布局与提质（按机车、城轨、动车组、磁浮、产品+、维保、战新板块展开）、技术研究（根技术、软件定义产品、核心技术攻关、自主化、碳管理）、科技管理体系、设计开发体系、数智化转型、知识产权与标准化、保障措施。其中技术研究部分按技术架构的四大根技术设置二级章节，使大纲、规划和指南的技术方向与技术架构一一对应。框架经工作组讨论确认后，把二级章节分配到各专题。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《规划需求研判报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"专题分工表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科技规划大纲框架\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 29, "source_id": null, "target_id": null}]</data>

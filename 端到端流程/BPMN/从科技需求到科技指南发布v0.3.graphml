      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_67cef05b-4213-475f-8535-456963db961d", "bpmn_type": "userTask", "name": "技术架构导入DOORS并建立基线", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"技术架构构建与统计分析\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"用技术架构模板在“00-技术架构”下建立模块，按技术地图导入，根技术、关键技术族、应用技术分别作为一至三级对象，填写“技术编码”“技术层级”“节点状态”属性。导入后核对节点数量和层级与技术地图一致，建立基线0.1（后缀“统计分析用”），规划正式发布时随基线集升为1.0。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构草案\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构评审意见\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"DOORS模块模板与链接模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 25, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_07004d70-725c-4f59-87e2-f2a8191c872f", "bpmn_type": "manualTask", "name": "分析偏差原因并提出调整建议", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"对滞后的任务和指标从技术、资源和组织三方面分析原因。按规划确定的规则提出建议：调整技术路径、加强协同或资源投入、实施退出（长期无法验证、缺乏应用主体或偏离方向的任务），以及下一年度指南需要加强、新增或退出的方向，方向建议落到技术架构的关键技术族或应用技术节点。中期评估还要判断规划目标和重点方向是否需要修编。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划实施完成度分析表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"核验后评估数据集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划实施评估调整建议\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 125, "source_id": null, "target_id": null}]</data>

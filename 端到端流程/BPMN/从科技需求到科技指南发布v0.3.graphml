    <node id="EBPM_d8d46087-2d80-411e-b5e4-cb0e8d9bcb09">
      <data key="n_bpmn_id">EBPM_d8d46087-2d80-411e-b5e4-cb0e8d9bcb09</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_d8d46087-2d80-411e-b5e4-cb0e8d9bcb09", "bpmn_type": "manualTask", "name": "开展技术架构多维统计分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"技术架构构建与统计分析\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"在技术地图中按技术架构逐级汇总四个维度的数据，用技术架构图、科研费用图和质量问题图呈现分布。投入维度：各节点的科研项目经费、委外合同金额及合同类型结构（技术研究、计算仿真、检测试验）。成果维度：专利、标准、技术组件和奖励数量。研究情况维度：立项、在研、验收项目数和承担单位数。问题维度：质量攻关问题数量及分布。按既定规则形成判断：质量问题多而研究投入少的节点列为技术短板，优先作为关键技术攻关方向。委外以技术研究和计算仿真为主的节点，说明自主研究能力不足，需加强自主研究和人才配置。委外以检测试验为主的节点，作为试验验证能力建设方向。长期没有项目和成果的节点，判断是否属于需要布局的空白或可以停用。投入过度集中于少数关键技术族的，评估投入结构是否与公司战略相符。形成技术架构统计分析报告，结论按根技术和关键技术族列出现状、短板和重点方向建议。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"按技术架构归类的科技数据集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构维护与数据挂接规则》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 27, "source_id": null, "target_id": null}]</data>

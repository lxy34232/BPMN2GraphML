    <node id="EBPM_66e40d27-8c2c-4873-ad38-eb6c12e44b4c">
      <data key="n_bpmn_id">EBPM_66e40d27-8c2c-4873-ad38-eb6c12e44b4c</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_66e40d27-8c2c-4873-ad38-eb6c12e44b4c", "bpmn_type": "manualTask", "name": "制定科技规划编制工作方案", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"科技管理部门依据编制任务和上一周期规划，明确规划期限、编制依据、编制范围（技术、产品、体系、保障）、组织方式、工作节点（需求收集、大纲、初稿、征求意见、评审、审议、发布）和成果形式。方案明确由规划编制工作组作为编制主体，需求、大纲、规划文本、科研指南和实施评估全部纳入DOORS结构化管理，并明确规划与年度科研指南、实施评估的衔接要求。方案同时安排与规划编制同步构建公司技术架构（技术地图），以技术架构作为规划技术方向、指南研究方向和实施评估统计的统一分类基准。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划编制任务通知\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一周期科技发展规划\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"公司科研管理制度\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《科技规划编制工作方案》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 1, "source_id": null, "target_id": null}]</data>

    <node id="EBPM_522ec2c8-820e-4dc1-85f3-13883a3393ec">
      <data key="n_bpmn_id">EBPM_522ec2c8-820e-4dc1-85f3-13883a3393ec</data>
      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_522ec2c8-820e-4dc1-85f3-13883a3393ec", "bpmn_type": "userTask", "name": "配置DOORS模块模板与链接规则", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按规范在DOORS项目中建立00至07文件夹，为每类模块建立模板，包含属性定义、枚举类型和标准视图。技术架构模块模板包含“技术编码”“技术层级”（根技术、关键技术族、应用技术）和“节点状态”（有效、新增、停用）属性。建立依据、承接、落实、实施、评估、针对、归属七个链接模块，在各模块属性中设置链接集配对，并只允许通过指定链接模块建链，避免使用默认的DOORS Links。标准视图包括：全文视图、追溯视图（用分析向导生成入向和出向链接列，即现有“深度为1的出向链接”列）、覆盖缺口视图（过滤没有入链或出链的要点对象），以及技术架构模块中的技术分布视图（统计每个节点的规划、指南和项目入链数量）。设置访问权限：工作组成员按专题拥有编辑权限，其他人员只读，模块建立正式基线后转为只读。同时把现有政策文本模块中名称和取值不统一的字段（如“科技体系相关”“科技规划相关”“备注”）按模板迁移为“规划主题”“需求等级”“处理说明”。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《DOORS规划数据管理规范》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构维护与数据挂接规则》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"DOORS模块模板与链接模块\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 5, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_63902765-8c23-4cd4-a9a5-5c6654c3ec72", "bpmn_type": "userTask", "name": "开展规划承接与重复性分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"在DOORS中检查四项内容。一是指南条目是否都有规划依据，没有依据的须在“处理说明”中写明来源（如现场紧急问题）。二是规划年度任务清单中本年应启动的任务是否都被指南覆盖，可在规划模块的追溯视图中统计各重点任务被历年指南落实的情况。三是与在研项目和历年指南模块对比，排除重复立项，同一应用技术节点下已有在研项目的，条目须说明与在研项目的区别。四是在技术分布视图中查看本年度指南条目在根技术和关键技术族上的分布，与规划技术布局和技术架构统计分析识别的短板对照，检查有无重点方向缺位或投入过度集中。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"指南至规划追溯链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"指南至技术架构归属链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划年度任务清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"在研项目清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《指南规划承接与重复性分析报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 93, "source_id": null, "target_id": null}]</data>

    <node id="EBPM_a26d1d2a-da41-4884-ae54-4fdd8dfdb99d">
      <data key="n_bpmn_id">EBPM_a26d1d2a-da41-4884-ae54-4fdd8dfdb99d</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_a26d1d2a-da41-4884-ae54-4fdd8dfdb99d", "bpmn_type": "manualTask", "name": "确定评估类型与评估方案", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"在每个指南年度结束时启动实施评估，按所处年份确定评估类型：年度评估（每年末）、中期评估（规划期第三年末，同时包含当年年度评估内容）、总结评估（规划期最后一年末）。年度评估重点看任务进度、指南落地和指标年度应达值，中期评估增加目标和重点方向适应性评价并提出是否修编的建议，总结评估评价规划目标完成度和产业贡献，并为下一周期提供发展基础和问题。评估方案明确评估范围、数据项、统计口径（与主要指标口径一致）、数据截止日期、提供单位和时间节点。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划正式基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划任务分解表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目指南正式基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《规划实施评估工作方案》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 106, "source_id": null, "target_id": null}]</data>

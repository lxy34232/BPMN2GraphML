      <data key="n_bpmn_id">EBPM_e2fd9406-dd6e-4c05-a15b-1faf80c3a95e</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_e2fd9406-dd6e-4c05-a15b-1faf80c3a95e", "bpmn_type": "manualTask", "name": "开展技术架构维度统计分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"把核验后的评估数据按技术编码汇总到技术架构各节点，更新技术地图的技术架构图、科研费用图和质量问题图数据，按投入、成果、研究情况和问题四个维度逐级统计到关键技术族和根技术。与上年度和规划期初的统计对比，回答四个问题：规划重点方向对应的关键技术族投入和成果是否达到预期，短板节点的质量问题是否减少、自主研究比例是否提高，投入结构与规划技术布局是否一致，指南方向有无连续多年无项目响应的节点。结果更新到技术架构统计分析报告，作为偏差分析、下一年度指南方向和下一周期规划的依据。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"核验后评估数据集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"项目至技术架构归属链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构维护与数据挂接规则》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 124, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_eb0e0d99-827c-4534-a09e-2cec648c31ac", "bpmn_type": "userTask", "name": "发布科技规划需求基线", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"主题标注完成后，用基线集对“01-政策文本”下的全部模块同时建立基线1.0，后缀写明规划周期（如“十五五需求”），大纲链接均以该基线为准。上位文件正式稿替换征求意见稿时，更新对应模块并建立1.1基线，同时检查受影响的链接。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主题标注后的政策文本DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科技规划需求基线\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 19, "source_id": null, "target_id": null}]</data>

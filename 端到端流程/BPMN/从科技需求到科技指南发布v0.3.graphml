    <node id="EBPM_2fc74eea-28d0-455a-b0b0-d46da15c760a">
      <data key="n_bpmn_id">EBPM_2fc74eea-28d0-455a-b0b0-d46da15c760a</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_2fc74eea-28d0-455a-b0b0-d46da15c760a", "bpmn_type": "manualTask", "name": "制定DOORS规划数据管理规范", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"制定规划数据在DOORS中的统一规则，作为后续导入、建链和基线管理的依据。一是文件夹与模块分层：00-技术架构（技术地图在DOORS中的映射，作为分类基准）、01-政策文本（每份来源文件一个模块）、02-科技规划大纲、03-科技规划文本、04-科研项目指南（每年度一个模块）、05-科研项目台账、06-规划实施评估、07-修订意见。二是对象标识前缀：每个模块使用唯一前缀加文件序号（如CGDP-00、CRRC-00、ZELC-01、TPLP-00、TPDT-00），对象标识一经生成不再变更。三是对象拆分规则：一个对象表达一条完整要求，标题对象保留原文章节层级，并用“条目类型”属性区分标题、要点和说明。四是属性与枚举：统一使用“规划主题”（多值枚举）、“需求等级”（关键需求、一般需求、不纳入）、“处理说明”等属性，各模块的专用属性在模板中定义。五是链接语义：链接一律从下游指向上游，每种关系使用独立链接模块，即依据（大纲至需求）、承接（规划至大纲）、落实（指南至规划）、实施（项目至指南）、评估（评估记录至规划）、针对（意见至被修订对象），另设归属链接（规划技术条目、指南条目、科研项目至技术架构节点），用于按技术架构汇总统计。六是基线规则：编号采用“主版本.次版本+后缀”，编制过程草稿为0.x，正式发布为1.0，滚动修编后的正式版为2.0，正式版勘误为1.1，后缀写明用途（如征求意见稿、送审稿、2027年度评估）。在需求、大纲、规划发布等里程碑使用基线集（Baseline Set）对相关模块同时建立基线，保证同一时点的追溯关系一致。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《科技规划编制工作方案》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《DOORS规划数据管理规范》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 3, "source_id": null, "target_id": null}]</data>
      <data key="d6">
        <y:GenericNode configuration="com.yworks.bpmn.Activity.withShadow">
          <y:Geometry height="80.0" width="230.0" x="0.0" y="450.0" />
          <y:Fill color="#FFFFFFE6" color2="#D4D4D4CC" transparent="false" />
          <y:BorderStyle color="#123EA2" type="line" width="1.0" />
          <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" textColor="#000000" visible="true" modelName="internal" modelPosition="c">制定DOORS规划数据管理规范</y:NodeLabel>
          <y:StyleProperties>
            <y:Property class="com.yworks.yfiles.bpmn.view.BPMNTypeEnum" name="com.yworks.bpmn.type" value="ACTIVITY_TYPE" />
            <y:Property class="com.yworks.yfiles.bpmn.view.ActivityTypeEnum" name="com.yworks.bpmn.activityType" value="ACTIVITY_TYPE_TASK" />
            <y:Property class="com.yworks.yfiles.bpmn.view.TaskTypeEnum" name="com.yworks.bpmn.taskType" value="TASK_TYPE_MANUAL" />
            <y:Property class="java.awt.Color" name="com.yworks.bpmn.icon.line.color" value="#000000" />
            <y:Property class="java.awt.Color" name="com.yworks.bpmn.icon.fill" value="#ffffff" />
            <y:Property class="java.awt.Color" name="com.yworks.bpmn.icon.fill2" value="#d4d4d4" />

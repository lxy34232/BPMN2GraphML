      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_0e595b3f-ef1c-457e-a30b-b7468197646e", "bpmn_type": "manualTask", "name": "确定规划文本结构与编写分工", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"把大纲转化为规划文本的章节结构，按“形势—要求—任务—保障”的逻辑组织：摘要、发展基础与形势要求、总体要求、关键技术布局、重点产品开发、科技创新体系建设、规划实施保障。建立大纲章节与规划章节的对应表（如大纲“技术研究”对应规划“强化关键技术布局”，大纲“双赛道产业布局”对应规划“推进重点产品开发”），按对应关系把各章分配到专题并指定统稿人，统一专栏表格的格式。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"专题分工表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划章节结构及编写分工表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"大纲与规划章节对应表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 41, "source_id": null, "target_id": null}]</data>

    <node id="EBPM_aefe0ce0-9752-4b0f-a0f5-cc06c27c4a20">
      <data key="n_bpmn_id">EBPM_aefe0ce0-9752-4b0f-a0f5-cc06c27c4a20</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_aefe0ce0-9752-4b0f-a0f5-cc06c27c4a20", "bpmn_type": "manualTask", "name": "编制关键技术布局", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按“分层”原则编写技术布局章节。根技术（系统集成、复杂结构、能源动力、控制算法）按技术架构组织，侧重长期积累，写研究重点和要积累的方法、模型与验证能力，研究重点以技术架构统计分析为依据：短板关键技术族列为重点，对外依赖程度高的技术加强自主研究，试验验证类委外集中的技术纳入试验能力建设。下一代关键技术侧重任务突破，每项写研究目标、验证场景和产品承接要求，并注明涉及的关键技术族。全寿命周期技术（造修一体、状态修、延寿评估）以重点任务专栏列出。战新及未来产业技术储备说明与主业的协同关系，按成熟度分阶段投入。判断一项技术放在哪一层的依据：是否跨产品共性、是否有明确的产品承接对象、成熟度高低。规划提出而技术架构中没有对应节点的技术方向，列入技术架构调整建议。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划需求基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第三章《关键技术布局》稿\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构调整建议\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 46, "source_id": null, "target_id": null}]</data>

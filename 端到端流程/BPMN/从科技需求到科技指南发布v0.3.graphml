    <node id="EBPM_a5834d05-c3b1-48eb-bbba-145adf259f90">
      <data key="n_bpmn_id">EBPM_a5834d05-c3b1-48eb-bbba-145adf259f90</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_a5834d05-c3b1-48eb-bbba-145adf259f90", "bpmn_type": "manualTask", "name": "编制重点产品开发规划", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按车辆产品（机车、城轨、动车组、磁浮）、“产品+”与数智产业产品、战新及未来产业产品三类编写产品开发章节。每类先写期末产品谱系目标，再以专栏列出重点产品及方向，每个产品写清面向的市场、核心技术和要达到的能力。筛选重点产品的依据：有无明确市场需求、能否支撑主业升级或服务转型、能否复用技术平台成果。战新产业突出产品定义和场景验证，未来产业按原理样机、典型场景、商业可行性分阶段验证。数智产品可按年份写出分阶段推进安排。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"业务单位与市场用户科技需求汇总表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第四章《重点产品开发》稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 47, "source_id": null, "target_id": null}]</data>

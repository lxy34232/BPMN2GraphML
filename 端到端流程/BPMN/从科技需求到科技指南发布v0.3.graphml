      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_30018c91-ddff-403b-9927-afd5ec13574b", "bpmn_type": "userTask", "name": "标注需求条目规划主题并识别关键需求", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"工作组按专题分工逐模块阅读政策文本，对与公司科技规划相关的要点对象填写“规划主题”属性（如总体战略、科技体系、产业升级、人才队伍、战新产业、质量管理、数智转型），一个对象可选多个主题。在“需求等级”属性中区分关键需求（上级明确下达的目标、指标和任务，以及公司领导明确提出的要求）、一般需求和不纳入。用“需求等级=关键需求”的过滤视图导出关键需求清单，作为大纲覆盖性分析的检查对象。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"政策文本DOORS模块（导入稿）\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"专题分工表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"主题标注后的政策文本DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"关键需求清单\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 18, "source_id": null, "target_id": null}]</data>

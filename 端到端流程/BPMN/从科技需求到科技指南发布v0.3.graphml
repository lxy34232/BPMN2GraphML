      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_ba478449-72a9-4760-9825-ac406ddca52d", "bpmn_type": "userTask", "name": "建立规划技术条目与技术架构的归属关系", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"先处理技术架构调整建议：经工作组确认的新增关键技术族或应用技术，在技术地图中补充节点并同步更新DOORS技术架构模块，节点状态标为新增。再从规划第三章的技术条目和重点任务对象向技术架构节点创建“归属”链接，根技术章节链接到关键技术族，下一代关键技术和重点任务链接到其涉及的关键技术族或应用技术，可以链接多个节点。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构调整建议\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划至技术架构归属链接\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构DOORS模块\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 55, "source_id": null, "target_id": null}]</data>

    </node>
    <node id="EBPM_161bde64-eb1c-4a99-9f55-6d068b6778c4">
      <data key="n_bpmn_id">EBPM_161bde64-eb1c-4a99-9f55-6d068b6778c4</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_161bde64-eb1c-4a99-9f55-6d068b6778c4", "bpmn_type": "manualTask", "name": "制定技术架构维护与数据挂接规则", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"明确技术架构的层级、编码、维护和统计规则，使规划、指南、项目和各类科技数据按同一套技术分类挂接和统计。一是层级：根技术、关键技术族、应用技术三层（技术地图第二至四层），每个下级节点只归属一个上级节点。二是编码与名称：每个节点使用稳定的技术编码（沿用技术地图节点ID），编码不复用，停用节点保留编码并标记状态。规划、指南和各类台账引用节点时使用技术地图中的统一名称。三是维护源：技术地图（TechArchi的技术地图.xlsx）是技术架构的唯一维护源，每次调整后同步更新DOORS“00-技术架构”模块，两者以技术编码对应。四是变更权限：根技术和关键技术族在规划期内保持稳定，调整随规划滚动修编进行。应用技术可随年度指南编制增补，由工作组确认。五是数据挂接：科研项目、科研委外合同、质量攻关项目、专利、标准和技术组件等数据都填写技术编码，挂到能确定的最细一级节点，不按名称文本匹配，避免名称不一致造成数据挂不上。六是统计维度与口径：投入（科研项目经费、委外合同金额及合同类型）、成果（专利、标准、技术组件、奖励）、研究情况（立项、在研、验收项目数及承担单位数）、问题（质量攻关问题数），各维度由应用技术逐级汇总到关键技术族和根技术，年度按合同签订日期和项目立项年度归属。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《科技规划编制工作方案》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《技术架构维护与数据挂接规则》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 4, "source_id": null, "target_id": null}]</data>
      <data key="d6">
        <y:GenericNode configuration="com.yworks.bpmn.Activity.withShadow">
          <y:Geometry height="80.0" width="230.0" x="0.0" y="580.0" />
          <y:Fill color="#FFFFFFE6" color2="#D4D4D4CC" transparent="false" />
          <y:BorderStyle color="#123EA2" type="line" width="1.0" />
          <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" textColor="#000000" visible="true" modelName="internal" modelPosition="c">制定技术架构维护与数据挂接规则</y:NodeLabel>
          <y:StyleProperties>
            <y:Property class="com.yworks.yfiles.bpmn.view.BPMNTypeEnum" name="com.yworks.bpmn.type" value="ACTIVITY_TYPE" />
            <y:Property class="com.yworks.yfiles.bpmn.view.ActivityTypeEnum" name="com.yworks.bpmn.activityType" value="ACTIVITY_TYPE_TASK" />

    <node id="EBPM_dd69d47c-fe22-4924-adcc-5b453e7bd6f3">
      <data key="n_bpmn_id">EBPM_dd69d47c-fe22-4924-adcc-5b453e7bd6f3</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_dd69d47c-fe22-4924-adcc-5b453e7bd6f3", "bpmn_type": "manualTask", "name": "编制科技创新体系建设任务", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"编写科技创新体系章节，任务直接对应第一章提出的体系问题。内容包括：科技治理与研发组织（技术委员会、研发分工、多地资源统筹、立项与规划贯通），正向研发与成果转化（需求与构型管理、分层研发、技术平台管理、成熟度评价、转化路径），开放协同与知识产权标准认证，工艺与质量体系，工艺材料与试验验证。每项任务写明要建立的机制或能力，涉及权限和机构设置的写为“按公司制度落实”。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第一章《发展基础与形势要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第五章《科技创新体系建设》稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 48, "source_id": null, "target_id": null}]</data>

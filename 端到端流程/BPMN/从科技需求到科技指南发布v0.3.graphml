      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_c6f9f3bd-d624-41c5-94af-0e5463480be6", "bpmn_type": "manualTask", "name": "形成规划实施评估报告", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按评估类型编写报告：年度评估报告写年度目标、任务、里程碑和成果完成情况及调整建议，中期评估报告增加目标适应性评价和修编建议，总结评估报告写规划目标完成度、代表性成果、体系问题和产业贡献，作为下一周期规划的发展基础和问题来源。各类报告都设技术体系专章，按根技术和关键技术族说明投入、成果、研究情况和质量问题的分布与变化。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划实施完成度分析表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划实施评估调整建议\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《规划实施评估工作方案》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 126, "source_id": null, "target_id": null}]</data>

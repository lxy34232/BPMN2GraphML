      <data key="n_bpmn_id">EBPM_a7e8bd11-c0fc-4fbf-b47f-909e7ed85279</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_a7e8bd11-c0fc-4fbf-b47f-909e7ed85279", "bpmn_type": "manualTask", "name": "下发评估通知与数据采集模板", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"通过OA下发评估通知和统一的数据采集模板，模板按八类信息分表，每张表列明数据项、口径说明、数据来源和填报单位，并预填规划任务编号和指南条目标识，涉及技术的数据表设“技术编码”列并附技术架构节点清单，保证填报数据能对应到DOORS中的规划对象、指南对象和技术架构节点。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《规划实施评估工作方案》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划实施评估数据采集模板\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"各业务单位及分子公司\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"相关职能部门\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"OA\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 107, "source_id": null, "target_id": null}]</data>

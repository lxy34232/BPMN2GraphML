      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_24425338-319b-4f65-9f46-c7b9fbcf782f", "bpmn_type": "exclusiveGateway", "name": "是否需要滚动修编规划？", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"判定标准：上位部署、市场或公司发展规划发生重大变化，或中期评估认为目标、重点方向需要调整时，启动滚动修编，形成规划修编需求，进入修订评审子流程，修编后的正式版基线为2.0。只涉及个别任务调整的，通过下一年度指南调整处理，不修编规划。\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划修编需求\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"技术委员会\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 130, "source_id": null, "target_id": null}]</data>

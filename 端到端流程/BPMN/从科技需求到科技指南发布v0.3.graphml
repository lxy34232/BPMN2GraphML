      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_099d89e1-1b25-4fd2-ac25-6f214d269e1d", "bpmn_type": "userTask", "name": "科研项目指南规范性导入DOORS", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"用指南模板在“04-科研项目指南”下建立当年度模块并导入，根技术和研究方向（关键技术族）为标题对象，指南条目为要点对象，填写“项目类别”“成熟度要求”“建议承接主体”“指南年度”属性，规划依据标识和技术编码分别暂存在“依据标识”“技术编码”属性中。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目指南初稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"DOORS模块模板与链接模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科研项目指南DOORS模块\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 89, "source_id": null, "target_id": null}]</data>

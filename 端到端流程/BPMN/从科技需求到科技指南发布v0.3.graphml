      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_eeeb5840-1547-45d7-aabf-679a1f5c3336", "bpmn_type": "manualTask", "name": "收集年度科研项目需求", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"各单位按通知申报年度科研项目需求，说明需求来源（规划任务、产品开发、现场问题、用户需求）、研究内容、预期成果和资源需求，使自上而下的规划部署与现场需求反馈相结合。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"年度科研指南编制通知\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"业务单位科技需求反馈\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"年度科研项目需求汇总表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"各业务单位及分子公司\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 85, "source_id": null, "target_id": null}]</data>

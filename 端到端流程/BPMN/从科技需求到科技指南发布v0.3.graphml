      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_d99853eb-6888-4d1a-894a-adc7226aa63b", "bpmn_type": "userTask", "name": "发布科技发展规划正式基线", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划审议发布\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"用基线集对技术架构、需求、大纲、规划和修订意见模块同时建立正式基线，规划模块为1.0（滚动修编后为2.0，勘误为1.1），内容与印发文本一致。技术架构模块同时建立1.0基线，作为本规划期指南研究方向和实施评估统计的分类基准，技术地图同步标注版本。正式基线是年度科研指南建链和实施评估的唯一依据，规划模块随即转为只读，此后对规划的任何修改都须走滚动修编程序。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划正式印发文件\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科技发展规划正式基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 79, "source_id": null, "target_id": null}]</data>

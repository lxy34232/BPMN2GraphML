      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_2c1050a7-a7f9-4e2c-90ba-c5a79335b155", "bpmn_type": "exclusiveGateway", "name": "技术架构是否通过评审？", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"技术架构构建与统计分析\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"判定标准：评审意见中没有层级结构调整类意见（关键技术族的增删、合并或改变归属）即为通过，个别应用技术的名称和归属调整在导入前直接修改。存在结构调整意见时修改后重新评审。\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"专家组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 23, "source_id": null, "target_id": null}]</data>

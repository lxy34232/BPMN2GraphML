      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_21a5c883-88b1-4551-be2d-ee8f934d8c63", "bpmn_type": "exclusiveGateway", "name": "一级评审是否通过？", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划修订评审\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"判定标准：专家组结论为“通过”的进入二级评审。结论为“修改后通过”且只有文字性意见的，由工作组确认修改到位后视为通过。结论为“不通过”或存在方向性意见的，评审意见导入DOORS逐条处理，修订后重新评审。\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"专家组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 69, "source_id": null, "target_id": null}]</data>
      <data key="d6">

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_7c85af11-96f1-4ba0-baa8-c047072b18f3", "bpmn_type": "manualTask", "name": "分解规划年度任务", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"依据规划任务分解表和实施阶段安排，结合实施评估反映的任务进展和在研项目情况，确定本年度应通过科研项目启动或延续的规划任务，形成规划年度任务清单。已完成或已决定退出的任务不再安排，基础和前沿研究按三至五年稳定支持的原则安排延续，工程开发任务按产品节点安排。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划任务分解表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划正式基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"在研项目清单\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划年度任务清单\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 84, "source_id": null, "target_id": null}]</data>

    <node id="EBPM_edcf35e4-2557-407f-bb76-262ef2e495d2">
      <data key="n_bpmn_id">EBPM_edcf35e4-2557-407f-bb76-262ef2e495d2</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_edcf35e4-2557-407f-bb76-262ef2e495d2", "bpmn_type": "manualTask", "name": "开展形势研判与差距分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按“基础—问题—要求—趋势”四个维度编写第一章。发展基础取自上一周期总结评估的代表性成果，以专栏列出。存在问题按组织能力、技术管理、设计开发三个体系维度归纳，技术层面的问题用技术架构统计分析的数据支撑（如短板关键技术族、对外依赖程度高的技术、投入结构失衡），每个问题都要能对应到后续章节的任务。上级及公司要求按国家行业、集团、公司三个层级提炼。行业技术趋势从上位规划、公司战略文件和各单位科技需求中的相关论述归纳。章末用一段话归纳本周期科技工作的总体着力点，作为总体要求的输入。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一周期发展基础与问题清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划需求基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划章节结构及编写分工表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第一章《发展基础与形势要求》稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 42, "source_id": null, "target_id": null}]</data>

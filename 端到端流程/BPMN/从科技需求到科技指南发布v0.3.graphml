      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_dbf51b23-9bf2-4a84-b7dd-be12f23aa65c", "bpmn_type": "manualTask", "name": "开展规划宣贯与任务分解", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划审议发布\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"面向各部门、分子公司和研发人员开展规划宣贯。把规划重点任务清单分解到年度，按三阶段安排明确每年应启动和应完成的任务、牵头单位、协同单位和成果节点，形成规划任务分解表，纳入公司规划实施体系和年度调度。技术类任务在分解表中注明对应的技术编码。任务分解表同时是实施评估中“规划任务完成情况”的对照基准。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划正式基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划重点任务清单\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划任务分解表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划宣贯材料\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"各业务单位及分子公司\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 80, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_8acedee7-0a9d-415c-ac63-9c3843a522f4", "bpmn_type": "manualTask", "name": "收集科研经费投入情况", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按研究方向和项目类别（基础研究、共性技术、工程开发、成果转化）统计预算与实际支出，计算研发投入强度、基础研究及应用基础研究投入占比，并统计国家级、集团级项目等外部资金。科研委外合同逐份收集合同编号、合同类型（技术研究、计算仿真、检测试验）、对方单位、承办部门、金额、签订日期和技术编码。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研经费财务统计数据\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研委外合同台账\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划实施评估数据采集模板\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科研经费投入情况表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"相关职能部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 115, "source_id": null, "target_id": null}]</data>

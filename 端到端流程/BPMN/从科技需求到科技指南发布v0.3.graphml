      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_6e1d182e-5b00-4de8-af73-aaa383b083cc", "bpmn_type": "userTask", "name": "开展大纲承接性分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"在DOORS中用覆盖缺口视图检查：大纲模块中没有任何规划入链的要点（大纲要点未被承接），以及规划模块中没有出链的要点（规划新增内容）。对未承接的大纲要点提出处理建议（补充规划内容或说明不承接理由），对规划新增内容确认其合理性。再用分析向导生成“需求—大纲—规划”两级追溯视图，检查关键需求是否最终落到规划要点上。最后在技术架构模块的技术分布视图中检查技术覆盖：四大根技术都有规划内容，技术架构统计分析识别的短板关键技术族都有规划条目或已说明暂不布局的理由。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划至大纲追溯链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"大纲至需求追溯链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"关键需求清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划至技术架构归属链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构统计分析报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《大纲承接性分析报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 57, "source_id": null, "target_id": null}]</data>

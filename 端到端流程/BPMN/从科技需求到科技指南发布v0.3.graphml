    <node id="EBPM_8406163e-7cee-4f3a-a91f-6f2d1ff238e6">
      <data key="n_bpmn_id">EBPM_8406163e-7cee-4f3a-a91f-6f2d1ff238e6</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_8406163e-7cee-4f3a-a91f-6f2d1ff238e6", "bpmn_type": "manualTask", "name": "组建规划编制工作组与专题组", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"组建规划编制工作组，作为规划编制、指南编制和实施评估的统一执行主体。工作组由科技管理部门牵头，从相关部门抽调人员组成，内部按规划主题设置专题（产业与产品、技术研究、科技管理体系、设计开发体系、数智化转型、知识产权与标准化、保障措施），明确各专题的牵头人、成员、负责章节和交付节点，并在组内指定DOORS管理员负责模块配置、导入和基线操作。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《科技规划编制工作方案》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划编制工作组及专题组名单\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"专题分工表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"相关职能部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 2, "source_id": null, "target_id": null}]</data>
      <data key="d6">

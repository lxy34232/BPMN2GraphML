      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_a5e707ba-f547-43e2-b863-eb93f7e196ef", "bpmn_type": "manualTask", "name": "组织技术架构评审", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"技术架构构建与统计分析\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"工作组组织专家组和各专业研发部门评审技术架构草案。评审重点：四大根技术之下的关键技术族是否完整覆盖公司现有和规划的技术领域，层级归属是否合理（无一个节点挂在多个上级、无同一技术重复出现），应用技术粒度是否一致、能否挂接项目和成果，名称是否规范。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构草案\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构评审意见\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"专家组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"各业务单位及分子公司\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 22, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_941c5158-f76d-4e9d-887f-aa4d45aaa4de", "bpmn_type": "userTask", "name": "处理疑似链接并复核追溯关系", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划修订评审\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"规划或大纲对象修改后，相关链接会被标为疑似链接。逐条查看疑似链接，确认链接关系是否仍然成立：成立的清除疑似标记，不成立的删除或改建。为新增对象补建“承接”链接，技术条目同时补建“归属”链接，必要时重新开展大纲承接性分析。修订涉及大纲调整的，同步更新大纲模块并建立大纲1.1基线。修订新增了技术方向的，按技术架构维护规则补充技术架构节点。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划修订对照表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划至大纲追溯链接\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"追溯关系复核记录\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 67, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_e1600510-9788-480a-8252-52c7231bc1cd", "bpmn_type": "manualTask", "name": "核验评估数据与统计口径", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"对八类数据做交叉核验：项目台账与经费数据对应，专利、标准、奖励数据与主要指标口径一致，成果和项目都能对应到规划任务编号或指南条目标识，项目、委外合同、成果和质量攻关数据填写的技术编码在技术架构基线中存在，与上年度数据可比。记录缺失、口径不一致和无法对应的数据。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划任务完成情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目立项与完成情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技成果工程化应用情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"平台化模块化成果运用情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技人才梯队建设情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"重大科技成果情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研经费投入情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"质量攻关问题情况表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"评估数据核验记录\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"核验后评估数据集\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 119, "source_id": null, "target_id": null}]</data>

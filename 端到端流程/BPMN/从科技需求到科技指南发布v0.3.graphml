      <data key="n_bpmn_id">EBPM_940e8683-2c19-4a5a-83a3-e890148f4293</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_940e8683-2c19-4a5a-83a3-e890148f4293", "bpmn_type": "manualTask", "name": "编制科研项目指南", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按方向编写指南条目，每个条目包括研究目标、已有成果、研究增量、建议承接主体、资源需求、预期成果与验收要求（含技术成熟度要求）、依据的规划对象标识以及所属技术架构节点的技术编码。“已有成果”从该技术节点下的历年项目、委外合同和专利中归纳，研究增量相对已有成果提出。技术架构中尚无的应用技术，在条目中提出新增节点建议。条目要同步明确工程承接与应用场景，避免低水平重复投入。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"年度指南方向及项目分类表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划正式基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"在研项目清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"按技术架构归类的科技数据集\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科研项目指南初稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 88, "source_id": null, "target_id": null}]</data>

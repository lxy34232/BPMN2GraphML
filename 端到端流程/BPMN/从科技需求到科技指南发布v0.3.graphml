      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_e3ea3551-5689-409f-ae31-ceb9fa7a0b34", "bpmn_type": "userTask", "name": "发布科研项目指南正式基线", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"用基线集对当年度指南模块和技术架构模块同时建立基线，指南为1.0（后缀“正式版”），内容与发布文本一致，模块转为只读。当年增补了应用技术的，技术架构模块升为1.1、1.2等次版本。当年立项的科研项目进入“05-科研项目台账”后链接到指南条目，并继承指南条目的技术架构归属，供实施评估按研究方向和技术节点统计立项和完成情况。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目指南正式发布文件\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目指南DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科研项目指南正式基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 105, "source_id": null, "target_id": null}]</data>

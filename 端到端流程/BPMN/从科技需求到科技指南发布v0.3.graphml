    <node id="EBPM_b30ddaea-fa95-4346-8d66-a16fa4f308ed">
      <data key="n_bpmn_id">EBPM_b30ddaea-fa95-4346-8d66-a16fa4f308ed</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_b30ddaea-fa95-4346-8d66-a16fa4f308ed", "bpmn_type": "manualTask", "name": "梳理构建公司技术架构", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"技术架构构建与统计分析\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按“根技术—关键技术族—应用技术”三层梳理公司技术架构，首轮构建，以后各周期在上一版技术地图基础上更新。自上而下以系统集成、复杂结构、能源动力、控制算法四大根技术为一级，把关键技术族归入根技术。自下而上从产品系统分解、各专业研发部门的技术清单、历年科研项目和科研委外合同的研究内容中归纳应用技术，并归入关键技术族。判断原则：关键技术族是跨产品可持续积累的技术方向，应用技术是可以独立立项研究、可以挂接项目和成果的具体技术，名称统一用“××技术”。根技术名称与规划文本保持一致（如“系统集成”与“系统工程”只保留一个）。在技术地图.xlsx中维护节点和上下级关系，生成技术架构图供研讨。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一版技术地图\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"产品系统分解与专业技术清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目管理台账\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研委外合同台账\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《技术架构维护与数据挂接规则》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"技术架构草案\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"参与方\" value=\"各业务单位及分子公司\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"TechArchi技术地图\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 21, "source_id": null, "target_id": null}]</data>

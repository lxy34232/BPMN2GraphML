      <data key="n_bpmn_id">EBPM_567a1707-122b-4f8a-bbb0-0b5636f44b73</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_567a1707-122b-4f8a-bbb0-0b5636f44b73", "bpmn_type": "manualTask", "name": "收集公司战略部署与领导讲话", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"收集公司党代会报告、战略规划务虚会和科技规划务虚会领导讲话、公司五年发展规划等文件，提炼公司中心任务（如建设“新质株机”）、战略工程和对科技创新的明确要求。领导讲话中的定性要求和公司发展规划中的量化目标都要纳入。行业技术趋势和对标研究的结论已体现在这些文件和各单位科技需求中，不单独开展研究。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"公司党代会报告及务虚会讲话\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"公司五年发展规划\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"公司战略部署与领导讲话文件集\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 9, "source_id": null, "target_id": null}]</data>

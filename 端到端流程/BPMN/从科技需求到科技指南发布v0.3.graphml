      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_e60b1527-3577-4908-9699-a4643b7913cf", "bpmn_type": "userTask", "name": "评估数据录入DOORS并建立追溯", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"把当年立项项目导入“05-科研项目台账”模块，更新已有项目的“项目状态”，建立项目指向指南条目的“实施”链接和指向技术架构节点的“归属”链接。在“06-规划实施评估”模块中为每个规划重点任务建立当期评估对象，填写“评估年度”“评估类型”“实施状态”“完成度”“偏差说明”属性，建立指向规划任务对象的“评估”链接。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"核验后评估数据集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划正式基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目指南正式基线\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"技术架构基线\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科研项目台账DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划实施评估DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"项目至指南追溯链接\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"评估至规划追溯链接\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"项目至技术架构归属链接\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 122, "source_id": null, "target_id": null}]</data>

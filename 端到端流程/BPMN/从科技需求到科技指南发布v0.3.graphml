    <node id="EBPM_dbf2bb2d-da34-47fd-89ba-33105b7ff09c">
      <data key="n_bpmn_id">EBPM_dbf2bb2d-da34-47fd-89ba-33105b7ff09c</data>
      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布v0.3", "id": "EBPM_dbf2bb2d-da34-47fd-89ba-33105b7ff09c", "bpmn_type": "userTask", "name": "开展追溯统计与完成度分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划实施评估\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"沿“规划任务—指南条目—科研项目”链路统计每项规划任务被多少指南条目落实、立项和验收了多少项目，找出没有指南落实的任务、有指南但无项目响应的方向和立项后未按期完成的项目。主要指标按“实际值/目标值”与时间进度（如五年规划第二年末为40%）对比，判断超前、正常或滞后。同时分析成果工程化应用、平台模块复用、人才梯队和经费结构是否符合规划导向。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划实施评估DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"项目至指南追溯链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"评估至规划追溯链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"核验后评估数据集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划实施完成度分析表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 123, "source_id": null, "target_id": null}]</data>

    <node id="EBPM_7b9d592c-0b74-446b-bb2d-5c6c118c66a0">
      <data key="n_bpmn_id">EBPM_7b9d592c-0b74-446b-bb2d-5c6c118c66a0</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_7b9d592c-0b74-446b-bb2d-5c6c118c66a0", "bpmn_type": "manualTask", "name": "测算主要指标并确认统计口径", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"从上位规划的考核指标和公司发展目标中选取科技主要指标（如科技奖励、发明专利、海外专利、标准、研发投入强度、基础研究投入占比、研发人员占比、成果转化收入、高质量数据集、碳足迹核算）。每个指标以上一周期实际值和增长趋势为基础测算期末目标，区分“五年累计”与“期末值”。与人力资源、财务、知识产权等相关职能部门逐项确认统计口径和数据来源，形成主要指标表，口径说明写入专栏。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一周期规划执行数据\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"集团战略与科技规划文件集\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"相关职能部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 35, "source_id": null, "target_id": null}]</data>

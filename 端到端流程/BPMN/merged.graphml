      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_61b10644-ca84-49c0-b259-7c377856e1e3", "bpmn_type": "manualTask", "name": "编制规划实施保障", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"编写实施保障章节，包括科技人才、科技投入、研发基础条件、规划实施与评估。实施安排分三个阶段（如夯基整合、突破示范、固化收官），每个阶段写明重点任务和阶段成果。明确年度调度机制（年初定目标、季度跟踪、半年度专题评估、年度报告）、中期和总结评估、风险清单（技术路线、供应、知识产权、标准认证、数据网络安全、进度、成果转化）和滚动修编的触发条件，并规定规划任务通过年度科研指南落地。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"公司科研管理制度\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第六章《规划实施保障》稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"相关职能部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 40, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_9bb1fce7-fcb1-4dca-a8bc-de36e4913239", "bpmn_type": "manualTask", "name": "确定年度指南方向与项目分类", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"综合规划年度任务清单、年度项目需求和调整建议，确定本年度指南支持方向，并按基础研究、共性技术、工程开发、成果转化分类，各类采用不同的支持方式和评价要求。结合年度科技投入预算确定各方向规模，保证基础研究及应用基础研究投入占比满足规划指标。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划年度任务清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"年度科研项目需求汇总表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"年度指南调整建议\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"年度科技投入预算\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"年度指南方向及项目分类表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 77, "source_id": null, "target_id": null}]</data>

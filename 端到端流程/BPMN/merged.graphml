    <node id="EBPM_fc083e63-6640-47d7-8d42-ef5560102add">
      <data key="n_bpmn_id">EBPM_fc083e63-6640-47d7-8d42-ef5560102add</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_fc083e63-6640-47d7-8d42-ef5560102add", "bpmn_type": "manualTask", "name": "组建规划编制工作组与专题组", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"成立由科技管理部门牵头、株机研究院承担技术研究与情报支撑、规划发展部及相关职能部门参与的规划编制工作组。按规划主题设置专题组（产业与产品、技术研究、科技管理体系、设计开发体系、数智化转型、知识产权与标准化、保障措施），明确各专题组的牵头人、成员、负责章节和交付节点，并指定DOORS数据管理员。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《科技规划编制工作方案》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划编制工作组及专题组名单\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"专题分工表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划发展部\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"相关职能部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 2, "source_id": null, "target_id": null}]</data>

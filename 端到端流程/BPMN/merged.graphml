      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_a28c96e6-7a39-48df-bab2-203a18ec4ae4", "bpmn_type": "userTask", "name": "发布科技规划需求基线", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"主题标注完成后，对“01-政策文本”下的全部模块创建基线V1.0，基线注释写明规划周期和标注完成日期，大纲链接均以该基线为准。上位文件正式稿替换征求意见稿时，更新对应模块并创建V1.x基线，同时检查受影响的链接。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主题标注后的政策文本DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科技规划需求基线V1.0\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"DOORS数据管理员\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 18, "source_id": null, "target_id": null}]</data>

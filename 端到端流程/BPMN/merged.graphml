    <node id="EBPM_ec996ad8-5e9e-4396-81c1-cdac10871601">
      <data key="n_bpmn_id">EBPM_ec996ad8-5e9e-4396-81c1-cdac10871601</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_ec996ad8-5e9e-4396-81c1-cdac10871601", "bpmn_type": "manualTask", "name": "组织进行一级评审", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划修订评审\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"科技管理部门组织专家组（内部专家，必要时邀请外部专家）评审规划修订稿。评审重点：形势判断是否准确、目标指标是否合理可达、技术和产品方向是否正确、任务能否落地、与上位规划和公司发展规划是否衔接。评审材料包括规划修订稿、修订意见处理表和追溯关系复核记录。形成一级评审意见。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"修订意见处理表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"追溯关系复核记录\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"一级评审意见\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"专家组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 57, "source_id": null, "target_id": null}]</data>
      <data key="d6">

    <node id="EBPM_418613c2-5b8e-4187-bae7-16ecca0de99e">
      <data key="n_bpmn_id">EBPM_418613c2-5b8e-4187-bae7-16ecca0de99e</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_418613c2-5b8e-4187-bae7-16ecca0de99e", "bpmn_type": "manualTask", "name": "科技规划需求文本结构化", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按《DOORS规划数据管理规范》把收集到的文件整理成可导入的结构化文本。原文章节作为标题对象保留层级，正文拆分到“一个对象表达一条完整要求”的粒度，清除页眉页脚、目录、图表说明等无关内容，统一标点和编号格式，每份文件形成一个待导入文本并登记来源和版本。需求汇总表、实施评估报告和对标研究报告同样结构化后导入。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"国家及行业政策规划文件集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"集团战略与科技规划文件集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"公司战略部署与领导讲话文件集\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《上一周期科技规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"业务单位与市场用户科技需求汇总表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《行业技术趋势与对标研究报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《DOORS规划数据管理规范》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"结构化需求文本\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 12, "source_id": null, "target_id": null}]</data>
      <data key="d6">
        <y:GenericNode configuration="com.yworks.bpmn.Activity.withShadow">
          <y:Geometry height="80.0" width="174.0" x="300.0" y="1100.0" />

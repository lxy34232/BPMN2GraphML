    <node id="EBPM_2b597b24-795e-4639-9dff-7a67deaea461">
      <data key="n_bpmn_id">EBPM_2b597b24-795e-4639-9dff-7a67deaea461</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_2b597b24-795e-4639-9dff-7a67deaea461", "bpmn_type": "manualTask", "name": "编制关键技术布局", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按“分层”原则编写技术布局章节。根技术（如系统集成、复杂结构、能源动力、控制算法）侧重长期积累，写研究重点和要积累的方法、模型与验证能力。下一代关键技术侧重任务突破，每项写研究目标、验证场景和产品承接要求。全寿命周期技术（造修一体、状态修、延寿评估）以重点任务专栏列出。战新及未来产业技术储备说明与主业的协同关系，按成熟度分阶段投入。判断一项技术放在哪一层的依据：是否跨产品共性、是否有明确的产品承接对象、成熟度高低。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线V1.0\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《行业技术趋势与对标研究报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第三章《关键技术布局》稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各专题组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 37, "source_id": null, "target_id": null}]</data>

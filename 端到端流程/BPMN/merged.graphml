      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_8d1ef8ea-b9d5-45b7-ac4d-831a84c78fa4", "bpmn_type": "userTask", "name": "标注需求条目规划主题并识别关键需求", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"专题组逐模块阅读政策文本，对与公司科技规划相关的对象在“科技规划相关”或“备注”属性中填写主题标签（如总体战略、科技体系、产业升级、人才队伍、战新产业、质量管理、数智转型），一个对象可以有多个标签。区分刚性要求（上级明确下达的目标、指标和任务）和指导性要求，把刚性要求和公司领导明确提出的要求标为关键需求，形成关键需求清单，作为大纲覆盖性分析的检查对象。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"政策文本DOORS模块（导入稿）\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"专题分工表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"主题标注后的政策文本DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"关键需求清单\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各专题组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 17, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_8e305163-66c2-4535-a76c-e537ac904a06", "bpmn_type": "manualTask", "name": "统稿形成规划初稿", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"统稿人合并各章并编写摘要，统一术语、数据和表述风格。做一致性检查：问题与任务对应、目标与指标对应、任务与保障对应，各章引用的产品和技术名称一致，指标数值与口径说明一致。删除与规划层级不符的过细内容（如具体项目），形成规划初稿。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第一章《发展基础与形势要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第三章《关键技术布局》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第四章《重点产品开发》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第五章《科技创新体系建设》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第六章《规划实施保障》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划重点任务清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科技发展规划初稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 43, "source_id": null, "target_id": null}]</data>

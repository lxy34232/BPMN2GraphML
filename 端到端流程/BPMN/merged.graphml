    <node id="EBPM_3b911e99-331a-4e27-9ef2-e9f341c6e150">
      <data key="n_bpmn_id">EBPM_3b911e99-331a-4e27-9ef2-e9f341c6e150</data>
      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_3b911e99-331a-4e27-9ef2-e9f341c6e150", "bpmn_type": "userTask", "name": "制定DOORS规划数据管理规范", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"明确规划数据在DOORS中的组织方式，作为后续规范性导入、建链和基线管理的统一依据。一是模块分层，01-政策文本、02-科技规划大纲、03-科技规划文本、04-科研项目指南。二是对象标识前缀，每个模块使用唯一前缀（如CGDP国家规划纲要、CRRC集团科技规划、ZELC公司文件、TPLP大纲、TPDT规划文本）。三是对象拆分规则，一个对象表达一条完整要求，标题对象保留原文章节层级。四是属性定义，如“科技规划相关”“备注”主题标签及其取值表。五是链接规则，链接统一从下游指向上游（大纲指向需求、规划指向大纲、指南指向规划），使用统一链接模块。六是基线命名，需求V1.0、大纲V1.0、规划V0.1征求意见稿、V0.9评审稿、V1.0正式版（滚动修编后为V1.x）、年度指南V0.1征求意见稿和V1.0正式版。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《科技规划编制工作方案》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《DOORS规划数据管理规范》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"DOORS数据管理员\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 3, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_0da954de-25e3-46d5-a055-a6e6c3f37148", "bpmn_type": "manualTask", "name": "分析上年度规划实施评估结果", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"从上年度规划实施评估报告中提取对本年度指南的影响：进展滞后需要加强的方向、已完成可以退出的任务、偏离方向需要调整的项目、新出现的需求。首年没有上年度评估时，使用上一周期规划实施评估报告。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划年度实施评估报告\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《上一周期科技规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"年度指南调整建议\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 75, "source_id": null, "target_id": null}]</data>

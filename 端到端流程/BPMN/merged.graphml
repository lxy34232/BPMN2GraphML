      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_18980a13-b367-4388-8f87-1bed09b1979f", "bpmn_type": "userTask", "name": "创建科技大纲模块与科技规划需求模块追溯链接", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划大纲制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按大纲条目注明的依据，从大纲对象向政策文本对象创建链接（大纲指向需求），一个大纲条目可以链接多个需求对象。建链后在大纲模块视图中显示“深度为1的出向链接”列，逐条核对链接目标与依据是否一致，核对完成后清除临时依据属性。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划需求基线V1.0\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"大纲至需求追溯链接\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各专题组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"DOORS数据管理员\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 23, "source_id": null, "target_id": null}]</data>

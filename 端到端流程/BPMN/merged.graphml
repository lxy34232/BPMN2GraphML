      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_d4f0e6ae-a5e0-4805-866f-942b4d842d1c", "bpmn_type": "manualTask", "name": "开展行业技术趋势与对标研究", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"株机研究院依托科技战略与情报职能，研究轨道交通装备及相关新兴产业的技术演进方向（如软件定义、域控制、全域感知、自主运行、绿色动力、源网车储协同），分析国际市场的标准认证和区域适配要求，与国内外主要竞争对手开展技术和产品对标，识别技术差距和机会窗口。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技情报资料\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"竞争对手与行业标准信息\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《行业技术趋势与对标研究报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 10, "source_id": null, "target_id": null}]</data>

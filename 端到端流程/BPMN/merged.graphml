      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_33bb74e6-3cba-447b-bfdb-db4c5dfb8f4f", "bpmn_type": "manualTask", "name": "收集业务单位与市场用户科技需求", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"向各业务单位、分子公司、营销和服务部门征集科技需求，覆盖市场与用户需求、产品竞争力短板、现场质量问题、全寿命周期服务和海外区域适配需求。按统一模板填写需求背景、期望目标、紧迫程度和关联产品，体现“需求牵引”原则。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"业务单位科技需求反馈\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"用户与现场问题记录\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"业务单位与市场用户科技需求汇总表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各业务单位及分子公司\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 9, "source_id": null, "target_id": null}]</data>

    <node id="EBPM_23dea94b-21aa-423a-8f5b-62903ae81db0">
      <data key="n_bpmn_id">EBPM_23dea94b-21aa-423a-8f5b-62903ae81db0</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_23dea94b-21aa-423a-8f5b-62903ae81db0", "bpmn_type": "manualTask", "name": "确定指导思想、基本原则与发展目标", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"编写第二章总体要求。指导思想承接上位规划的表述并落到公司中心任务。基本原则从规划需求研判中提炼（如战略牵引、需求牵引、分层协同、平台复用、开放协同与自主可控、价值导向），每条原则都应在后续任务中有所体现。发展目标先写期末总体目标，再按技术供给、产品开发、研发与工程转化、数智与服务、创新体系效能等能力维度分述，并与第一章提出的问题对应。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第一章《发展基础与形势要求》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《规划需求研判报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线V1.0\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第二章《总体要求》稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 34, "source_id": null, "target_id": null}]</data>

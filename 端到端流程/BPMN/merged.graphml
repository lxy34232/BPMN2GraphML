    <node id="EBPM_694e531d-9eb2-4352-b143-ce8f08b97e6e">
      <data key="n_bpmn_id">EBPM_694e531d-9eb2-4352-b143-ce8f08b97e6e</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_694e531d-9eb2-4352-b143-ce8f08b97e6e", "bpmn_type": "manualTask", "name": "开展上一周期科技规划实施评估", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划需求收集\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"对照上一周期科技规划的目标、指标和重点任务，逐项评估完成情况。梳理代表性成果（重大产品、关键技术、研发资源、科研体系、数智应用、成果转化），并从组织能力、技术管理、设计开发三个体系维度分析存在问题及其原因。评估结论是新规划“发展基础”和“存在问题”的直接来源。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一周期科技发展规划\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一周期规划执行数据\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《上一周期科技规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各业务单位及分子公司\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 8, "source_id": null, "target_id": null}]</data>

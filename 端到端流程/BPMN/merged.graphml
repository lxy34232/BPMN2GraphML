    <node id="EBPM_95110ad3-2e65-4e3e-b535-2cfbace86b49">
      <data key="n_bpmn_id">EBPM_95110ad3-2e65-4e3e-b535-2cfbace86b49</data>
      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_95110ad3-2e65-4e3e-b535-2cfbace86b49", "bpmn_type": "userTask", "name": "处理疑似链接并复核追溯关系", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划修订评审\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"规划或大纲对象修改后，DOORS会把相关链接标为疑似链接。逐条查看疑似链接，确认链接关系是否仍然成立：成立的清除疑似标记，不成立的删除或改建。为新增对象补建到大纲的链接，必要时复查大纲承接性。修订涉及大纲调整的，同步更新大纲模块并创建大纲新基线。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划修订对照表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划至大纲追溯链接\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"追溯关系复核记录\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"DOORS数据管理员\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各专题组\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 56, "source_id": null, "target_id": null}]</data>

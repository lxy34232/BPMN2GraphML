      <data key="n_bpmn_id">EBPM_5b913507-77c6-4eb7-bb61-8ec694d98d29</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_5b913507-77c6-4eb7-bb61-8ec694d98d29", "bpmn_type": "manualTask", "name": "科技规划大纲制定", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划大纲制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"各专题组在大纲框架下编写大纲条目。每个条目提炼一个规划要点（方向、目标或任务），用一句话表述，并在条目后注明所依据需求对象的标识（如ZELC-00-162），供后续建链使用。条目要说明“为什么做”（依据）和“做什么”（要点），不展开具体实施内容。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲框架\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主题标注后的政策文本DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"关键需求清单\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科技规划大纲草稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各专题组\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 21, "source_id": null, "target_id": null}]</data>

      <data key="n_bpmn_id">EBPM_bab3f76c-b57c-4e1c-831b-5b1673f2f01f</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_bab3f76c-b57c-4e1c-831b-5b1673f2f01f", "bpmn_type": "manualTask", "name": "开展形势研判与差距分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按“基础—问题—要求—趋势”四个维度编写第一章。发展基础取自上一周期实施评估的代表性成果，以专栏列出。存在问题按组织能力、技术管理、设计开发三个体系维度归纳，每个问题都要能对应到后续章节的任务。上级及公司要求按国家行业、集团、公司三个层级提炼。行业技术趋势取自对标研究报告。章末用一段话归纳本周期科技工作的总体着力点，作为总体要求的输入。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《上一周期科技规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《行业技术趋势与对标研究报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划大纲基线V1.0\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划章节结构及编写分工表\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划第一章《发展基础与形势要求》稿\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 33, "source_id": null, "target_id": null}]</data>

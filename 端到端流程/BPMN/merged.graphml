      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_fa1fea59-dd6e-461a-82be-f788c495e3f8", "bpmn_type": "userTask", "name": "开展需求覆盖性分析", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划大纲制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"在DOORS中做双向追溯检查。正向检查：在政策文本模块中筛选已标注主题的对象，查看入向链接，列出没有被任何大纲条目链接的需求，关键需求清单中的对象逐条检查。反向检查：在大纲模块中筛选没有出向链接的条目，确认是否为公司自主提出的内容并补充依据说明。形成需求覆盖性分析报告，列出未覆盖需求和处理建议（补充条目、并入已有条目、说明不纳入理由）。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"大纲至需求追溯链接\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"关键需求清单\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《需求覆盖性分析报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"DOORS数据管理员\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 25, "source_id": null, "target_id": null}]</data>

    <node id="EBPM_ff45018b-6435-45e5-a3bf-3fb46331badf">
      <data key="n_bpmn_id">EBPM_ff45018b-6435-45e5-a3bf-3fb46331badf</data>
      <data key="n_bpmn_type">manualTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_ff45018b-6435-45e5-a3bf-3fb46331badf", "bpmn_type": "manualTask", "name": "研判需求并归纳规划主题", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划大纲制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"以关键需求清单和主题标签为基础，按主题汇总上级要求、公司要求、发展短板和技术趋势。对每个主题回答三个问题：上级要求做什么、公司战略要求做什么、我们现在差在哪里。把相近的需求归并成规划主题，识别需求之间的冲突和优先级，形成规划需求研判报告。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划需求基线V1.0\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"关键需求清单\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《上一周期科技规划实施评估报告》\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"《行业技术趋势与对标研究报告》\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《规划需求研判报告》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 19, "source_id": null, "target_id": null}]</data>

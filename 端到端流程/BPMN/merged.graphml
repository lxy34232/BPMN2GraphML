      <data key="n_bpmn_type">userTask</data>
      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_287999f7-c46b-4076-b97c-4d2eee7111fb", "bpmn_type": "userTask", "name": "修订规划文本并更新DOORS模块", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划修订评审\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"按修订意见处理表直接在DOORS规划模块中修改对象，新增和删除对象按规范处理（删除采用软删除，保留历史）。改动较大的章节可以在DOORS外修改后对照更新，保证DOORS模块始终是规划文本的唯一权威版本。修订后与上一基线比较，导出修订对照表。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"修订意见处理表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"科技发展规划DOORS模块\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划修订对照表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"各专题组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"DOORS数据管理员\" /&gt;\n          &lt;ns1:property name=\"信息系统\" value=\"DOORS 9.7.2\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 55, "source_id": null, "target_id": null}]</data>

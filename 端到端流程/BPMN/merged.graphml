      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_8796a284-3697-407b-948b-c70e342bfde0", "bpmn_type": "manualTask", "name": "汇总分析修订意见并形成处理意见", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划修订评审\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"编制工作组汇总征求意见、各级评审意见、审议意见和规划修编需求，逐条给出处理意见：采纳、部分采纳或不采纳，不采纳的写明理由。涉及目标、指标或重点方向调整的意见，提交分管领导确定。形成修订意见处理表，作为修订依据和后续评审的说明材料。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技发展规划修订意见\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"一级评审意见\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"二级评审意见\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"党委会前置研究意见\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"总经理办公会审议意见\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划修编需求\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"修订意见处理表\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 54, "source_id": null, "target_id": null}]</data>

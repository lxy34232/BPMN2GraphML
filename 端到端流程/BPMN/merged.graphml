      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_4d5147ee-8beb-49fe-b819-8e4cd2179aad", "bpmn_type": "manualTask", "name": "制定科技规划编制工作方案", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技规划编制策划\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"科技管理部门牵头，依据编制任务和上一周期规划，明确规划期限、编制依据、编制范围（技术、产品、体系、保障）、组织方式、工作节点（需求收集、大纲、初稿、征求意见、评审、审议、发布）和成果形式。方案中明确需求、大纲、规划文本和科研指南全部纳入DOORS结构化管理，并明确规划与年度科研指南的衔接要求。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科技规划编制任务通知\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"上一周期科技发展规划\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"公司科研管理制度\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"《科技规划编制工作方案》\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 1, "source_id": null, "target_id": null}]</data>

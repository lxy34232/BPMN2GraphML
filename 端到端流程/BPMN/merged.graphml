      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_803369cb-eb7d-4614-ab77-be37132f43dc", "bpmn_type": "manualTask", "name": "形成重点任务清单", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科技发展规划制定\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"汇总第三至五章的专栏和重点任务，形成规划重点任务清单。每项任务写明依据（对应的大纲条目）、牵头和协同责任、阶段节点、资源需求、预期成果和验收要求。检查任务与发展目标、主要指标是否对应，避免出现没有任务支撑的目标或没有目标指向的任务。该清单是年度分解和科研指南编制的直接依据。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第三章《关键技术布局》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第四章《重点产品开发》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第五章《科技创新体系建设》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划第六章《规划实施保障》稿\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划重点任务清单\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"规划编制工作组\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 42, "source_id": null, "target_id": null}]</data>

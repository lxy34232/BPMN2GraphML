      <data key="n_bpmn_origins">[{"file": "从科技需求到科技指南发布", "id": "EBPM_fe41810f-b7dc-429d-a9e8-b6d7afb22b43", "bpmn_type": "manualTask", "name": "开展规划年度实施评估", "attrs": {}, "children_xml": ["&lt;ns0:extensionElements xmlns:ns0=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:ns1=\"https://github.com/lxy34232/BPMN2GraphML/properties\"&gt;\n        &lt;ns1:properties&gt;\n          &lt;ns1:property name=\"来源流程\" value=\"科研项目指南编制\" /&gt;\n          &lt;ns1:property name=\"步骤描述\" value=\"年底对照规划任务分解表和主要指标，评估年度目标、任务、里程碑和成果的完成情况，统计指南条目的立项和承接情况（可通过DOORS链接统计各规划任务被指南承接的情况），分析重大偏差的技术、资源和组织原因，提出调整路径、加强协同或退出的建议。规划期中期同时开展中期评估。\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"规划任务分解表\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"主要指标表及口径说明\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"项目实施与验收数据\" /&gt;\n          &lt;ns1:property name=\"输入\" value=\"科研项目指南基线V1.0（正式版）\" /&gt;\n          &lt;ns1:property name=\"输出\" value=\"规划年度实施评估报告\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"科技管理部门\" /&gt;\n          &lt;ns1:property name=\"责任主体\" value=\"株机研究院\" /&gt;\n        &lt;/ns1:properties&gt;\n      &lt;/ns0:extensionElements&gt;"], "order": 95, "source_id": null, "target_id": null}]</data>

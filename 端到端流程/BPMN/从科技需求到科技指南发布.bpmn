    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_9995f64f-04c6-47c8-88fc-2c1b9455889c" name="进行科研指南意见征集">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="通过OA向各单位和专家发出指南征求意见通知并附征求意见稿，意见表包含对象标识、修改建议和理由。" />
          <b2g:property name="输入" value="科研项目指南征求意见稿" />
          <b2g:property name="输出" value="科研指南意见征集通知" />
          <b2g:property name="责任主体" value="规划编制工作组" />

      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d965e619-641f-4260-a6f0-229f32798ae1</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_63f04225-ce22-4758-8b04-e0dc045e9727</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_ce98a042-6be2-456d-852d-2b03f126c612" name="组织科研指南评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="工作组提请技术委员会评审，重点评审指南方向与规划的一致性、项目分类和资源安排的合理性、条目目标和验收要求是否明确。" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输入" value="指南意见处理表" />
          <b2g:property name="输入" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="输出" value="科研指南评审意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_63f04225-ce22-4758-8b04-e0dc045e9727</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e280a3a4-f899-4915-bb0f-5d1a1bd05e0d</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_e144ea03-ec02-4f7c-86f6-1b32d51943eb" name="科研指南评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="判定标准：技术委员会结论为通过的进入发布。提出修改意见的，退回修订后重新评审，只有文字性意见的由工作组确认修改到位后视为通过。" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e280a3a4-f899-4915-bb0f-5d1a1bd05e0d</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_8dc96185-1ffc-434c-adff-6ada348d0199</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_a8898ad7-6b18-4a7c-a3f2-e2fc1e0b4dec</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_47ba6a68-72ac-4405-9309-777cf6220188" name="科研项目指南发布">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按公司程序审批后通过OA发布年度科研项目指南，作为当年科研项目申报和立项评审的依据。" />
          <b2g:property name="输入" value="科研指南评审意见" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南正式发布文件" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8dc96185-1ffc-434c-adff-6ada348d0199</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_29aa1a18-867d-4910-8a50-41d8b2f39abd</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_9ea2e0ed-2a21-4ae2-bf6f-198cce6ea10a" name="发布科研项目指南正式基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="对当年度指南模块建立基线1.0（后缀“正式版”），内容与发布文本一致，模块转为只读。当年立项的科研项目进入“05-科研项目台账”后链接到指南条目，供实施评估统计各研究方向的立项和完成情况。" />
          <b2g:property name="输入" value="科研项目指南正式发布文件" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南正式基线" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_29aa1a18-867d-4910-8a50-41d8b2f39abd</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_fd067e65-3cb5-45f5-ad82-25e19b80f56c</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_09ed77d3-be91-4d55-8489-4924814e33a2" name="确定评估类型与评估方案">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="在每个指南年度结束时启动实施评估，按所处年份确定评估类型：年度评估（每年末）、中期评估（规划期第三年末，同时包含当年年度评估内容）、总结评估（规划期最后一年末）。年度评估重点看任务进度、指南落地和指标年度应达值，中期评估增加目标和重点方向适应性评价并提出是否修编的建议，总结评估评价规划目标完成度和产业贡献，并为下一周期提供发展基础和问题。评估方案明确评估范围、数据项、统计口径（与主要指标口径一致）、数据截止日期、提供单位和时间节点。" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="科研项目指南正式基线" />
          <b2g:property name="输出" value="《规划实施评估工作方案》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_fd067e65-3cb5-45f5-ad82-25e19b80f56c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_6e37b2dd-bae5-4483-95ef-bd4628912891</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_0144adaf-27bc-4069-9f3c-fe94e9e60e86" name="下发评估通知与数据采集模板">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="通过OA下发评估通知和统一的数据采集模板，模板按七类信息分表，每张表列明数据项、口径说明、数据来源和填报单位，并预填规划任务编号和指南条目标识，保证填报数据能对应到DOORS中的规划对象和指南对象。" />
          <b2g:property name="输入" value="《规划实施评估工作方案》" />
          <b2g:property name="输出" value="规划实施评估数据采集模板" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
          <b2g:property name="参与方" value="相关职能部门" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6e37b2dd-bae5-4483-95ef-bd4628912891</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_4247f72c-37e6-4a5e-90e7-3fc0902f849a</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_942f8160-d683-446f-b5e2-b0e0004fd8d5">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_4247f72c-37e6-4a5e-90e7-3fc0902f849a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_42b89b55-af27-4ebd-ba70-d731bcbce53e</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_5fe8a8a7-6b4a-42cc-bc0d-de731e86e167</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_eef75fac-1b67-4b80-a8a9-580c90349743</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_3da2e817-98c1-4ec1-8c4d-bb5975f6853f</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_a31b3718-e663-4e59-ab29-8778d1b0d130</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_6f8e3d52-26be-4d31-840f-2a7b40ad0bcb</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_afa656ff-a8af-42ba-8412-4456bb0eb343</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_c1acf13b-7419-4d69-b776-b2ad6d0f65c1" name="收集规划任务完成情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="按规划任务分解表逐项收集：任务编号、牵头单位、本期计划节点、实际进展、完成状态（未启动、进行中、已完成、延期、调整、退出）、阶段成果、偏差原因和下一步安排。由各任务牵头单位自评填报，附成果证明材料。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="规划任务完成情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_42b89b55-af27-4ebd-ba70-d731bcbce53e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7ce42fb0-80f8-42a9-8086-89c13f50199b</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_5f31ee48-aa17-493a-b77c-fd72bfc0f80b" name="收集科研项目立项与完成情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="按指南研究方向和指南条目收集：指南条目数、申报项目数、立项项目数及立项率、在研项目数、结题验收项目数、延期和终止项目数、验收结论，以及每个项目的项目编号、项目类别、承担单位、起止时间和对应的指南条目标识。数据取自科研项目管理台账。" />
          <b2g:property name="输入" value="科研项目指南正式基线" />
          <b2g:property name="输入" value="科研项目管理台账" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="科研项目立项与完成情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_5fe8a8a7-6b4a-42cc-bc0d-de731e86e167</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f72bd826-c388-49bd-a444-178e2c134fa3</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_e6423ecb-2136-4c68-ab18-42d95e059e9f" name="收集科技成果工程化应用情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="收集科研项目产出并沉淀为技术组件的成果（模型、算法、软件、设计规范、工艺方法、试验方法等）：组件名称、来源项目、技术成熟度、在工程化项目（新产品研制、订单项目、改造项目）中的应用项目名称和次数、应用效果，以及科技成果许可转让收入。" />
          <b2g:property name="输入" value="科研项目验收资料" />
          <b2g:property name="输入" value="工程化项目技术资料" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="科技成果工程化应用情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_eef75fac-1b67-4b80-a8a9-580c90349743</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_1378ea9e-12c5-4b7f-9b03-aa9d3cd454c5</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_5e87f199-da79-45fe-994c-aaaa9f36b6b4" name="收集产品平台化模块化成果运用情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="收集产品平台和核心模块的建设与运用情况：产品平台数量及覆盖的产品型号、核心模块目录条目数及本期新增数、模块在新产品中的复用率、配置基线数量，以及复用带来的研制周期和成本变化。" />
          <b2g:property name="输入" value="产品平台与核心模块目录" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="平台化模块化成果运用情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3da2e817-98c1-4ec1-8c4d-bb5975f6853f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c269dd4d-2fc3-45b2-acee-891cf6cd9b5b</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_4ed6e5d7-fd15-4e21-ac79-9cd51fa9b3c6" name="收集科技人才梯队建设情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="收集领军人才、核心骨干和青年后备人才数量及变化，国家级、省部级、中车级专家入库人数，研发人员数量及占比，承担重大科研任务的青年人才数，设计与工艺人员交流轮岗人次。" />
          <b2g:property name="输入" value="人力资源统计数据" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="科技人才梯队建设情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a31b3718-e663-4e59-ab29-8778d1b0d130</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_6bbe6611-c63a-4347-8b5c-9291d78291b8</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_e7c321d8-bfdb-4387-8c1b-39ccf0d5e526" name="收集重大科技成果情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="收集本期重大科技成果，包括但不限于：重要新产品（首台套、型号定型、示范应用）、行政许可与认证（车辆型号合格证、生产许可、国际认证）、主持和参与的国际、国家、行业标准、省部级以上科技奖励、新增有效发明专利、海外专利和高价值专利、高质量数据集、典型产品碳足迹核算报告。每项成果注明对应的规划任务编号或指南条目标识。" />
          <b2g:property name="输入" value="知识产权标准奖励及认证台账" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="重大科技成果情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6f8e3d52-26be-4d31-840f-2a7b40ad0bcb</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a8625b10-8cd2-4dcd-96d9-1da4ca7aedf9</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_a851ab29-a131-4912-b3ed-1365ab574ed1" name="收集科研经费投入情况">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="按研究方向和项目类别（基础研究、共性技术、工程开发、成果转化）统计预算与实际支出，计算研发投入强度、基础研究及应用基础研究投入占比，并统计国家级、集团级项目等外部资金。" />
          <b2g:property name="输入" value="科研经费财务统计数据" />
          <b2g:property name="输入" value="规划实施评估数据采集模板" />
          <b2g:property name="输出" value="科研经费投入情况表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_afa656ff-a8af-42ba-8412-4456bb0eb343</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a141f004-c8c7-4af9-b16d-b2dd1eedef43</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_ed2c2e74-c3f3-45ec-8b6a-be56252e56b4">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7ce42fb0-80f8-42a9-8086-89c13f50199b</bpmn2:incoming>
      <bpmn2:incoming>EBPM_f72bd826-c388-49bd-a444-178e2c134fa3</bpmn2:incoming>
      <bpmn2:incoming>EBPM_1378ea9e-12c5-4b7f-9b03-aa9d3cd454c5</bpmn2:incoming>
      <bpmn2:incoming>EBPM_c269dd4d-2fc3-45b2-acee-891cf6cd9b5b</bpmn2:incoming>
      <bpmn2:incoming>EBPM_6bbe6611-c63a-4347-8b5c-9291d78291b8</bpmn2:incoming>
      <bpmn2:incoming>EBPM_a8625b10-8cd2-4dcd-96d9-1da4ca7aedf9</bpmn2:incoming>
      <bpmn2:incoming>EBPM_a141f004-c8c7-4af9-b16d-b2dd1eedef43</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_55b54960-f512-40c9-afb3-a1aee9ea2e29</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:exclusiveGateway id="EBPM_8686b721-6694-4387-ae79-df41cb3a0512">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_55b54960-f512-40c9-afb3-a1aee9ea2e29</bpmn2:incoming>
      <bpmn2:incoming>EBPM_c87a1198-64cd-4216-9339-6258a8e8b6d2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b08cd801-f05b-4168-ab9e-3f029232dab1</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_92a2d998-cc20-4644-8d2f-fb7c0b2f0558" name="核验评估数据与统计口径">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="对七类数据做交叉核验：项目台账与经费数据对应，专利、标准、奖励数据与主要指标口径一致，成果和项目都能对应到规划任务编号或指南条目标识，与上年度数据可比。记录缺失、口径不一致和无法对应的数据。" />
          <b2g:property name="输入" value="规划任务完成情况表" />
          <b2g:property name="输入" value="科研项目立项与完成情况表" />
          <b2g:property name="输入" value="科技成果工程化应用情况表" />
          <b2g:property name="输入" value="平台化模块化成果运用情况表" />
          <b2g:property name="输入" value="科技人才梯队建设情况表" />
          <b2g:property name="输入" value="重大科技成果情况表" />
          <b2g:property name="输入" value="科研经费投入情况表" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输出" value="评估数据核验记录" />
          <b2g:property name="输出" value="核验后评估数据集" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b08cd801-f05b-4168-ab9e-3f029232dab1</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_066de49f-ef59-4f9c-aa66-a5b139026e29</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_3b39c541-b080-4ffb-8155-be5fc935f39b" name="评估数据是否完整准确？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="判定标准：七类数据均已按模板填报，口径与主要指标表一致，关键数据（任务状态、立项与验收、主要指标）无缺失，成果和项目都能对应到规划对象或指南对象。不满足的退回补充核实。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_066de49f-ef59-4f9c-aa66-a5b139026e29</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_158ce635-8caf-490d-9a03-ca617cb08508</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_ea0e6c19-f678-4422-860d-c89f45d0b825</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_0627d918-f9bb-4a86-bcb9-f7b09c2b3dac" name="补充核实评估数据">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="按核验记录向数据提供单位逐项核实和补充，必要时调取原始台账，修正后重新核验。" />
          <b2g:property name="输入" value="评估数据核验记录" />
          <b2g:property name="输出" value="核验后评估数据集" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ea0e6c19-f678-4422-860d-c89f45d0b825</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c87a1198-64cd-4216-9339-6258a8e8b6d2</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_163db1f7-ddb2-454e-ac2c-b15fba96a8dd" name="评估数据录入DOORS并建立追溯">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="把当年立项项目导入“05-科研项目台账”模块，更新已有项目的“项目状态”，建立项目指向指南条目的“实施”链接。在“06-规划实施评估”模块中为每个规划重点任务建立当期评估对象，填写“评估年度”“评估类型”“实施状态”“完成度”“偏差说明”属性，建立指向规划任务对象的“评估”链接。" />
          <b2g:property name="输入" value="核验后评估数据集" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="科研项目指南正式基线" />
          <b2g:property name="输出" value="科研项目台账DOORS模块" />
          <b2g:property name="输出" value="规划实施评估DOORS模块" />
          <b2g:property name="输出" value="项目至指南追溯链接" />
          <b2g:property name="输出" value="评估至规划追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_158ce635-8caf-490d-9a03-ca617cb08508</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_659ff738-78c2-4c70-80bc-63e5241d9265</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_36a5ed4c-8d00-47a0-89e1-78318f05409d" name="开展追溯统计与完成度分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="沿“规划任务—指南条目—科研项目”链路统计每项规划任务被多少指南条目落实、立项和验收了多少项目，找出没有指南落实的任务、有指南但无项目响应的方向和立项后未按期完成的项目。主要指标按“实际值/目标值”与时间进度（如五年规划第二年末为40%）对比，判断超前、正常或滞后。同时分析成果工程化应用、平台模块复用、人才梯队和经费结构是否符合规划导向。" />
          <b2g:property name="输入" value="规划实施评估DOORS模块" />
          <b2g:property name="输入" value="项目至指南追溯链接" />
          <b2g:property name="输入" value="评估至规划追溯链接" />
          <b2g:property name="输入" value="核验后评估数据集" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输出" value="规划实施完成度分析表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_659ff738-78c2-4c70-80bc-63e5241d9265</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d82af163-7fc6-48fc-81f3-f149acdb02c2</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_9a87a989-10c7-4529-99a2-912035c75476" name="分析偏差原因并提出调整建议">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="对滞后的任务和指标从技术、资源和组织三方面分析原因。按规划确定的规则提出建议：调整技术路径、加强协同或资源投入、实施退出（长期无法验证、缺乏应用主体或偏离方向的任务），以及下一年度指南需要加强、新增或退出的方向。中期评估还要判断规划目标和重点方向是否需要修编。" />
          <b2g:property name="输入" value="规划实施完成度分析表" />
          <b2g:property name="输入" value="核验后评估数据集" />
          <b2g:property name="输出" value="规划实施评估调整建议" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d82af163-7fc6-48fc-81f3-f149acdb02c2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_182ffcd6-8957-49aa-8050-07c418d1ae70</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_cd1c533d-d500-4468-af78-fb75b187024d" name="形成规划实施评估报告">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="按评估类型编写报告：年度评估报告写年度目标、任务、里程碑和成果完成情况及调整建议，中期评估报告增加目标适应性评价和修编建议，总结评估报告写规划目标完成度、代表性成果、体系问题和产业贡献，作为下一周期规划的发展基础和问题来源。" />
          <b2g:property name="输入" value="规划实施完成度分析表" />
          <b2g:property name="输入" value="规划实施评估调整建议" />
          <b2g:property name="输入" value="《规划实施评估工作方案》" />
          <b2g:property name="输出" value="《规划实施评估报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:b2g="https://github.com/lxy34232/BPMN2GraphML/properties" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:process id="Process_1">
    <bpmn2:startEvent id="EBPM_9ce51136-3199-456e-8fc6-d7ac6da906d0" name="科技规划编制任务已下达">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="公司启动新一轮五年科技发展规划编制，由公司领导批示或上级通知下达编制任务，明确规划周期和总体时间要求。" />
          <b2g:property name="输入" value="上级及公司规划编制要求" />
          <b2g:property name="输出" value="科技规划编制任务通知" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>EBPM_d2558663-4e14-4975-b97f-e956935be00e</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:manualTask id="EBPM_798e77e3-2479-4914-ac5d-b94459f9cab9" name="制定科技规划编制工作方案">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="科技管理部门依据编制任务和上一周期规划，明确规划期限、编制依据、编制范围（技术、产品、体系、保障）、组织方式、工作节点（需求收集、大纲、初稿、征求意见、评审、审议、发布）和成果形式。方案明确由规划编制工作组作为编制主体，需求、大纲、规划文本、科研指南和实施评估全部纳入DOORS结构化管理，并明确规划与年度科研指南、实施评估的衔接要求。" />
          <b2g:property name="输入" value="科技规划编制任务通知" />
          <b2g:property name="输入" value="上一周期科技发展规划" />
          <b2g:property name="输入" value="公司科研管理制度" />
          <b2g:property name="输出" value="《科技规划编制工作方案》" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d2558663-4e14-4975-b97f-e956935be00e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_26f74a44-3d38-43ad-a808-36199ad9301e</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_2661ae1c-db73-4a2b-96b6-a390eff47a55" name="组建规划编制工作组与专题组">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="组建规划编制工作组，作为规划编制、指南编制和实施评估的统一执行主体。工作组由科技管理部门牵头，从相关部门抽调人员组成，内部按规划主题设置专题（产业与产品、技术研究、科技管理体系、设计开发体系、数智化转型、知识产权与标准化、保障措施），明确各专题的牵头人、成员、负责章节和交付节点，并在组内指定DOORS管理员负责模块配置、导入和基线操作。" />
          <b2g:property name="输入" value="《科技规划编制工作方案》" />
          <b2g:property name="输出" value="规划编制工作组及专题组名单" />
          <b2g:property name="输出" value="专题分工表" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_26f74a44-3d38-43ad-a808-36199ad9301e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d462c6ea-c42d-4b54-8176-135acf316f2a</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_32429fa9-79aa-4ed7-bce4-36623c79538b" name="制定DOORS规划数据管理规范">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="制定规划数据在DOORS中的统一规则，作为后续导入、建链和基线管理的依据。一是文件夹与模块分层：01-政策文本（每份来源文件一个模块）、02-科技规划大纲、03-科技规划文本、04-科研项目指南（每年度一个模块）、05-科研项目台账、06-规划实施评估、07-修订意见。二是对象标识前缀：每个模块使用唯一前缀加文件序号（如CGDP-00、CRRC-00、ZELC-01、TPLP-00、TPDT-00），对象标识一经生成不再变更。三是对象拆分规则：一个对象表达一条完整要求，标题对象保留原文章节层级，并用“条目类型”属性区分标题、要点和说明。四是属性与枚举：统一使用“规划主题”（多值枚举）、“需求等级”（关键需求、一般需求、不纳入）、“处理说明”等属性，各模块的专用属性在模板中定义。五是链接语义：链接一律从下游指向上游，每种关系使用独立链接模块，即依据（大纲至需求）、承接（规划至大纲）、落实（指南至规划）、实施（项目至指南）、评估（评估记录至规划）、针对（意见至被修订对象）。六是基线规则：编号采用“主版本.次版本+后缀”，编制过程草稿为0.x，正式发布为1.0，滚动修编后的正式版为2.0，正式版勘误为1.1，后缀写明用途（如征求意见稿、送审稿、2027年度评估）。在需求、大纲、规划发布等里程碑使用基线集（Baseline Set）对相关模块同时建立基线，保证同一时点的追溯关系一致。" />
          <b2g:property name="输入" value="《科技规划编制工作方案》" />
          <b2g:property name="输出" value="《DOORS规划数据管理规范》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d462c6ea-c42d-4b54-8176-135acf316f2a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_49190869-5167-43d5-9ffb-10691db047b8</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_0302d42d-9bea-445d-b9ad-a14e6aca011e" name="配置DOORS模块模板与链接规则">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="按规范在DOORS项目中建立01至07文件夹，为每类模块建立模板，包含属性定义、枚举类型和标准视图。建立依据、承接、落实、实施、评估、针对六个链接模块，在各模块属性中设置链接集配对，并只允许通过指定链接模块建链，避免使用默认的DOORS Links。标准视图包括：全文视图、追溯视图（用分析向导生成入向和出向链接列，即现有“深度为1的出向链接”列）、覆盖缺口视图（过滤没有入链或出链的要点对象）。设置访问权限：工作组成员按专题拥有编辑权限，其他人员只读，模块建立正式基线后转为只读。同时把现有政策文本模块中名称和取值不统一的字段（如“科技体系相关”“科技规划相关”“备注”）按模板迁移为“规划主题”“需求等级”“处理说明”。" />
          <b2g:property name="输入" value="《DOORS规划数据管理规范》" />
          <b2g:property name="输出" value="DOORS模块模板与链接模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_49190869-5167-43d5-9ffb-10691db047b8</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_8be0e4f0-1ded-479a-8775-2882f915918a</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:parallelGateway id="EBPM_f7f9a89c-9cae-4a20-be67-057678659a60">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8be0e4f0-1ded-479a-8775-2882f915918a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f5799d71-b203-429e-9846-1583fe75855f</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_2ebce50f-c8d7-4cf1-bf5b-851b11e506a3</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_62611631-a8db-474a-a379-62c5a0b93463</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_2b199d4e-e1bf-4136-961d-2d952d86f018</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_6160d634-b370-4299-b1a9-a7148c38e731</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_346ec82f-db84-4bb2-b252-05facc49ccaf" name="收集国家及行业政策规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="收集与公司业务相关的国家和行业上位规划，如国民经济和社会发展五年规划纲要、国家科技创新规划、铁路科技创新五年规划、城市轨道交通智慧城轨发展纲要，以及交通强国、能源和新兴产业专项规划。登记发布单位、发布日期和版本，优先使用正式发布稿，暂用征求意见稿的须标注，正式稿发布后替换。" />
          <b2g:property name="输入" value="国家及行业政策规划原文" />
          <b2g:property name="输出" value="国家及行业政策规划文件集" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f5799d71-b203-429e-9846-1583fe75855f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f00116a8-afb3-4fa5-ad13-7b8bf6b5e977</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_0b2fa3fc-4e57-4c0e-a41f-f60c99863fad" name="收集集团战略与科技规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="收集集团层面的发展战略纲要、科技发展规划、数智化转型方案和相关专项规划，重点识别对子公司的承接要求，如“一鼎两环三支撑”大创新体系、“1+M+N+X”规划体系、“双赛道双集群”产业布局和集团考核指标。" />
          <b2g:property name="输入" value="集团战略与科技规划原文" />
          <b2g:property name="输出" value="集团战略与科技规划文件集" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_2ebce50f-c8d7-4cf1-bf5b-851b11e506a3</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_13684197-66f5-4054-8075-bbd948fce952</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_5ffabccd-e7b5-4901-ab8e-ed2940c101e1" name="收集公司战略部署与领导讲话">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="收集公司党代会报告、战略规划务虚会和科技规划务虚会领导讲话、公司五年发展规划等文件，提炼公司中心任务（如建设“新质株机”）、战略工程和对科技创新的明确要求。领导讲话中的定性要求和公司发展规划中的量化目标都要纳入。行业技术趋势和对标研究的结论已体现在这些文件和各单位科技需求中，不单独开展研究。" />
          <b2g:property name="输入" value="公司党代会报告及务虚会讲话" />
          <b2g:property name="输入" value="公司五年发展规划" />
          <b2g:property name="输出" value="公司战略部署与领导讲话文件集" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_62611631-a8db-474a-a379-62c5a0b93463</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_99187548-33c7-4ca3-8148-5fff91b100de</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_c636fecb-8c8b-4a71-a75e-e46cd1be95d4" name="提取上一周期规划总结评估结论">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="以上一周期“科技规划实施评估”子流程形成的总结评估报告为依据，提取代表性成果（作为新规划的发展基础）、主要指标完成情况、未完成或退出的任务及原因、组织能力、技术管理和设计开发三个体系维度的问题（作为新规划的存在问题），形成上一周期发展基础与问题清单。上一周期未按本流程开展总结评估的，先按“科技规划实施评估”子流程补做一次总结评估。" />
          <b2g:property name="输入" value="《规划实施评估报告》" />
          <b2g:property name="输出" value="上一周期发展基础与问题清单" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_2b199d4e-e1bf-4136-961d-2d952d86f018</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_dd9d935e-b4c7-447e-b048-13e92b40585d</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_0ffda187-92b3-49d3-adc2-5a3ef299ba10" name="收集业务单位与市场用户科技需求">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="向各业务单位、分子公司、营销和服务部门征集科技需求，覆盖市场与用户需求、产品竞争力短板、现场质量问题、全寿命周期服务、海外区域适配需求以及各单位日常跟踪的技术趋势和对标结论。按统一模板填写需求背景、期望目标、紧迫程度和关联产品，体现“需求牵引”原则。" />
          <b2g:property name="输入" value="业务单位科技需求反馈" />
          <b2g:property name="输入" value="用户与现场问题记录" />
          <b2g:property name="输出" value="业务单位与市场用户科技需求汇总表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6160d634-b370-4299-b1a9-a7148c38e731</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_fdc57c54-4b8f-4b92-ba6f-018aeabf57dd</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_9c451536-c1d4-43d0-90a9-ad4367791756">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f00116a8-afb3-4fa5-ad13-7b8bf6b5e977</bpmn2:incoming>
      <bpmn2:incoming>EBPM_13684197-66f5-4054-8075-bbd948fce952</bpmn2:incoming>
      <bpmn2:incoming>EBPM_99187548-33c7-4ca3-8148-5fff91b100de</bpmn2:incoming>
      <bpmn2:incoming>EBPM_dd9d935e-b4c7-447e-b048-13e92b40585d</bpmn2:incoming>
      <bpmn2:incoming>EBPM_fdc57c54-4b8f-4b92-ba6f-018aeabf57dd</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_76158747-1486-45c7-95c4-5a8e1fc5f85a</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_deb80190-79ec-4cdc-8d51-927ec961016c" name="科技规划需求文本结构化">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="按《DOORS规划数据管理规范》把收集到的文件整理成可导入的结构化文本。在Word中用标题样式标出原文章节层级，正文拆分到“一个对象表达一条完整要求”的粒度，清除页眉页脚、目录、图表说明等无关内容，统一标点和编号格式，每份文件形成一个待导入文本并登记来源和版本。需求汇总表和上一周期发展基础与问题清单同样结构化后导入。" />
          <b2g:property name="输入" value="国家及行业政策规划文件集" />
          <b2g:property name="输入" value="集团战略与科技规划文件集" />
          <b2g:property name="输入" value="公司战略部署与领导讲话文件集" />
          <b2g:property name="输入" value="上一周期发展基础与问题清单" />
          <b2g:property name="输入" value="业务单位与市场用户科技需求汇总表" />
          <b2g:property name="输入" value="《DOORS规划数据管理规范》" />
          <b2g:property name="输出" value="结构化需求文本" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_76158747-1486-45c7-95c4-5a8e1fc5f85a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_814d1f9c-5c15-46e4-b3cb-dc405a14966f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_4cdf4084-5b28-46ca-bf84-d77f2b3b18a1">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_814d1f9c-5c15-46e4-b3cb-dc405a14966f</bpmn2:incoming>
      <bpmn2:incoming>EBPM_144b5541-53c3-4284-9e10-e2617abc8a4e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_5523121f-24d7-45a1-a705-5c35d832d585</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_377f5e99-e272-4d63-80df-91f5bf91cb02" name="科技规划需求规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="DOORS管理员用政策文本模板在“01-政策文本”下为每份文件建立模块，模块名采用“序号+文件名称”，通过Word导入把标题样式映射为DOORS标题层级。导入后设置“条目类型”属性，在模块属性中记录来源文件、发布单位、版本和导入日期。" />
          <b2g:property name="输入" value="结构化需求文本" />
          <b2g:property name="输入" value="DOORS模块模板与链接模块" />
          <b2g:property name="输出" value="政策文本DOORS模块（导入稿）" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_5523121f-24d7-45a1-a705-5c35d832d585</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b02d81c4-37ee-44d5-acc9-34f4962cb8f2</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_cba05653-7d47-42cb-9153-c3043b9d2bea" name="需求导入质量是否合格？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="判定标准：抽查对象内容与原文一致，无遗漏、无乱码，标题层级与原文章节一致，对象粒度符合“一条要求一个对象”，模块命名、对象前缀和属性符合规范。全部满足为合格，任一项不满足为不合格，记录问题后退回修正。" />
          <b2g:property name="输出" value="导入质量核查记录" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b02d81c4-37ee-44d5-acc9-34f4962cb8f2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_af822e87-6713-4840-984e-60cbb83eac70</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_0d36a2eb-fb0e-4dc7-864e-a77553963991</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_853397f3-3885-45db-8972-daf8b8508e67" name="修正结构化需求文本">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="根据导入质量核查记录定位问题，修正结构化文本的拆分粒度、层级、编号或字符问题。问题较多的模块删除后重新导入，个别问题直接在DOORS中修正。" />
          <b2g:property name="输入" value="导入质量核查记录" />
          <b2g:property name="输入" value="结构化需求文本" />
          <b2g:property name="输出" value="结构化需求文本" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_0d36a2eb-fb0e-4dc7-864e-a77553963991</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_144b5541-53c3-4284-9e10-e2617abc8a4e</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_ef96b943-7f72-42a5-ab85-2fbac1b8178e" name="标注需求条目规划主题并识别关键需求">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="工作组按专题分工逐模块阅读政策文本，对与公司科技规划相关的要点对象填写“规划主题”属性（如总体战略、科技体系、产业升级、人才队伍、战新产业、质量管理、数智转型），一个对象可选多个主题。在“需求等级”属性中区分关键需求（上级明确下达的目标、指标和任务，以及公司领导明确提出的要求）、一般需求和不纳入。用“需求等级=关键需求”的过滤视图导出关键需求清单，作为大纲覆盖性分析的检查对象。" />
          <b2g:property name="输入" value="政策文本DOORS模块（导入稿）" />
          <b2g:property name="输入" value="专题分工表" />
          <b2g:property name="输出" value="主题标注后的政策文本DOORS模块" />
          <b2g:property name="输出" value="关键需求清单" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_af822e87-6713-4840-984e-60cbb83eac70</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_11be9c24-3e54-40ac-99ec-fe74fdafe959</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_8eabf3d7-06b7-4d67-bd5c-bde0879a2f01" name="发布科技规划需求基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="主题标注完成后，用基线集对“01-政策文本”下的全部模块同时建立基线1.0，后缀写明规划周期（如“十五五需求”），大纲链接均以该基线为准。上位文件正式稿替换征求意见稿时，更新对应模块并建立1.1基线，同时检查受影响的链接。" />
          <b2g:property name="输入" value="主题标注后的政策文本DOORS模块" />
          <b2g:property name="输出" value="科技规划需求基线" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_11be9c24-3e54-40ac-99ec-fe74fdafe959</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_9c1298c1-248c-4fb0-8b35-eb015e1e023b</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_524af417-0d1a-44da-bb7e-f3ea7c61a19c" name="研判需求并归纳规划主题">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="在DOORS中按“规划主题”分组查看需求，汇总每个主题下的上级要求、公司要求和发展短板。对每个主题回答三个问题：上级要求做什么、公司战略要求做什么、我们现在差在哪里。把相近的需求归并成规划主题，识别需求之间的冲突和优先级，形成规划需求研判报告。" />
          <b2g:property name="输入" value="科技规划需求基线" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输入" value="上一周期发展基础与问题清单" />
          <b2g:property name="输出" value="《规划需求研判报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_9c1298c1-248c-4fb0-8b35-eb015e1e023b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_5bb0095e-1971-440c-b04d-f9b61108e78b</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_7dba4026-3428-43c2-aa22-7e82ad19c5ff" name="确定科技规划大纲框架">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="依据研判结果确定大纲的一、二级章节，原则上承接上位科技规划的结构并对应公司战略工程。参考框架：总体要求、双赛道产业布局与提质（按机车、城轨、动车组、磁浮、产品+、维保、战新板块展开）、技术研究（根技术、软件定义产品、核心技术攻关、自主化、碳管理）、科技管理体系、设计开发体系、数智化转型、知识产权与标准化、保障措施。框架经工作组讨论确认后，把二级章节分配到各专题。" />
          <b2g:property name="输入" value="《规划需求研判报告》" />
          <b2g:property name="输入" value="专题分工表" />
          <b2g:property name="输出" value="科技规划大纲框架" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_5bb0095e-1971-440c-b04d-f9b61108e78b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a7e36637-16fa-442b-95a4-c2acc1de7df4</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_9e961ba6-af51-4f27-baec-cc0abdcc89e0" name="科技规划大纲制定">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="工作组按专题在大纲框架下编写大纲条目。每个条目提炼一个规划要点（方向、目标或任务），用一句话表述，并在条目后注明所依据需求对象的标识（如ZELC-00-162），供后续建链使用。条目要说明“为什么做”（依据）和“做什么”（要点），不展开具体实施内容。" />
          <b2g:property name="输入" value="科技规划大纲框架" />
          <b2g:property name="输入" value="主题标注后的政策文本DOORS模块" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输出" value="科技规划大纲草稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a7e36637-16fa-442b-95a4-c2acc1de7df4</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7447e127-ee50-46cf-9951-3de84ffa9301</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_62d214d9-7451-4504-ac19-0cb2fafd9d2c" name="科技规划大纲规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="用大纲模板建立“02-科技规划大纲”模块（前缀TPLP），导入大纲草稿，章节为标题对象，条目为要点对象，并填写“所属专题”属性。条目注明的依据标识暂存在“依据标识”临时属性中，供建链使用。" />
          <b2g:property name="输入" value="科技规划大纲草稿" />
          <b2g:property name="输入" value="DOORS模块模板与链接模块" />
          <b2g:property name="输出" value="科技规划大纲DOORS模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7447e127-ee50-46cf-9951-3de84ffa9301</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_3faef28f-3b63-4795-9628-f0517073a8b0</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_bc58dcab-a5d6-4ec9-b646-5284de408f75" name="创建科技大纲模块与科技规划需求模块追溯链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="按“依据标识”属性，从大纲对象向政策文本对象创建“依据”链接，一个大纲条目可以链接多个需求对象。条目较多时可用DXL脚本按依据标识批量建链。建链后打开追溯视图，逐条核对链接目标与依据是否一致，核对完成后清空“依据标识”属性。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="科技规划需求基线" />
          <b2g:property name="输出" value="大纲至需求追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3faef28f-3b63-4795-9628-f0517073a8b0</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_df659bfc-e710-40b8-96d6-b34600771e04</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_85333a95-b8a7-446e-9648-c121e8474a1c">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_df659bfc-e710-40b8-96d6-b34600771e04</bpmn2:incoming>
      <bpmn2:incoming>EBPM_7ea5ae49-a7f4-4c30-880a-715c76661939</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_41bbd9ae-753d-4288-a324-916daa2666d8</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_e9bf4689-f6bc-4bce-bc95-9364659b4161" name="开展需求覆盖性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="在DOORS中做双向追溯检查。正向检查：在政策文本模块中用覆盖缺口视图过滤“需求等级=关键需求”且没有入链的对象，再对一般需求统计覆盖率。反向检查：在大纲模块中过滤没有出链的要点对象，确认是否为公司自主提出的内容，并在“处理说明”中补充依据。形成需求覆盖性分析报告，列出未覆盖需求和处理建议（补充条目、并入已有条目、说明不纳入理由）。" />
          <b2g:property name="输入" value="大纲至需求追溯链接" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输出" value="《需求覆盖性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_41bbd9ae-753d-4288-a324-916daa2666d8</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_155e13c0-4d82-45d0-845f-6fe2a4cf89d2</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_292da30f-59cc-4fc5-8f14-1beea32f0542" name="关键需求是否全部覆盖？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="判定标准：关键需求全部有大纲入链，或已在“处理说明”中记录经工作组确认的不纳入理由。一般需求的覆盖率作为参考，不作为否决条件。没有出链的大纲要点都已有依据说明。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_155e13c0-4d82-45d0-845f-6fe2a4cf89d2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_0d819d76-2286-4823-bd58-5db4d9d0da4b</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_67419698-9cc4-4748-acce-883bfb489c74</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_547ceffc-bfcb-46c0-b3da-600fa2329d9b" name="组织大纲研讨审查">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="工作组组织研讨大纲，并请分管领导参加。审查重点：框架是否完整承接上位规划和公司战略，主题之间有无重叠或遗漏，条目方向是否清晰、能否展开为规划内容，与公司发展规划的目标是否一致。研讨结论形成大纲审查意见。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="《需求覆盖性分析报告》" />
          <b2g:property name="输出" value="大纲审查意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_0d819d76-2286-4823-bd58-5db4d9d0da4b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_87bc9bea-b280-4d88-a69e-706e93175fac</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_f0725c07-8935-426d-9ddc-9716c6dda977" name="大纲是否通过审查？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="判定标准：审查意见中没有“框架调整”或“方向性修改”类意见即为通过，文字性意见在发布基线前直接修改。存在方向性意见时退回补充调整。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_87bc9bea-b280-4d88-a69e-706e93175fac</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_996a1c0a-74dd-4928-ab60-a13b29fdd9b0</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_21c37b1b-3126-41a2-ab37-f8a4beb4b2ad</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="EBPM_f60482ec-0f5a-44d6-af2b-481066e536ab">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_67419698-9cc4-4748-acce-883bfb489c74</bpmn2:incoming>
      <bpmn2:incoming>EBPM_21c37b1b-3126-41a2-ab37-f8a4beb4b2ad</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_081cbf71-f1c7-477b-bce0-2ac71a0c23ad</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_2c27b995-4d18-4850-8a5a-3f6a543d131d" name="补充调整大纲条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="根据需求覆盖性分析报告或大纲审查意见，在DOORS大纲模块中新增、修改或合并条目，同步补充或调整“依据”链接。对决定不纳入的需求，把“需求等级”改为不纳入并在“处理说明”中记录理由。调整后重新开展覆盖性分析。" />
          <b2g:property name="输入" value="《需求覆盖性分析报告》" />
          <b2g:property name="输入" value="大纲审查意见" />
          <b2g:property name="输出" value="科技规划大纲DOORS模块" />
          <b2g:property name="输出" value="大纲至需求追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_081cbf71-f1c7-477b-bce0-2ac71a0c23ad</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7ea5ae49-a7f4-4c30-880a-715c76661939</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_ac1b6bc2-54e9-4a71-9c08-db4dcec29238" name="科技规划大纲基线发布">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="对“02-科技规划大纲”模块建立基线1.0，后缀写明审查通过日期。大纲基线是规划文本编写和建链的依据，基线发布后大纲如需调整，须经工作组确认并建立1.1等后续基线。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="大纲审查意见" />
          <b2g:property name="输出" value="科技规划大纲基线" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_996a1c0a-74dd-4928-ab60-a13b29fdd9b0</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b0c57834-0a2e-4b5a-ad1b-3fc6c711beb5</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_86c355cc-e702-4de5-841b-785bc553fb5a" name="确定规划文本结构与编写分工">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="把大纲转化为规划文本的章节结构，按“形势—要求—任务—保障”的逻辑组织：摘要、发展基础与形势要求、总体要求、关键技术布局、重点产品开发、科技创新体系建设、规划实施保障。建立大纲章节与规划章节的对应表（如大纲“技术研究”对应规划“强化关键技术布局”，大纲“双赛道产业布局”对应规划“推进重点产品开发”），按对应关系把各章分配到专题并指定统稿人，统一专栏表格的格式。" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="专题分工表" />
          <b2g:property name="输出" value="规划章节结构及编写分工表" />
          <b2g:property name="输出" value="大纲与规划章节对应表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b0c57834-0a2e-4b5a-ad1b-3fc6c711beb5</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c94a86ad-cfc7-4bbd-8810-3a14664e1a59</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_b1b4fa31-393b-44d5-a9d3-bd544def4bd0" name="开展形势研判与差距分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按“基础—问题—要求—趋势”四个维度编写第一章。发展基础取自上一周期总结评估的代表性成果，以专栏列出。存在问题按组织能力、技术管理、设计开发三个体系维度归纳，每个问题都要能对应到后续章节的任务。上级及公司要求按国家行业、集团、公司三个层级提炼。行业技术趋势从上位规划、公司战略文件和各单位科技需求中的相关论述归纳。章末用一段话归纳本周期科技工作的总体着力点，作为总体要求的输入。" />
          <b2g:property name="输入" value="上一周期发展基础与问题清单" />
          <b2g:property name="输入" value="科技规划需求基线" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="规划章节结构及编写分工表" />
          <b2g:property name="输出" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c94a86ad-cfc7-4bbd-8810-3a14664e1a59</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b73441bb-0555-4a85-be33-0c4de0b0580b</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_c0e17841-fdbc-4d22-88de-a3a589bf7328" name="确定指导思想、基本原则与发展目标">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="编写第二章总体要求。指导思想承接上位规划的表述并落到公司中心任务。基本原则从规划需求研判中提炼（如战略牵引、需求牵引、分层协同、平台复用、开放协同与自主可控、价值导向），每条原则都应在后续任务中有所体现。发展目标先写期末总体目标，再按技术供给、产品开发、研发与工程转化、数智与服务、创新体系效能等能力维度分述，并与第一章提出的问题对应。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="《规划需求研判报告》" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输出" value="规划第二章《总体要求》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b73441bb-0555-4a85-be33-0c4de0b0580b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_4b6b8d0b-0cb7-44f7-8599-e194d1e54c92</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_abe102d5-01b6-4c28-bed4-bee3d22441c4" name="测算主要指标并确认统计口径">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="从上位规划的考核指标和公司发展目标中选取科技主要指标（如科技奖励、发明专利、海外专利、标准、研发投入强度、基础研究投入占比、研发人员占比、成果转化收入、高质量数据集、碳足迹核算）。每个指标以上一周期实际值和增长趋势为基础测算期末目标，区分“五年累计”与“期末值”，并测算各年度应达值，供年度评估对照。与人力资源、财务、知识产权等职能部门逐项确认统计口径和数据来源，形成主要指标表，口径说明写入专栏。指标口径同时作为实施评估的数据采集口径。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="《规划实施评估报告》" />
          <b2g:property name="输入" value="集团战略与科技规划文件集" />
          <b2g:property name="输出" value="主要指标表及口径说明" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_4b6b8d0b-0cb7-44f7-8599-e194d1e54c92</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a44b82c1-951a-4512-a67a-020e14e9eb0a</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_0599446d-d209-4076-b0de-f9a0f0b2bf6b">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a44b82c1-951a-4512-a67a-020e14e9eb0a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c09b9ac1-53be-4366-b9e4-871f071a4434</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_06b8cefd-fe2e-4751-9674-a898f4f63d66</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_d553e28f-5b16-4e55-97b4-7086b3c1a6e5</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_3b500fdb-a548-4ca6-8029-f92ceb4cc5e6</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_6da80009-363b-45ae-aec4-763c832976fb" name="编制关键技术布局">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按“分层”原则编写技术布局章节。根技术（如系统集成、复杂结构、能源动力、控制算法）侧重长期积累，写研究重点和要积累的方法、模型与验证能力。下一代关键技术侧重任务突破，每项写研究目标、验证场景和产品承接要求。全寿命周期技术（造修一体、状态修、延寿评估）以重点任务专栏列出。战新及未来产业技术储备说明与主业的协同关系，按成熟度分阶段投入。判断一项技术放在哪一层的依据：是否跨产品共性、是否有明确的产品承接对象、成熟度高低。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="科技规划需求基线" />
          <b2g:property name="输出" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c09b9ac1-53be-4366-b9e4-871f071a4434</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_211199be-9343-4263-a502-8c7879fae4af</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_7314d10b-1913-4750-a66e-a69de73ce7a4" name="编制重点产品开发规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按车辆产品（机车、城轨、动车组、磁浮）、“产品+”与数智产业产品、战新及未来产业产品三类编写产品开发章节。每类先写期末产品谱系目标，再以专栏列出重点产品及方向，每个产品写清面向的市场、核心技术和要达到的能力。筛选重点产品的依据：有无明确市场需求、能否支撑主业升级或服务转型、能否复用技术平台成果。战新产业突出产品定义和场景验证，未来产业按原理样机、典型场景、商业可行性分阶段验证。数智产品可按年份写出分阶段推进安排。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="业务单位与市场用户科技需求汇总表" />
          <b2g:property name="输出" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_06b8cefd-fe2e-4751-9674-a898f4f63d66</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_bbe9ebd1-84ba-47c5-bb36-5ea1336859b8</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_308df7c8-45c2-4a0a-b1a8-dc5d655b00ed" name="编制科技创新体系建设任务">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="编写科技创新体系章节，任务直接对应第一章提出的体系问题。内容包括：科技治理与研发组织（技术委员会、研发分工、多地资源统筹、立项与规划贯通），正向研发与成果转化（需求与构型管理、分层研发、技术平台管理、成熟度评价、转化路径），开放协同与知识产权标准认证，工艺与质量体系，工艺材料与试验验证。每项任务写明要建立的机制或能力，涉及权限和机构设置的写为“按公司制度落实”。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输出" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d553e28f-5b16-4e55-97b4-7086b3c1a6e5</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_4c6f4dbc-cc9c-4ad2-8bcd-f0865a77f2a2</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_1e16b7e2-9193-4545-a520-8e6fef4936a2" name="编制规划实施保障">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="编写实施保障章节，包括科技人才、科技投入、研发基础条件、规划实施与评估。实施安排分三个阶段（如夯基整合、突破示范、固化收官），每个阶段写明重点任务和阶段成果。明确年度调度机制（年初定目标、季度跟踪、半年度专题评估、年度报告）、年度评估、中期评估和总结评估的时点与内容，风险清单（技术路线、供应、知识产权、标准认证、数据网络安全、进度、成果转化）和滚动修编的触发条件，并规定规划任务通过年度科研指南落地。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="公司科研管理制度" />
          <b2g:property name="输出" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3b500fdb-a548-4ca6-8029-f92ceb4cc5e6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7be0045b-d2d3-4b2e-9ba7-e82c8263d72c</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_d8d7650d-5890-4b3b-8737-c678f8059d4c">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_211199be-9343-4263-a502-8c7879fae4af</bpmn2:incoming>
      <bpmn2:incoming>EBPM_bbe9ebd1-84ba-47c5-bb36-5ea1336859b8</bpmn2:incoming>
      <bpmn2:incoming>EBPM_4c6f4dbc-cc9c-4ad2-8bcd-f0865a77f2a2</bpmn2:incoming>
      <bpmn2:incoming>EBPM_7be0045b-d2d3-4b2e-9ba7-e82c8263d72c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_3c6cf0e9-4a1a-4d88-991c-26c4ec88756b</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_8676593e-85a3-4993-a0c6-4e463fb08f7f" name="形成重点任务清单">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="汇总第三至五章的专栏和重点任务，形成规划重点任务清单。每项任务写明任务编号、依据（对应的大纲条目）、牵头和协同单位、阶段节点、资源需求、预期成果和验收要求。检查任务与发展目标、主要指标是否对应，避免出现没有任务支撑的目标或没有目标指向的任务。该清单是年度分解、科研指南编制和实施评估的直接依据。" />
          <b2g:property name="输入" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="输入" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="输入" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="输入" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输出" value="规划重点任务清单" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3c6cf0e9-4a1a-4d88-991c-26c4ec88756b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_cb75b5ac-9fd9-4755-8d7b-912d3652a7ec</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_586bae59-f3f8-4613-8938-1939344ccfde" name="统稿形成规划初稿">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="统稿人合并各章并编写摘要，统一术语、数据和表述风格。做一致性检查：问题与任务对应、目标与指标对应、任务与保障对应，各章引用的产品和技术名称一致，指标数值与口径说明一致。删除与规划层级不符的过细内容（如具体项目），形成规划初稿。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="输入" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="输入" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="输入" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="输入" value="规划重点任务清单" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输出" value="科技发展规划初稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_cb75b5ac-9fd9-4755-8d7b-912d3652a7ec</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_773da78c-2090-4afc-9742-6506cd6db93a</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_3030913f-aa0b-4f1c-be6b-3eb30185f539" name="科技发展规划规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="用规划文本模板建立“03-科技规划文本”模块（前缀TPDT）并导入初稿，章节为标题对象，正文按“一个对象一个要点”拆分，专栏表格每行一个对象。重点任务对象填写“任务编号”“牵头单位”“计划节点”属性，供年度分解和实施评估使用。导入后核对对象层级与章节是否一致。" />
          <b2g:property name="输入" value="科技发展规划初稿" />
          <b2g:property name="输入" value="规划重点任务清单" />
          <b2g:property name="输入" value="DOORS模块模板与链接模块" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_773da78c-2090-4afc-9742-6506cd6db93a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_6d13926f-34a6-4cd9-917c-d173fdb6992b</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_5f7f5f17-e602-415f-b866-a16961d0acc1" name="创建科技发展规划与科技发展规划大纲的追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按大纲与规划章节对应表，从规划对象向大纲对象创建“承接”链接，一个规划对象可以链接多个大纲条目。摘要和过渡性段落的“条目类型”设为说明，可以不建链。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="科技规划大纲基线" />
          <b2g:property name="输入" value="大纲与规划章节对应表" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6d13926f-34a6-4cd9-917c-d173fdb6992b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_65890d93-c4ac-4e56-9447-b4cafbddf3ad</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_5d6e6e12-bfd8-4845-a88c-2a82cbbd574a">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_65890d93-c4ac-4e56-9447-b4cafbddf3ad</bpmn2:incoming>
      <bpmn2:incoming>EBPM_c9d127bd-1cca-42d6-b6a6-8607e042872d</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_204c6495-a959-4c79-9548-6f0a1b94cb6a</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_2e69411e-b710-4059-adcd-94a8cace4421" name="开展大纲承接性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="在DOORS中用覆盖缺口视图检查：大纲模块中没有任何规划入链的要点（大纲要点未被承接），以及规划模块中没有出链的要点（规划新增内容）。对未承接的大纲要点提出处理建议（补充规划内容或说明不承接理由），对规划新增内容确认其合理性。再用分析向导生成“需求—大纲—规划”两级追溯视图，检查关键需求是否最终落到规划要点上。" />
          <b2g:property name="输入" value="规划至大纲追溯链接" />
          <b2g:property name="输入" value="大纲至需求追溯链接" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输出" value="《大纲承接性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_204c6495-a959-4c79-9548-6f0a1b94cb6a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_16889404-3ab7-4ce6-ac2f-ded00df4d1bb</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_193759d7-6b74-4af3-a2aa-3c285577e6d8" name="大纲条目是否全部承接？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="判定标准：大纲要点全部有规划入链或已记录经确认的不承接理由，关键需求经两级链接都能追溯到规划要点，规划新增的实质性内容均已确认。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_16889404-3ab7-4ce6-ac2f-ded00df4d1bb</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f179660d-65c3-4fe7-96e3-909110fab726</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_6f14c979-c6be-4774-8f91-68ca9f8401a5</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_9fec1eb6-911f-4d4e-bea4-17e035a7f1c4" name="补充调整规划条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="根据大纲承接性分析报告，在DOORS规划模块中补充或修改规划内容并补建链接，对不承接的大纲要点在其“处理说明”中记录理由。调整后重新开展承接性分析。" />
          <b2g:property name="输入" value="《大纲承接性分析报告》" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6f14c979-c6be-4774-8f91-68ca9f8401a5</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c9d127bd-1cca-42d6-b6a6-8607e042872d</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_9c00dfbe-4b30-421d-ae3c-70d715fd1a25" name="发布科技发展规划基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="用基线集对需求、大纲、规划三类模块同时建立基线，规划模块为0.1（后缀“征求意见稿”），并从基线导出征求意见稿文本。此后的修订都在当前版本上进行，可以随时与该基线比较，得到修订对照。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="《大纲承接性分析报告》" />
          <b2g:property name="输出" value="科技发展规划征求意见稿基线" />
          <b2g:property name="输出" value="科技发展规划征求意见稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f179660d-65c3-4fe7-96e3-909110fab726</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_de1cfb85-8168-4da0-a079-f0e07227be12</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_b511ad3b-fb38-4496-8273-7ef46c8271c6" name="进行科技发展规划修订意见征集">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="工作组通过OA发出征求意见通知并附征求意见稿，向公司各部门、分子公司和外部专家征求意见。意见表包含对象标识（征求意见稿导出时保留）、原文、修改建议和理由，要求每条意见对应到具体对象，便于导入DOORS逐条处理。" />
          <b2g:property name="输入" value="科技发展规划征求意见稿" />
          <b2g:property name="输出" value="修订意见征集通知" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_de1cfb85-8168-4da0-a079-f0e07227be12</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_27801037-4a46-4f3d-8454-6e5214a8d126</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_b9cdc84c-f748-4969-ae02-9d2c9e512f7b" name="提出科技发展规划修订意见">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="各单位和专家按意见表格式反馈修订意见并说明理由。涉及指标调整的提供测算依据，涉及新增任务的说明所依据的需求或问题。" />
          <b2g:property name="输入" value="修订意见征集通知" />
          <b2g:property name="输入" value="科技发展规划征求意见稿" />
          <b2g:property name="输出" value="科技发展规划修订意见" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
          <b2g:property name="责任主体" value="相关职能部门" />
          <b2g:property name="责任主体" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_27801037-4a46-4f3d-8454-6e5214a8d126</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_fb3d93b7-d043-46a6-bec2-2304ec278acb</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_e8bbc302-214b-4d5d-a0d5-f4cf40bc63e3">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_fb3d93b7-d043-46a6-bec2-2304ec278acb</bpmn2:incoming>
      <bpmn2:incoming>EBPM_4b3a9933-45e3-44e6-ba5a-0ace8e69040d</bpmn2:incoming>
      <bpmn2:incoming>EBPM_221abde2-126c-4ddb-8fa6-75fb14249f82</bpmn2:incoming>
      <bpmn2:incoming>EBPM_b38dda79-6176-46a9-97a2-d6205eb75ef3</bpmn2:incoming>
      <bpmn2:incoming>EBPM_2049ab58-f639-4094-afde-41ff718ad2a6</bpmn2:incoming>
      <bpmn2:incoming>EBPM_d4232fbb-c6b0-4a17-97fe-5b412439df4a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_02cd11b5-8e20-46e1-82f6-157727ae0b00</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_0318f475-e016-4c5b-b70c-65d8b1942604" name="修订意见导入DOORS并关联被修订对象">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="把征求意见、各级评审意见、审议意见和规划修编需求导入“07-修订意见”模块，每条意见一个对象，填写“意见来源”“提出单位”“意见轮次”属性，并按意见表中的对象标识建立指向规划对象的“针对”链接。不能对应到具体对象的总体性意见，链接到相应章节标题。" />
          <b2g:property name="输入" value="科技发展规划修订意见" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输入" value="党委会前置研究意见" />
          <b2g:property name="输入" value="总经理办公会审议意见" />
          <b2g:property name="输入" value="规划修编需求" />
          <b2g:property name="输出" value="修订意见DOORS模块" />
          <b2g:property name="输出" value="意见至规划追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_02cd11b5-8e20-46e1-82f6-157727ae0b00</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_cd490eb4-de5d-475b-bc58-a5a025c46c25</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_875d6e1d-2da4-4a6c-a059-d6900471e95f" name="逐条形成修订意见处理结论">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="工作组逐条讨论意见，在“处理结论”属性中填写采纳、部分采纳或不采纳，在“处理说明”中写明修改方式或不采纳理由。涉及目标、指标或重点方向调整的意见，提交分管领导确定。从DOORS导出意见视图作为修订意见处理表，用于修订和后续评审的说明材料。" />
          <b2g:property name="输入" value="修订意见DOORS模块" />
          <b2g:property name="输入" value="意见至规划追溯链接" />
          <b2g:property name="输出" value="修订意见处理表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_cd490eb4-de5d-475b-bc58-a5a025c46c25</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_ea646e14-56bb-42d1-b86e-69d78530d428</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_4d9e11d1-7c05-4ac0-b8d5-a7e48d461e25" name="修订规划文本并更新DOORS模块">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="按修订意见处理表直接在DOORS规划模块中修改对象，新增对象按规范设置属性，删除采用软删除并保留历史。改动较大的章节可以在DOORS外修改后对照更新，保证DOORS模块始终是规划文本的唯一权威版本。修订后与上一基线比较，导出修订对照表。" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="规划修订对照表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ea646e14-56bb-42d1-b86e-69d78530d428</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_105526d0-471a-431e-9f32-0b75bb524cc2</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_bd32e962-6fd4-436a-81bd-6cdd9e211adf" name="处理疑似链接并复核追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="规划或大纲对象修改后，相关链接会被标为疑似链接。逐条查看疑似链接，确认链接关系是否仍然成立：成立的清除疑似标记，不成立的删除或改建。为新增对象补建“承接”链接，必要时重新开展大纲承接性分析。修订涉及大纲调整的，同步更新大纲模块并建立大纲1.1基线。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="规划修订对照表" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="输出" value="追溯关系复核记录" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_105526d0-471a-431e-9f32-0b75bb524cc2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f55f86f3-f841-4d13-a033-49f9b98dbc4e</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_78ea8cb8-7de7-4b1c-8c72-d373d4113913" name="组织进行一级评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="工作组组织专家组（内部专家，必要时邀请外部专家）评审规划修订稿。评审重点：形势判断是否准确、目标指标是否合理可达、技术和产品方向是否正确、任务能否落地、与上位规划和公司发展规划是否衔接。评审材料包括规划修订稿、修订意见处理表和追溯关系复核记录。形成一级评审意见。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="追溯关系复核记录" />
          <b2g:property name="输出" value="一级评审意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f55f86f3-f841-4d13-a033-49f9b98dbc4e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_01985d6c-f05b-4c58-9306-af6ba88351ae</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_3a8f3a80-b91e-4fc6-81a8-c0f30c01baea" name="一级评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="判定标准：专家组结论为“通过”的进入二级评审。结论为“修改后通过”且只有文字性意见的，由工作组确认修改到位后视为通过。结论为“不通过”或存在方向性意见的，评审意见导入DOORS逐条处理，修订后重新评审。" />
          <b2g:property name="责任主体" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_01985d6c-f05b-4c58-9306-af6ba88351ae</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_fb8d082f-3df8-429e-a579-d140ba17c8c6</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_4b3a9933-45e3-44e6-ba5a-0ace8e69040d</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_caea35f1-02dc-415a-ae90-965fdb82e993" name="组织进行二级评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="工作组提请公司技术委员会评审，发挥其对科技战略、技术路线和重大事项的决策支撑作用。评审重点：规划与公司战略的一致性、重大方向和资源投入的合理性、主要指标的可行性、跨部门任务的责任分工。形成二级评审意见。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输出" value="二级评审意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_fb8d082f-3df8-429e-a579-d140ba17c8c6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_1ad4489a-b37b-4b9b-a936-0e23eb78fda8</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_3e30d357-0f76-4982-910d-19519796c65b" name="二级评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="判定标准：技术委员会结论为“通过”的进入上会准备。提出修改意见的，评审意见导入DOORS逐条处理，修订后视修改程度决定是否重新经过一级评审。" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_1ad4489a-b37b-4b9b-a936-0e23eb78fda8</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c324675c-02f6-40d9-8a7d-3efad02efcbf</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_221abde2-126c-4ddb-8fa6-75fb14249f82</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_d5bbbde9-89d9-44c4-8e78-096f93991f46" name="发布科技发展规划送审稿基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="二级评审通过后，用基线集对需求、大纲、规划和修订意见模块同时建立基线，规划模块为0.2（后缀“送审稿”，审议后再次修订的依次为0.3、0.4），保证提交审议的版本及其意见处理过程可追溯。从基线导出送审稿文本用于上会。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输出" value="科技发展规划送审稿基线" />
          <b2g:property name="输出" value="科技发展规划送审稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c324675c-02f6-40d9-8a7d-3efad02efcbf</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_1c9c74ee-2c83-4e3e-b6a2-ab245867afaa</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_1d7c9bce-4831-4a8d-8fcf-81755d0b6868" name="编写科技发展规划上会议案">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="按公司议案格式编写上会议案，内容包括编制背景和依据、编制过程（需求收集范围、征求意见和评审情况）、规划主要内容（目标、指标、重点任务）、需要会议决策的事项（如重大投入、组织调整）以及意见处理情况。" />
          <b2g:property name="输入" value="科技发展规划送审稿" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输出" value="科技发展规划上会议案" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_1c9c74ee-2c83-4e3e-b6a2-ab245867afaa</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_fe24b2eb-8c54-496f-adfe-c7436239e8b2</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_14b45ea8-3f11-4b00-8518-42d926f15b9a" name="提交党委会前置研究">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="按“三重一大”决策程序，工作组把规划上会议案提交公司党委会前置研究，重点把关规划的方向和与公司战略的一致性，形成前置研究意见。" />
          <b2g:property name="输入" value="科技发展规划上会议案" />
          <b2g:property name="输入" value="科技发展规划送审稿" />
          <b2g:property name="输出" value="党委会前置研究意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="公司党委会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_fe24b2eb-8c54-496f-adfe-c7436239e8b2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_eac8dd65-079e-4dc3-9551-5ea4b1ac24d0</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_2503f7b4-a1dc-4efd-8765-7dba29020b82" name="党委会是否同意提交审议？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="判定标准：前置研究意见为同意提交审议的，进入总经理办公会审议。提出修改要求的，退回修订评审子流程逐条处理，修订后按修改程度决定是否重新评审。" />
          <b2g:property name="责任主体" value="公司党委会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_eac8dd65-079e-4dc3-9551-5ea4b1ac24d0</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_57c5a2bd-6259-4bd1-b014-640743aa03ea</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_b38dda79-6176-46a9-97a2-d6205eb75ef3</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_76b67356-3851-40e6-8e76-b60d8919bc23" name="提交总经理办公会审议">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="工作组把规划上会议案提交总经理办公会审议，重点审议目标指标、重点任务、资源投入和责任分工，形成审议决定或会议纪要。" />
          <b2g:property name="输入" value="科技发展规划上会议案" />
          <b2g:property name="输入" value="党委会前置研究意见" />
          <b2g:property name="输出" value="总经理办公会审议意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="总经理办公会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_57c5a2bd-6259-4bd1-b014-640743aa03ea</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_0cc153d3-522f-4b18-8123-0ceb89c72716</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_b08d12a0-e887-4f5f-9a10-44d5d5aa768b" name="总经理办公会是否审议通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="判定标准：审议通过或只有文字性修改要求的，进入印发。提出实质性修改要求的，退回修订评审子流程逐条处理。" />
          <b2g:property name="责任主体" value="总经理办公会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_0cc153d3-522f-4b18-8123-0ceb89c72716</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_2bdb9d3e-1631-4976-9f88-713d8a0b7298</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_2049ab58-f639-4094-afde-41ff718ad2a6</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_26dff771-92a8-4dde-9d94-b904b40cd97c" name="印发科技发展规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="根据审议意见完成最后的文字修改（如有，同步更新DOORS模块），按公司公文程序通过OA正式印发规划。" />
          <b2g:property name="输入" value="总经理办公会审议意见" />
          <b2g:property name="输入" value="科技发展规划送审稿" />
          <b2g:property name="输出" value="科技发展规划正式印发文件" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_2bdb9d3e-1631-4976-9f88-713d8a0b7298</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_aed85f44-c1a2-4580-adff-923a7cf458f6</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_414d0e82-ce5d-4054-aa7a-cfe47b299855" name="发布科技发展规划正式基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="用基线集对需求、大纲、规划和修订意见模块同时建立正式基线，规划模块为1.0（滚动修编后为2.0，勘误为1.1），内容与印发文本一致。正式基线是年度科研指南建链和实施评估的唯一依据，规划模块随即转为只读，此后对规划的任何修改都须走滚动修编程序。" />
          <b2g:property name="输入" value="科技发展规划正式印发文件" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="科技发展规划正式基线" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_aed85f44-c1a2-4580-adff-923a7cf458f6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a8810e85-0595-47f0-a3db-c32650d58f7b</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_f96802dd-0d0e-45d6-a2b0-5a0367bffb30" name="开展规划宣贯与任务分解">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="面向各部门、分子公司和研发人员开展规划宣贯。把规划重点任务清单分解到年度，按三阶段安排明确每年应启动和应完成的任务、牵头单位、协同单位和成果节点，形成规划任务分解表，纳入公司规划实施体系和年度调度。任务分解表同时是实施评估中“规划任务完成情况”的对照基准。" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="规划重点任务清单" />
          <b2g:property name="输出" value="规划任务分解表" />
          <b2g:property name="输出" value="规划宣贯材料" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a8810e85-0595-47f0-a3db-c32650d58f7b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_536503d8-be98-453f-931f-74e714cf0848</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_36cb65cc-2178-4efe-bc2b-8202287ef6d0">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_536503d8-be98-453f-931f-74e714cf0848</bpmn2:incoming>
      <bpmn2:incoming>EBPM_73f6bf2a-5e28-4250-b4b6-ae588e702ed6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_328cdbc0-5411-4e1f-a003-9cb6c1d4234e</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_728a4b0c-20b7-4d79-97c1-b201fd804f9a" name="启动年度科研指南编制">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="每年按科研计划工作安排（一般在上一年第四季度）启动下一年度科研指南编制，通过OA发出编制通知，明确指南年度、编制节点和项目需求申报要求。首年依据新发布的规划启动，以后各年同时依据上年度规划实施评估结论。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="公司科研管理制度" />
          <b2g:property name="输出" value="年度科研指南编制通知" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_328cdbc0-5411-4e1f-a003-9cb6c1d4234e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_fa5aea75-133b-46dc-82dc-92636723234c</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_df501090-3f1e-4052-9b11-26135294249e">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_fa5aea75-133b-46dc-82dc-92636723234c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_aa4c8b6f-562a-4179-b5e7-c76fd6a8bf7a</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_042627dd-28f4-4473-a123-3bb0ea90219b</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_51e83a59-2c58-433e-b74d-c136a4b32ad7" name="分解规划年度任务">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="依据规划任务分解表和实施阶段安排，结合实施评估反映的任务进展和在研项目情况，确定本年度应通过科研项目启动或延续的规划任务，形成规划年度任务清单。已完成或已决定退出的任务不再安排，基础和前沿研究按三至五年稳定支持的原则安排延续，工程开发任务按产品节点安排。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="《规划实施评估报告》" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输出" value="规划年度任务清单" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_aa4c8b6f-562a-4179-b5e7-c76fd6a8bf7a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c83eadc7-3ee1-4ec5-bef5-032f0e0f4c5f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_0eb92faa-296b-410e-ac06-8b1a47cf0eca" name="收集年度科研项目需求">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="各单位按通知申报年度科研项目需求，说明需求来源（规划任务、产品开发、现场问题、用户需求）、研究内容、预期成果和资源需求，使自上而下的规划部署与现场需求反馈相结合。" />
          <b2g:property name="输入" value="年度科研指南编制通知" />
          <b2g:property name="输入" value="业务单位科技需求反馈" />
          <b2g:property name="输出" value="年度科研项目需求汇总表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_042627dd-28f4-4473-a123-3bb0ea90219b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_71b73e9e-e71a-4306-817f-3444839fc16c</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_ded360b4-7789-40a0-8707-6fa3ced874a1">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c83eadc7-3ee1-4ec5-bef5-032f0e0f4c5f</bpmn2:incoming>
      <bpmn2:incoming>EBPM_71b73e9e-e71a-4306-817f-3444839fc16c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_1bc769fc-05ef-44e0-a903-fd67c8e6926f</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_0403e40e-ca6e-4fec-8773-45e4a6bf5e61" name="确定年度指南方向与项目分类">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="综合规划年度任务清单、年度项目需求和实施评估提出的调整建议，确定本年度指南支持方向，并按基础研究、共性技术、工程开发、成果转化分类，各类采用不同的支持方式和评价要求。结合年度科技投入预算确定各方向规模，保证基础研究及应用基础研究投入占比满足规划指标。" />
          <b2g:property name="输入" value="规划年度任务清单" />
          <b2g:property name="输入" value="年度科研项目需求汇总表" />
          <b2g:property name="输入" value="规划实施评估调整建议" />
          <b2g:property name="输入" value="年度科技投入预算" />
          <b2g:property name="输出" value="年度指南方向及项目分类表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_1bc769fc-05ef-44e0-a903-fd67c8e6926f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d0ce451f-9019-43e7-b89f-42d8660eac91</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_3666f31e-7c6f-4b5b-ac3b-f46f7357540b" name="编制科研项目指南">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按方向编写指南条目，每个条目包括研究目标、已有成果、研究增量、建议承接主体、资源需求、预期成果与验收要求（含技术成熟度要求）以及依据的规划对象标识。条目要同步明确工程承接与应用场景，避免低水平重复投入。" />
          <b2g:property name="输入" value="年度指南方向及项目分类表" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输出" value="科研项目指南初稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d0ce451f-9019-43e7-b89f-42d8660eac91</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_4b70690b-d081-4246-bc3e-ea60cafb8f8f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_8b9f93e4-ea0a-496f-b9ce-fb43a709bffe" name="科研项目指南规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="用指南模板在“04-科研项目指南”下建立当年度模块并导入，研究方向为标题对象，指南条目为要点对象，填写“研究方向”“项目类别”“成熟度要求”“建议承接主体”“指南年度”属性，规划依据标识暂存在“依据标识”属性中。" />
          <b2g:property name="输入" value="科研项目指南初稿" />
          <b2g:property name="输入" value="DOORS模块模板与链接模块" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_4b70690b-d081-4246-bc3e-ea60cafb8f8f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_59bbf616-ffae-4ac1-aecf-4b9452d9f020</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_9c43defa-b478-4595-a6dc-4f8dc1e125df" name="创建科研项目指南与科技发展规划的追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按“依据标识”从指南对象向规划正式基线中的对象创建“落实”链接，核对后清空“依据标识”属性。" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输入" value="科技发展规划正式基线" />
          <b2g:property name="输出" value="指南至规划追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_59bbf616-ffae-4ac1-aecf-4b9452d9f020</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_64983edf-13db-4474-8a85-bfe01d24b141</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_c5648d7b-4da4-4825-af02-bb9a51ac6f18">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_64983edf-13db-4474-8a85-bfe01d24b141</bpmn2:incoming>
      <bpmn2:incoming>EBPM_5735b812-9a01-4efd-9c60-4e3128f9101d</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f9ede124-2901-4589-9237-e7a187dc0434</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_1e185356-3a66-47be-a3fe-e679bd717267" name="开展规划承接与重复性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="在DOORS中检查三项内容。一是指南条目是否都有规划依据，没有依据的须在“处理说明”中写明来源（如现场紧急问题）。二是规划年度任务清单中本年应启动的任务是否都被指南覆盖，可在规划模块的追溯视图中统计各重点任务被历年指南落实的情况。三是与在研项目和历年指南模块对比，排除重复立项。" />
          <b2g:property name="输入" value="指南至规划追溯链接" />
          <b2g:property name="输入" value="规划年度任务清单" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输出" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f9ede124-2901-4589-9237-e7a187dc0434</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d716b9da-da3e-4c36-b30c-80f4bf9d7ee8</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_bf522a0d-3767-4a37-a4cd-3699f2800798" name="指南条目依据是否充分？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="判定标准：指南条目都有规划依据或经认可的来源说明，本年应启动的规划任务都已覆盖或有推迟理由，与在研项目和历年指南无重复。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d716b9da-da3e-4c36-b30c-80f4bf9d7ee8</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_624085b3-ace6-4cb1-9d4b-0b1336713a60</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_3b709de6-692d-4dac-bee8-400b698018ea</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_7f678f83-9f6a-417f-a86c-2cb241c919fa" name="调整指南条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="补充、修改或删除指南条目并补建链接，对推迟的规划任务记录理由并在下一年度优先考虑。调整后重新开展承接与重复性分析。" />
          <b2g:property name="输入" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="指南至规划追溯链接" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3b709de6-692d-4dac-bee8-400b698018ea</bpmn2:incoming>

    <bpmn2:manualTask id="EBPM_f4fb71f7-a7c4-419a-a838-8196079fe90b" name="审定规划实施评估报告">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="年度评估报告经工作组审核后报分管领导审定，中期评估和总结评估报告提请技术委员会审议。审定后的结论与年度任务、预算、平台、人才和考核衔接。" />
          <b2g:property name="输入" value="《规划实施评估报告》" />
          <b2g:property name="输出" value="评估报告审定意见" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="参与方" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_fd230cbf-522c-404e-b8fc-d545f4fe573f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f1af19ee-f27c-4b1b-8205-32f208ee0458</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_1a8cb0a8-93d7-489c-8c69-f2ee605411b2" name="发布规划实施评估基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="用基线集对“05-科研项目台账”和“06-规划实施评估”模块同时建立基线，后缀写明评估年度和类型（如“2027年度评估”“中期评估”），保留各期评估的历史快照。" />
          <b2g:property name="输入" value="规划实施评估DOORS模块" />
          <b2g:property name="输入" value="科研项目台账DOORS模块" />
          <b2g:property name="输入" value="评估报告审定意见" />
          <b2g:property name="输出" value="规划实施评估基线" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f1af19ee-f27c-4b1b-8205-32f208ee0458</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_80c7d7c2-8ef3-4485-9071-1b130f1610f8</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_c42107e0-6e86-49ad-ba5b-3fa14d653eef" name="是否为规划期总结评估？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="判定标准：本次评估类型为总结评估（规划期最后一年）的，本规划周期收官。年度评估和中期评估进入修编判断。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_80c7d7c2-8ef3-4485-9071-1b130f1610f8</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c965faa4-8562-4451-8ae9-62921789f925</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_b05bc3e2-7b42-423c-94de-6c6bf15b203d</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="EBPM_e357210d-f787-4fa4-a26a-410a6b8abc18" name="是否需要滚动修编规划？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划实施评估" />
          <b2g:property name="步骤描述" value="判定标准：上位部署、市场或公司发展规划发生重大变化，或中期评估认为目标、重点方向需要调整时，启动滚动修编，形成规划修编需求，进入修订评审子流程，修编后的正式版基线为2.0。只涉及个别任务调整的，通过下一年度指南调整处理，不修编规划。" />
          <b2g:property name="输出" value="规划修编需求" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b05bc3e2-7b42-423c-94de-6c6bf15b203d</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d4232fbb-c6b0-4a17-97fe-5b412439df4a</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_73f6bf2a-5e28-4250-b4b6-ae588e702ed6</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

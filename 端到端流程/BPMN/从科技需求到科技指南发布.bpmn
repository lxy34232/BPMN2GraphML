          <b2g:property name="步骤描述" value="各单位和专家对指南方向、条目内容、承接主体和验收要求提出意见并说明理由。" />
          <b2g:property name="输入" value="科研指南意见征集通知" />
          <b2g:property name="输入" value="科研项目指南征求意见稿" />
          <b2g:property name="输出" value="科研指南修订意见" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
          <b2g:property name="责任主体" value="专家组" />

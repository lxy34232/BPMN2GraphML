    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_e6c4352e-6d12-4e06-bc88-77717e31c12a">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_20640539-cc72-424a-990f-6bcf6eb48e31</bpmn2:incoming>

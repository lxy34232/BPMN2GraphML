    <bpmn2:userTask id="EBPM_60cdf3d3-c788-4ea2-91fe-286b8294e6db" name="指南修订意见导入DOORS并形成处理结论">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="把征集意见和评审意见导入“07-修订意见”模块，建立指向指南对象的“针对”链接，逐条填写处理结论（采纳、部分采纳、不采纳）和处理说明，导出指南意见处理表。" />
          <b2g:property name="输入" value="科研指南修订意见" />
          <b2g:property name="输入" value="科研指南评审意见" />
          <b2g:property name="输出" value="修订意见DOORS模块" />
          <b2g:property name="输出" value="指南意见处理表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_aba1bb61-3100-4fbe-a060-4f4a1dffb84e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d965e619-641f-4260-a6f0-229f32798ae1</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_4598c613-18e1-407a-9132-68d53be0876d" name="修订科研项目指南并更新DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按指南意见处理表在DOORS指南模块中修订条目，处理疑似链接，复核规划承接关系。" />
          <b2g:property name="输入" value="指南意见处理表" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />

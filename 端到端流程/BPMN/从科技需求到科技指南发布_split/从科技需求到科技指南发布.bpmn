    <bpmn2:userTask id="EBPM_daf1ee7d-2500-4ea6-8c8e-5e12fd7add92" name="修订科研项目指南并更新DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="逐条处理征集意见和评审意见（采纳、部分采纳、不采纳并说明理由），在DOORS指南模块中修订条目，处理疑似链接，复核规划承接关系。" />
          <b2g:property name="输入" value="科研指南修订意见" />
          <b2g:property name="输入" value="科研指南评审意见" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="指南意见处理表" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_85877e0b-0f91-4b9d-85d3-017d067f8713</bpmn2:incoming>

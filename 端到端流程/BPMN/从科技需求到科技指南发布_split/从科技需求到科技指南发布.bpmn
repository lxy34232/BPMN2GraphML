    <bpmn2:manualTask id="EBPM_42202cc7-0f50-422e-9b13-8e7f2d37de5e" name="组织科研指南评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="提交技术委员会评审，重点评审指南方向与规划的一致性、项目分类和资源安排的合理性、条目目标和验收要求是否明确。" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输入" value="指南意见处理表" />
          <b2g:property name="输入" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="输出" value="科研指南评审意见" />
          <b2g:property name="责任主体" value="技术委员会" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_0e38960c-7401-4bd7-a973-fa01b523edc2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_2c5d5bf5-995e-473f-9525-2c4f59422a49</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_f108b690-2437-4100-9708-cf31e4704594" name="科研指南评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="判定标准：技术委员会结论为通过的进入发布。提出修改意见的，退回修订后重新评审，只有文字性意见的由科技管理部门确认后视为通过。" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_2c5d5bf5-995e-473f-9525-2c4f59422a49</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c31499b0-6815-42dc-88a9-165693b08e20</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_5fe6f213-a561-48f9-9836-6542971b8e83</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_ef1a9be6-8b40-4611-be57-09edf24d3ad9" name="科研项目指南发布">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按公司程序审批后通过OA发布年度科研项目指南，作为当年科研项目申报和立项评审的依据。" />
          <b2g:property name="输入" value="科研指南评审意见" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南正式发布文件" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c31499b0-6815-42dc-88a9-165693b08e20</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_ccd1f14d-aeb8-4065-a8bd-ceea63646289</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_f87be7e6-16a2-48c2-8554-971e0a924c64" name="发布科研项目指南正式基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="对年度指南模块创建基线“年度V1.0”（正式版），内容与发布文本一致。后续科研项目立项可以链接到指南条目，实现从需求到项目的全链路追溯。" />
          <b2g:property name="输入" value="科研项目指南正式发布文件" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="科研项目指南基线V1.0（正式版）" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ccd1f14d-aeb8-4065-a8bd-ceea63646289</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f79240de-06b6-466d-ab6b-2638607bad63</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_41424496-ef0c-45d6-a41b-9cd7cbc6567f" name="规划期是否结束？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="判定标准：已发布规划期最后一个年度的科研指南即为结束，转入规划总结评估和下一周期规划编制。否则进入年度实施评估，在下一年度继续编制指南。" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f79240de-06b6-466d-ab6b-2638607bad63</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_bbc17b91-5d0f-4e9b-970c-d60426a98a11</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_d8d7e88b-5f52-4ceb-b293-b7fce56247e2</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_fe41810f-b7dc-429d-a9e8-b6d7afb22b43" name="开展规划年度实施评估">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="年底对照规划任务分解表和主要指标，评估年度目标、任务、里程碑和成果的完成情况，统计指南条目的立项和承接情况（可通过DOORS链接统计各规划任务被指南承接的情况），分析重大偏差的技术、资源和组织原因，提出调整路径、加强协同或退出的建议。规划期中期同时开展中期评估。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="项目实施与验收数据" />
          <b2g:property name="输入" value="科研项目指南基线V1.0（正式版）" />
          <b2g:property name="输出" value="规划年度实施评估报告" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d8d7e88b-5f52-4ceb-b293-b7fce56247e2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_5fa861cd-4a3a-4869-98f5-5bfe2d9a92e9</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_7e9108c5-e5eb-45ec-ad0b-931832aa9c2c" name="是否需要滚动修编规划？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="判定标准：上位部署、市场或公司发展规划发生重大变化，或中期评估发现目标、重点方向需要调整时，按程序启动滚动修编，形成规划修编需求，进入修订评审子流程。只涉及个别任务调整的，通过下一年度指南调整处理，不修编规划。" />
          <b2g:property name="输出" value="规划修编需求" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_5fa861cd-4a3a-4869-98f5-5bfe2d9a92e9</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_9e011815-a344-43c2-804b-3e07fa5042a1</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_6b2e0e71-4ac8-496f-a15b-c34f20f1ceae</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="EBPM_e40bf2c4-e225-42e0-a87e-39e89f19f7c1" name="规划期科研项目指南已全部发布">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="规划期内各年度科研项目指南均已发布并建立基线，需求、大纲、规划、指南之间的追溯链完整，转入规划总结评估。" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_bbc17b91-5d0f-4e9b-970c-d60426a98a11</bpmn2:incoming>
    </bpmn2:endEvent>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:b2g="https://github.com/lxy34232/BPMN2GraphML/properties" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:process id="Process_1">
    <bpmn2:startEvent id="EBPM_412fab5c-9ea9-4e5a-a332-c3b29b36b6ff" name="科技规划编制任务已下达">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="公司启动新一轮五年科技发展规划编制，由公司领导批示或上级通知下达编制任务，明确规划周期和总体时间要求。" />
          <b2g:property name="输入" value="上级及公司规划编制要求" />
          <b2g:property name="输出" value="科技规划编制任务通知" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>EBPM_c90c3f79-3a32-4e5d-8b0a-52256a9a55c0</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:manualTask id="EBPM_4d5147ee-8beb-49fe-b819-8e4cd2179aad" name="制定科技规划编制工作方案">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="科技管理部门牵头，依据编制任务和上一周期规划，明确规划期限、编制依据、编制范围（技术、产品、体系、保障）、组织方式、工作节点（需求收集、大纲、初稿、征求意见、评审、审议、发布）和成果形式。方案中明确需求、大纲、规划文本和科研指南全部纳入DOORS结构化管理，并明确规划与年度科研指南的衔接要求。" />
          <b2g:property name="输入" value="科技规划编制任务通知" />
          <b2g:property name="输入" value="上一周期科技发展规划" />
          <b2g:property name="输入" value="公司科研管理制度" />
          <b2g:property name="输出" value="《科技规划编制工作方案》" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c90c3f79-3a32-4e5d-8b0a-52256a9a55c0</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d91f899c-a556-453f-8582-21ff38026456</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_fc083e63-6640-47d7-8d42-ef5560102add" name="组建规划编制工作组与专题组">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="成立由科技管理部门牵头、株机研究院承担技术研究与情报支撑、规划发展部及相关职能部门参与的规划编制工作组。按规划主题设置专题组（产业与产品、技术研究、科技管理体系、设计开发体系、数智化转型、知识产权与标准化、保障措施），明确各专题组的牵头人、成员、负责章节和交付节点，并指定DOORS数据管理员。" />
          <b2g:property name="输入" value="《科技规划编制工作方案》" />
          <b2g:property name="输出" value="规划编制工作组及专题组名单" />
          <b2g:property name="输出" value="专题分工表" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
          <b2g:property name="责任主体" value="规划发展部" />
          <b2g:property name="责任主体" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d91f899c-a556-453f-8582-21ff38026456</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e599343d-33d9-4418-b031-cafa743e88b5</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_3b911e99-331a-4e27-9ef2-e9f341c6e150" name="制定DOORS规划数据管理规范">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技规划编制策划" />
          <b2g:property name="步骤描述" value="明确规划数据在DOORS中的组织方式，作为后续规范性导入、建链和基线管理的统一依据。一是模块分层，01-政策文本、02-科技规划大纲、03-科技规划文本、04-科研项目指南。二是对象标识前缀，每个模块使用唯一前缀（如CGDP国家规划纲要、CRRC集团科技规划、ZELC公司文件、TPLP大纲、TPDT规划文本）。三是对象拆分规则，一个对象表达一条完整要求，标题对象保留原文章节层级。四是属性定义，如“科技规划相关”“备注”主题标签及其取值表。五是链接规则，链接统一从下游指向上游（大纲指向需求、规划指向大纲、指南指向规划），使用统一链接模块。六是基线命名，需求V1.0、大纲V1.0、规划V0.1征求意见稿、V0.9评审稿、V1.0正式版（滚动修编后为V1.x）、年度指南V0.1征求意见稿和V1.0正式版。" />
          <b2g:property name="输入" value="《科技规划编制工作方案》" />
          <b2g:property name="输出" value="《DOORS规划数据管理规范》" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e599343d-33d9-4418-b031-cafa743e88b5</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d2095945-531e-43d3-a69e-6016b5127017</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:parallelGateway id="EBPM_dd603d0d-5aeb-4829-adce-5d6f4eeed0da">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d2095945-531e-43d3-a69e-6016b5127017</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_0fa2dce2-1516-48fc-88c6-c8ce1ea1ea61</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_8366f070-d88a-4e96-95b9-5e572efa692a</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_565b96e5-2f8d-47a2-acc1-c461229b9de0</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_ba53fc41-055f-4170-b327-e2993fd45b33</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_3a729c21-6102-4bdd-9146-bddfe92167aa</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_6d98405a-c7d6-493a-9808-b3f123e4bad7</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_c600aa17-7fd7-48a7-89d8-35f60b040357" name="收集国家及行业政策规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="收集与公司业务相关的国家和行业上位规划，如国民经济和社会发展五年规划纲要、国家科技创新规划、铁路科技创新五年规划、城市轨道交通智慧城轨发展纲要，以及交通强国、能源和新兴产业专项规划。登记发布单位、发布日期和版本，优先使用正式发布稿，暂用征求意见稿的须标注，正式稿发布后替换。" />
          <b2g:property name="输入" value="国家及行业政策规划原文" />
          <b2g:property name="输出" value="国家及行业政策规划文件集" />
          <b2g:property name="责任主体" value="株机研究院" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_0fa2dce2-1516-48fc-88c6-c8ce1ea1ea61</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_df47efd0-a632-4e84-89fc-acb85095fc49</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_05990570-3d84-48bf-a902-aec202404504" name="收集集团战略与科技规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="收集集团层面的发展战略纲要、科技发展规划、数智化转型方案和相关专项规划，重点识别对子公司的承接要求，如“一鼎两环三支撑”大创新体系、“1+M+N+X”规划体系、“双赛道双集群”产业布局和集团考核指标。" />
          <b2g:property name="输入" value="集团战略与科技规划原文" />
          <b2g:property name="输出" value="集团战略与科技规划文件集" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="规划发展部" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8366f070-d88a-4e96-95b9-5e572efa692a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e85d66af-b1fe-4162-ba73-b7be9e67e1e7</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_f59a3965-e8b4-4d08-a294-366c63d14449" name="收集公司战略部署与领导讲话">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="收集公司党代会报告、战略规划务虚会和科技规划务虚会领导讲话、公司五年发展规划等文件，提炼公司中心任务（如建设“新质株机”）、战略工程和对科技创新的明确要求。领导讲话中的定性要求和公司发展规划中的量化目标都要纳入。" />
          <b2g:property name="输入" value="公司党代会报告及务虚会讲话" />
          <b2g:property name="输入" value="公司五年发展规划" />
          <b2g:property name="输出" value="公司战略部署与领导讲话文件集" />
          <b2g:property name="责任主体" value="规划发展部" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_565b96e5-2f8d-47a2-acc1-c461229b9de0</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_68c1819e-3902-4f68-b9b1-5b357e9b44ac</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_694e531d-9eb2-4352-b143-ce8f08b97e6e" name="开展上一周期科技规划实施评估">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="对照上一周期科技规划的目标、指标和重点任务，逐项评估完成情况。梳理代表性成果（重大产品、关键技术、研发资源、科研体系、数智应用、成果转化），并从组织能力、技术管理、设计开发三个体系维度分析存在问题及其原因。评估结论是新规划“发展基础”和“存在问题”的直接来源。" />
          <b2g:property name="输入" value="上一周期科技发展规划" />
          <b2g:property name="输入" value="上一周期规划执行数据" />
          <b2g:property name="输出" value="《上一周期科技规划实施评估报告》" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ba53fc41-055f-4170-b327-e2993fd45b33</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c1a0f8ee-84c2-446a-aead-9d41e519be42</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_33bb74e6-3cba-447b-bfdb-db4c5dfb8f4f" name="收集业务单位与市场用户科技需求">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="向各业务单位、分子公司、营销和服务部门征集科技需求，覆盖市场与用户需求、产品竞争力短板、现场质量问题、全寿命周期服务和海外区域适配需求。按统一模板填写需求背景、期望目标、紧迫程度和关联产品，体现“需求牵引”原则。" />
          <b2g:property name="输入" value="业务单位科技需求反馈" />
          <b2g:property name="输入" value="用户与现场问题记录" />
          <b2g:property name="输出" value="业务单位与市场用户科技需求汇总表" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3a729c21-6102-4bdd-9146-bddfe92167aa</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_28f13e54-00d2-4a13-81a3-aca6b7760d47</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_d4f0e6ae-a5e0-4805-866f-942b4d842d1c" name="开展行业技术趋势与对标研究">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="株机研究院依托科技战略与情报职能，研究轨道交通装备及相关新兴产业的技术演进方向（如软件定义、域控制、全域感知、自主运行、绿色动力、源网车储协同），分析国际市场的标准认证和区域适配要求，与国内外主要竞争对手开展技术和产品对标，识别技术差距和机会窗口。" />
          <b2g:property name="输入" value="科技情报资料" />
          <b2g:property name="输入" value="竞争对手与行业标准信息" />
          <b2g:property name="输出" value="《行业技术趋势与对标研究报告》" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6d98405a-c7d6-493a-9808-b3f123e4bad7</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e0ec62f1-c736-49f8-9dd6-8642880739d8</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_9fb7b91e-ec0e-499d-bc4c-be053c820fa4">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_df47efd0-a632-4e84-89fc-acb85095fc49</bpmn2:incoming>
      <bpmn2:incoming>EBPM_e85d66af-b1fe-4162-ba73-b7be9e67e1e7</bpmn2:incoming>
      <bpmn2:incoming>EBPM_68c1819e-3902-4f68-b9b1-5b357e9b44ac</bpmn2:incoming>
      <bpmn2:incoming>EBPM_c1a0f8ee-84c2-446a-aead-9d41e519be42</bpmn2:incoming>
      <bpmn2:incoming>EBPM_28f13e54-00d2-4a13-81a3-aca6b7760d47</bpmn2:incoming>
      <bpmn2:incoming>EBPM_e0ec62f1-c736-49f8-9dd6-8642880739d8</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_3a9a538d-153b-4ba6-a157-f2bb105e3f99</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_418613c2-5b8e-4187-bae7-16ecca0de99e" name="科技规划需求文本结构化">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="按《DOORS规划数据管理规范》把收集到的文件整理成可导入的结构化文本。原文章节作为标题对象保留层级，正文拆分到“一个对象表达一条完整要求”的粒度，清除页眉页脚、目录、图表说明等无关内容，统一标点和编号格式，每份文件形成一个待导入文本并登记来源和版本。需求汇总表、实施评估报告和对标研究报告同样结构化后导入。" />
          <b2g:property name="输入" value="国家及行业政策规划文件集" />
          <b2g:property name="输入" value="集团战略与科技规划文件集" />
          <b2g:property name="输入" value="公司战略部署与领导讲话文件集" />
          <b2g:property name="输入" value="《上一周期科技规划实施评估报告》" />
          <b2g:property name="输入" value="业务单位与市场用户科技需求汇总表" />
          <b2g:property name="输入" value="《行业技术趋势与对标研究报告》" />
          <b2g:property name="输入" value="《DOORS规划数据管理规范》" />
          <b2g:property name="输出" value="结构化需求文本" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3a9a538d-153b-4ba6-a157-f2bb105e3f99</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_92b05d5a-a5a2-405b-9cd0-89432cffaf62</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_b1d8f6a8-5c6f-440d-bb2f-d3e66e0e4922">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_92b05d5a-a5a2-405b-9cd0-89432cffaf62</bpmn2:incoming>
      <bpmn2:incoming>EBPM_03364997-d675-4c9d-a95d-6d93cdd22ed7</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_9a042676-e384-4a06-9fd9-c7af359ea8e3</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_8957ce33-8c22-4479-ab11-2e7c06178134" name="科技规划需求规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="DOORS数据管理员按规范把结构化文本逐份导入“01-政策文本”文件夹，每份文件一个模块，模块名采用“序号+文件名称”，对象标识使用约定前缀。导入后检查对象层级、对象编号（如1、1-1）与原文章节是否一致，并在模块属性中记录文件来源、版本和导入日期。" />
          <b2g:property name="输入" value="结构化需求文本" />
          <b2g:property name="输入" value="《DOORS规划数据管理规范》" />
          <b2g:property name="输出" value="政策文本DOORS模块（导入稿）" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_9a042676-e384-4a06-9fd9-c7af359ea8e3</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_68c525a1-4259-4722-a2d9-7654d5f72a1b</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_c4ea2da1-d712-49cf-9980-ab228f67f5e8" name="需求导入质量是否合格？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="判定标准：抽查对象内容与原文一致，无遗漏、无乱码，标题层级与原文章节一致，对象粒度符合“一条要求一个对象”，模块命名和对象前缀符合规范。全部满足为合格，任一项不满足为不合格，记录问题后退回修正。" />
          <b2g:property name="输出" value="导入质量核查记录" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_68c525a1-4259-4722-a2d9-7654d5f72a1b</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c4842779-515d-4b2f-b2c3-a430dad8bad3</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_9619d768-2abd-41cc-967b-d348cdc3f52c</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_32b86b96-925d-499d-a341-4549402df196" name="修正结构化需求文本">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="根据导入质量核查记录定位问题，修正结构化文本的拆分粒度、层级、编号或字符问题，必要时删除DOORS中的问题模块后重新导入。" />
          <b2g:property name="输入" value="导入质量核查记录" />
          <b2g:property name="输入" value="结构化需求文本" />
          <b2g:property name="输出" value="结构化需求文本" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_9619d768-2abd-41cc-967b-d348cdc3f52c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_03364997-d675-4c9d-a95d-6d93cdd22ed7</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_8d1ef8ea-b9d5-45b7-ac4d-831a84c78fa4" name="标注需求条目规划主题并识别关键需求">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="专题组逐模块阅读政策文本，对与公司科技规划相关的对象在“科技规划相关”或“备注”属性中填写主题标签（如总体战略、科技体系、产业升级、人才队伍、战新产业、质量管理、数智转型），一个对象可以有多个标签。区分刚性要求（上级明确下达的目标、指标和任务）和指导性要求，把刚性要求和公司领导明确提出的要求标为关键需求，形成关键需求清单，作为大纲覆盖性分析的检查对象。" />
          <b2g:property name="输入" value="政策文本DOORS模块（导入稿）" />
          <b2g:property name="输入" value="专题分工表" />
          <b2g:property name="输出" value="主题标注后的政策文本DOORS模块" />
          <b2g:property name="输出" value="关键需求清单" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="株机研究院" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c4842779-515d-4b2f-b2c3-a430dad8bad3</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_6c0a4fe8-4345-47d2-b280-5c94f76629b4</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_a28c96e6-7a39-48df-bab2-203a18ec4ae4" name="发布科技规划需求基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划需求收集" />
          <b2g:property name="步骤描述" value="主题标注完成后，对“01-政策文本”下的全部模块创建基线V1.0，基线注释写明规划周期和标注完成日期，大纲链接均以该基线为准。上位文件正式稿替换征求意见稿时，更新对应模块并创建V1.x基线，同时检查受影响的链接。" />
          <b2g:property name="输入" value="主题标注后的政策文本DOORS模块" />
          <b2g:property name="输出" value="科技规划需求基线V1.0" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_6c0a4fe8-4345-47d2-b280-5c94f76629b4</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_97648b6f-8612-4fa9-a0fa-07def4e75222</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_ff45018b-6435-45e5-a3bf-3fb46331badf" name="研判需求并归纳规划主题">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="以关键需求清单和主题标签为基础，按主题汇总上级要求、公司要求、发展短板和技术趋势。对每个主题回答三个问题：上级要求做什么、公司战略要求做什么、我们现在差在哪里。把相近的需求归并成规划主题，识别需求之间的冲突和优先级，形成规划需求研判报告。" />
          <b2g:property name="输入" value="科技规划需求基线V1.0" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输入" value="《上一周期科技规划实施评估报告》" />
          <b2g:property name="输入" value="《行业技术趋势与对标研究报告》" />
          <b2g:property name="输出" value="《规划需求研判报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_97648b6f-8612-4fa9-a0fa-07def4e75222</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_ce6c4264-e290-4b0f-a690-cad70c85df79</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_8c2485d8-252c-4360-ac73-d6948760dd7f" name="确定科技规划大纲框架">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="依据研判结果确定大纲的一、二级章节，原则上承接上位科技规划的结构并对应公司战略工程。参考框架：总体要求、双赛道产业布局与提质（按机车、城轨、动车组、磁浮、产品+、维保、战新板块展开）、技术研究（根技术、软件定义产品、核心技术攻关、自主化、碳管理）、科技管理体系、设计开发体系、数智化转型、知识产权与标准化、保障措施。框架经编制工作组讨论确认后，把二级章节分配到各专题组。" />
          <b2g:property name="输入" value="《规划需求研判报告》" />
          <b2g:property name="输入" value="专题分工表" />
          <b2g:property name="输出" value="科技规划大纲框架" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ce6c4264-e290-4b0f-a690-cad70c85df79</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_862ef911-c236-43fc-a159-fbbe0fa5f912</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_5b913507-77c6-4eb7-bb61-8ec694d98d29" name="科技规划大纲制定">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="各专题组在大纲框架下编写大纲条目。每个条目提炼一个规划要点（方向、目标或任务），用一句话表述，并在条目后注明所依据需求对象的标识（如ZELC-00-162），供后续建链使用。条目要说明“为什么做”（依据）和“做什么”（要点），不展开具体实施内容。" />
          <b2g:property name="输入" value="科技规划大纲框架" />
          <b2g:property name="输入" value="主题标注后的政策文本DOORS模块" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输出" value="科技规划大纲草稿" />
          <b2g:property name="责任主体" value="各专题组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_862ef911-c236-43fc-a159-fbbe0fa5f912</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c65fe613-e5f6-460e-84de-e01a7471d4cd</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_902bef5c-8717-4260-bea5-cdd5c662f3be" name="科技规划大纲规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="把大纲草稿按规范导入“02-科技规划大纲”模块（前缀TPLP），章节为标题对象，条目为正文对象，对象编号与大纲章节对应（如1.0-1、2.2-3）。条目注明的依据标识暂存在临时属性中，供建链使用。" />
          <b2g:property name="输入" value="科技规划大纲草稿" />
          <b2g:property name="输入" value="《DOORS规划数据管理规范》" />
          <b2g:property name="输出" value="科技规划大纲DOORS模块" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_c65fe613-e5f6-460e-84de-e01a7471d4cd</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_89763372-0230-4d87-b9cb-320e5aec0603</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_18980a13-b367-4388-8f87-1bed09b1979f" name="创建科技大纲模块与科技规划需求模块追溯链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="按大纲条目注明的依据，从大纲对象向政策文本对象创建链接（大纲指向需求），一个大纲条目可以链接多个需求对象。建链后在大纲模块视图中显示“深度为1的出向链接”列，逐条核对链接目标与依据是否一致，核对完成后清除临时依据属性。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="科技规划需求基线V1.0" />
          <b2g:property name="输出" value="大纲至需求追溯链接" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_89763372-0230-4d87-b9cb-320e5aec0603</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_970d421b-fb77-475b-8a3c-eb650bbfc096</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_1f243a00-b11c-4dab-bb65-fd4ab11dac88">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_970d421b-fb77-475b-8a3c-eb650bbfc096</bpmn2:incoming>
      <bpmn2:incoming>EBPM_646309d9-4fe5-43fc-97b2-0cbdb6ef778f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_833f146b-bd6b-45be-b4c3-263768292c58</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_fa1fea59-dd6e-461a-82be-f788c495e3f8" name="开展需求覆盖性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="在DOORS中做双向追溯检查。正向检查：在政策文本模块中筛选已标注主题的对象，查看入向链接，列出没有被任何大纲条目链接的需求，关键需求清单中的对象逐条检查。反向检查：在大纲模块中筛选没有出向链接的条目，确认是否为公司自主提出的内容并补充依据说明。形成需求覆盖性分析报告，列出未覆盖需求和处理建议（补充条目、并入已有条目、说明不纳入理由）。" />
          <b2g:property name="输入" value="大纲至需求追溯链接" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输出" value="《需求覆盖性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_833f146b-bd6b-45be-b4c3-263768292c58</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_417499ab-324f-4189-893a-8aa74e662a3a</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_236b458c-3022-46bd-b025-43659ec3915e" name="关键需求是否全部覆盖？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="判定标准：关键需求清单中的对象全部有大纲入链，或有经编制工作组确认的不纳入理由。其余已标注需求的覆盖率作为参考，不作为否决条件。没有出链的大纲条目都已有依据说明。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_417499ab-324f-4189-893a-8aa74e662a3a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e3b0606e-8f50-4e7d-a0a0-1c1a74c5c557</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_5321ce9e-9dcd-410b-9bbd-815d6cd1e0b1</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_bac5fe59-3fd5-4bef-83c1-459a7dbb900d" name="组织大纲研讨审查">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="科技管理部门组织编制工作组、株机研究院和分管领导研讨大纲。审查重点：框架是否完整承接上位规划和公司战略，主题之间有无重叠或遗漏，条目方向是否清晰、能否展开为规划内容，与公司发展规划的目标是否一致。研讨结论形成大纲审查意见。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="《需求覆盖性分析报告》" />
          <b2g:property name="输出" value="大纲审查意见" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e3b0606e-8f50-4e7d-a0a0-1c1a74c5c557</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b2961b77-f850-4db4-98a5-68b82d9b8e2e</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_dcf38f76-1fa8-4d5f-889b-0d4744e895a3" name="大纲是否通过审查？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="判定标准：审查意见中没有“框架调整”或“方向性修改”类意见即为通过，文字性意见在发布基线前直接修改。存在方向性意见时退回补充调整。" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b2961b77-f850-4db4-98a5-68b82d9b8e2e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_40c17cb8-f3f8-409f-a925-d770f65674fa</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_141e1af1-5920-48e6-a92c-71e579bbb4ff</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="EBPM_7e72aa7d-4d2b-410a-b618-74922f32fddf">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_5321ce9e-9dcd-410b-9bbd-815d6cd1e0b1</bpmn2:incoming>
      <bpmn2:incoming>EBPM_141e1af1-5920-48e6-a92c-71e579bbb4ff</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f6be913c-f6b1-49ee-8a76-2df84d87152c</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_59a2f923-ef65-4cf9-aa78-86503855ddab" name="补充调整大纲条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="根据需求覆盖性分析报告或大纲审查意见，在DOORS大纲模块中新增、修改或合并条目，同步补充或调整到需求的链接。对决定不纳入的需求，在需求对象的“备注”属性中记录理由。调整后重新开展覆盖性分析。" />
          <b2g:property name="输入" value="《需求覆盖性分析报告》" />
          <b2g:property name="输入" value="大纲审查意见" />
          <b2g:property name="输出" value="科技规划大纲DOORS模块" />
          <b2g:property name="输出" value="大纲至需求追溯链接" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f6be913c-f6b1-49ee-8a76-2df84d87152c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_646309d9-4fe5-43fc-97b2-0cbdb6ef778f</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_e3813e5d-74fb-42d1-b876-5002b58a85a2" name="科技规划大纲基线发布">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划大纲制定" />
          <b2g:property name="步骤描述" value="对“02-科技规划大纲”模块创建基线V1.0，基线注释写明审查通过日期。大纲基线是规划文本编写和建链的依据，基线发布后大纲如需调整，须经编制工作组确认并创建新基线。" />
          <b2g:property name="输入" value="科技规划大纲DOORS模块" />
          <b2g:property name="输入" value="大纲审查意见" />
          <b2g:property name="输出" value="科技规划大纲基线V1.0" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_40c17cb8-f3f8-409f-a925-d770f65674fa</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_99931130-fb86-4274-a417-34dabdcf683a</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_7885b21a-c8d5-4877-b366-62ec288aa962" name="确定规划文本结构与编写分工">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="把大纲转化为规划文本的章节结构，按“形势—要求—任务—保障”的逻辑组织：摘要、发展基础与形势要求、总体要求、关键技术布局、重点产品开发、科技创新体系建设、规划实施保障。建立大纲章节与规划章节的对应表（如大纲“技术研究”对应规划“强化关键技术布局”，大纲“双赛道产业布局”对应规划“推进重点产品开发”），按对应关系把各章分配给专题组并指定统稿人，统一专栏表格的格式。" />
          <b2g:property name="输入" value="科技规划大纲基线V1.0" />
          <b2g:property name="输入" value="专题分工表" />
          <b2g:property name="输出" value="规划章节结构及编写分工表" />
          <b2g:property name="输出" value="大纲与规划章节对应表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_99931130-fb86-4274-a417-34dabdcf683a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_942f3173-531d-4a1b-ad92-cc10f45815ec</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_bab3f76c-b57c-4e1c-831b-5b1673f2f01f" name="开展形势研判与差距分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按“基础—问题—要求—趋势”四个维度编写第一章。发展基础取自上一周期实施评估的代表性成果，以专栏列出。存在问题按组织能力、技术管理、设计开发三个体系维度归纳，每个问题都要能对应到后续章节的任务。上级及公司要求按国家行业、集团、公司三个层级提炼。行业技术趋势取自对标研究报告。章末用一段话归纳本周期科技工作的总体着力点，作为总体要求的输入。" />
          <b2g:property name="输入" value="《上一周期科技规划实施评估报告》" />
          <b2g:property name="输入" value="《行业技术趋势与对标研究报告》" />
          <b2g:property name="输入" value="科技规划大纲基线V1.0" />
          <b2g:property name="输入" value="规划章节结构及编写分工表" />
          <b2g:property name="输出" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="责任主体" value="株机研究院" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_942f3173-531d-4a1b-ad92-cc10f45815ec</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_9932b73a-99ea-4d7a-91d4-067ff051e19f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_23dea94b-21aa-423a-8f5b-62903ae81db0" name="确定指导思想、基本原则与发展目标">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="编写第二章总体要求。指导思想承接上位规划的表述并落到公司中心任务。基本原则从规划需求研判中提炼（如战略牵引、需求牵引、分层协同、平台复用、开放协同与自主可控、价值导向），每条原则都应在后续任务中有所体现。发展目标先写期末总体目标，再按技术供给、产品开发、研发与工程转化、数智与服务、创新体系效能等能力维度分述，并与第一章提出的问题对应。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="《规划需求研判报告》" />
          <b2g:property name="输入" value="科技规划大纲基线V1.0" />
          <b2g:property name="输出" value="规划第二章《总体要求》稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_9932b73a-99ea-4d7a-91d4-067ff051e19f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_84f097af-ecf8-4f1e-9b60-7739ee204ade</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_7b9d592c-0b74-446b-bb2d-5c6c118c66a0" name="测算主要指标并确认统计口径">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="从上位规划的考核指标和公司发展目标中选取科技主要指标（如科技奖励、发明专利、海外专利、标准、研发投入强度、基础研究投入占比、研发人员占比、成果转化收入、高质量数据集、碳足迹核算）。每个指标以上一周期实际值和增长趋势为基础测算期末目标，区分“五年累计”与“期末值”。与人力资源、财务、知识产权等相关职能部门逐项确认统计口径和数据来源，形成主要指标表，口径说明写入专栏。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="上一周期规划执行数据" />
          <b2g:property name="输入" value="集团战略与科技规划文件集" />
          <b2g:property name="输出" value="主要指标表及口径说明" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_84f097af-ecf8-4f1e-9b60-7739ee204ade</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d140af10-7102-497b-bf0f-76592210e87d</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_720d4b8f-81a3-4948-ba58-e703709571c2">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d140af10-7102-497b-bf0f-76592210e87d</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_3322b189-e921-42f4-825a-0370bec746be</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_d63b8d2b-3a97-4159-9e65-c618de3a3b24</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_da26f656-4901-46a1-a4f0-6784bb182131</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_66fdf867-0f14-4827-a24f-b99daf63cc3c</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_2b597b24-795e-4639-9dff-7a67deaea461" name="编制关键技术布局">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按“分层”原则编写技术布局章节。根技术（如系统集成、复杂结构、能源动力、控制算法）侧重长期积累，写研究重点和要积累的方法、模型与验证能力。下一代关键技术侧重任务突破，每项写研究目标、验证场景和产品承接要求。全寿命周期技术（造修一体、状态修、延寿评估）以重点任务专栏列出。战新及未来产业技术储备说明与主业的协同关系，按成熟度分阶段投入。判断一项技术放在哪一层的依据：是否跨产品共性、是否有明确的产品承接对象、成熟度高低。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线V1.0" />
          <b2g:property name="输入" value="《行业技术趋势与对标研究报告》" />
          <b2g:property name="输出" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3322b189-e921-42f4-825a-0370bec746be</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_9a732c09-c339-4a62-b62a-ad33d6497ccd</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_9ab31a91-b5e1-423a-b9ea-53da7358b569" name="编制重点产品开发规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按车辆产品（机车、城轨、动车组、磁浮）、“产品+”与数智产业产品、战新及未来产业产品三类编写产品开发章节。每类先写期末产品谱系目标，再以专栏列出重点产品及方向，每个产品写清面向的市场、核心技术和要达到的能力。筛选重点产品的依据：有无明确市场需求、能否支撑主业升级或服务转型、能否复用技术平台成果。战新产业突出产品定义和场景验证，未来产业按原理样机、典型场景、商业可行性分阶段验证。数智产品可按年份写出分阶段推进安排。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线V1.0" />
          <b2g:property name="输入" value="业务单位与市场用户科技需求汇总表" />
          <b2g:property name="输出" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d63b8d2b-3a97-4159-9e65-c618de3a3b24</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_cee6706c-edd7-4d84-911b-a169d1dbf6a6</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_bec603a3-2421-4b1f-9f3f-c8bb372d3016" name="编制科技创新体系建设任务">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="编写科技创新体系章节，任务直接对应第一章提出的体系问题。内容包括：科技治理与研发组织（技术委员会、研究院实体化、多地资源统筹、立项与规划贯通），正向研发与成果转化（需求与构型管理、分层研发、技术平台管理、成熟度评价、转化路径），开放协同与知识产权标准认证，工艺与质量体系，工艺材料与试验验证。每项任务写明要建立的机制或能力，涉及权限和机构设置的写为“按公司制度落实”。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="科技规划大纲基线V1.0" />
          <b2g:property name="输出" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_da26f656-4901-46a1-a4f0-6784bb182131</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_66943ce9-825d-4174-a143-5d0701ef95ed</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_61b10644-ca84-49c0-b259-7c377856e1e3" name="编制规划实施保障">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="编写实施保障章节，包括科技人才、科技投入、研发基础条件、规划实施与评估。实施安排分三个阶段（如夯基整合、突破示范、固化收官），每个阶段写明重点任务和阶段成果。明确年度调度机制（年初定目标、季度跟踪、半年度专题评估、年度报告）、中期和总结评估、风险清单（技术路线、供应、知识产权、标准认证、数据网络安全、进度、成果转化）和滚动修编的触发条件，并规定规划任务通过年度科研指南落地。" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输入" value="公司科研管理制度" />
          <b2g:property name="输出" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="相关职能部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_66fdf867-0f14-4827-a24f-b99daf63cc3c</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_5373ae3a-df9b-48f1-9d96-91c5bcabc5a6</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_ca40e57f-0156-4ef5-9b90-cb78329939fd">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_9a732c09-c339-4a62-b62a-ad33d6497ccd</bpmn2:incoming>
      <bpmn2:incoming>EBPM_cee6706c-edd7-4d84-911b-a169d1dbf6a6</bpmn2:incoming>
      <bpmn2:incoming>EBPM_66943ce9-825d-4174-a143-5d0701ef95ed</bpmn2:incoming>
      <bpmn2:incoming>EBPM_5373ae3a-df9b-48f1-9d96-91c5bcabc5a6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e0b6e383-9ca2-413a-b193-02041a4b6d52</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_803369cb-eb7d-4614-ab77-be37132f43dc" name="形成重点任务清单">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="汇总第三至五章的专栏和重点任务，形成规划重点任务清单。每项任务写明依据（对应的大纲条目）、牵头和协同责任、阶段节点、资源需求、预期成果和验收要求。检查任务与发展目标、主要指标是否对应，避免出现没有任务支撑的目标或没有目标指向的任务。该清单是年度分解和科研指南编制的直接依据。" />
          <b2g:property name="输入" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="输入" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="输入" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="输入" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输出" value="规划重点任务清单" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e0b6e383-9ca2-413a-b193-02041a4b6d52</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_0668e4af-206a-4c31-9f82-aef7d8f16f19</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_8e305163-66c2-4535-a76c-e537ac904a06" name="统稿形成规划初稿">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="统稿人合并各章并编写摘要，统一术语、数据和表述风格。做一致性检查：问题与任务对应、目标与指标对应、任务与保障对应，各章引用的产品和技术名称一致，指标数值与口径说明一致。删除与规划层级不符的过细内容（如具体项目），形成规划初稿。" />
          <b2g:property name="输入" value="规划第一章《发展基础与形势要求》稿" />
          <b2g:property name="输入" value="规划第二章《总体要求》稿" />
          <b2g:property name="输入" value="规划第三章《关键技术布局》稿" />
          <b2g:property name="输入" value="规划第四章《重点产品开发》稿" />
          <b2g:property name="输入" value="规划第五章《科技创新体系建设》稿" />
          <b2g:property name="输入" value="规划第六章《规划实施保障》稿" />
          <b2g:property name="输入" value="规划重点任务清单" />
          <b2g:property name="输入" value="主要指标表及口径说明" />
          <b2g:property name="输出" value="科技发展规划初稿" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_0668e4af-206a-4c31-9f82-aef7d8f16f19</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_8edaff99-2637-45f4-96d0-17886b94eb09</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_2126314f-7bec-4037-b2d1-eef056dd343b" name="科技发展规划规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="把规划初稿按规范导入“03-科技规划文本”模块（前缀TPDT），章节为标题对象，正文按“一个对象一个要点”拆分，专栏表格每行一个对象。导入后核对对象层级与章节是否一致。" />
          <b2g:property name="输入" value="科技发展规划初稿" />
          <b2g:property name="输入" value="《DOORS规划数据管理规范》" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8edaff99-2637-45f4-96d0-17886b94eb09</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_ee9af5f5-9443-4e06-b6ee-16e558dc7b9f</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_b9207183-0f08-44b7-8442-72a96521578d" name="创建科技发展规划与科技发展规划大纲的追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="按大纲与规划章节对应表，由各章编写组从规划对象向大纲对象创建链接（规划指向大纲），一个规划对象可以链接多个大纲条目。摘要和过渡性段落可以不建链。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="科技规划大纲基线V1.0" />
          <b2g:property name="输入" value="大纲与规划章节对应表" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ee9af5f5-9443-4e06-b6ee-16e558dc7b9f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_14bfdaa8-987d-4781-b51e-b40672404ff7</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_eb629858-48c1-4aa6-8e5e-b43a0584af5b">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_14bfdaa8-987d-4781-b51e-b40672404ff7</bpmn2:incoming>
      <bpmn2:incoming>EBPM_c1bc95bb-c3d1-4850-b33a-8e05e51745c7</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_73998e2a-3483-451d-b73d-1fe2f14eb76e</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_539c063c-0695-4090-82d2-82192e59a788" name="开展大纲承接性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="在DOORS中检查：大纲模块中没有任何规划入链的条目（大纲要点未被承接），以及规划模块中没有出链的实质性条目（规划新增内容）。对未承接的大纲条目提出处理建议（补充规划内容或说明不承接理由），对规划新增内容确认其合理性。再通过“需求—大纲—规划”两级链接，检查关键需求是否最终落到规划条目上。" />
          <b2g:property name="输入" value="规划至大纲追溯链接" />
          <b2g:property name="输入" value="大纲至需求追溯链接" />
          <b2g:property name="输入" value="关键需求清单" />
          <b2g:property name="输出" value="《大纲承接性分析报告》" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_73998e2a-3483-451d-b73d-1fe2f14eb76e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_ffb2d5af-bee0-45c1-b78c-f01417b08fc5</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_41b6b552-c8d9-4831-881b-a8e4878b53e9" name="大纲条目是否全部承接？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="判定标准：大纲条目全部有规划入链或有经确认的不承接理由，关键需求经两级链接都能追溯到规划条目，规划新增的实质性内容均已确认。" />
          <b2g:property name="责任主体" value="规划编制工作组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ffb2d5af-bee0-45c1-b78c-f01417b08fc5</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_624ac279-1872-4481-aa00-9b1f3812584a</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_e21c7915-0843-4d47-8d16-514fb650edac</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_09987f72-e1dc-4b30-a7ed-a27218071959" name="补充调整规划条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="根据大纲承接性分析报告，在DOORS规划模块中补充或修改规划内容并补建链接，对不承接的大纲条目在大纲对象中记录理由。调整后重新开展承接性分析。" />
          <b2g:property name="输入" value="《大纲承接性分析报告》" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e21c7915-0843-4d47-8d16-514fb650edac</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_c1bc95bb-c3d1-4850-b33a-8e05e51745c7</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_087a68ba-c701-45a6-a378-d1c1814b0453" name="发布科技发展规划基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划制定" />
          <b2g:property name="步骤描述" value="对“03-科技规划文本”模块创建基线V0.1（征求意见稿），并从基线导出征求意见稿文本。此后的修订都在当前版本上进行，可以随时与该基线比较，得到修订对照。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="《大纲承接性分析报告》" />
          <b2g:property name="输出" value="科技发展规划基线V0.1（征求意见稿）" />
          <b2g:property name="输出" value="科技发展规划征求意见稿" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_624ac279-1872-4481-aa00-9b1f3812584a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_ae9440f8-784c-4469-ade9-861136706ecb</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_858f53cd-aa12-4c54-8bf8-7495b9d41b0c" name="进行科技发展规划修订意见征集">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="科技管理部门通过OA发出征求意见通知并附征求意见稿，向公司各部门、分子公司、株机研究院和外部专家征求意见，规定反馈期限和意见表格式（章节或对象编号、原文、修改建议、理由），要求意见具体到章节或对象，便于逐条处理。" />
          <b2g:property name="输入" value="科技发展规划征求意见稿" />
          <b2g:property name="输出" value="修订意见征集通知" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_ae9440f8-784c-4469-ade9-861136706ecb</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a4419c2b-8e94-49c9-b8ec-460fc0eb7575</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_2c54e2d4-bfbd-41e3-88ad-32dc70fe9f26" name="提出科技发展规划修订意见">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="各单位和专家按意见表格式反馈修订意见并说明理由。涉及指标调整的提供测算依据，涉及新增任务的说明所依据的需求或问题。" />
          <b2g:property name="输入" value="修订意见征集通知" />
          <b2g:property name="输入" value="科技发展规划征求意见稿" />
          <b2g:property name="输出" value="科技发展规划修订意见" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
          <b2g:property name="责任主体" value="相关职能部门" />
          <b2g:property name="责任主体" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a4419c2b-8e94-49c9-b8ec-460fc0eb7575</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b01a9b1e-7f78-490a-8be3-dd1b7c3bcba5</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_14cfd58a-b4cd-4c36-a6bf-1669e79d3002">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b01a9b1e-7f78-490a-8be3-dd1b7c3bcba5</bpmn2:incoming>
      <bpmn2:incoming>EBPM_55332680-586a-4542-ad6f-1f6e4b2cf4fd</bpmn2:incoming>
      <bpmn2:incoming>EBPM_5d880146-bbcb-4e61-8b76-d30f36ac223c</bpmn2:incoming>
      <bpmn2:incoming>EBPM_d307ef76-7a8d-4b7a-9b88-0f0e7ff5e85b</bpmn2:incoming>
      <bpmn2:incoming>EBPM_b629d169-52ad-42aa-b45b-bfd87cefe26c</bpmn2:incoming>
      <bpmn2:incoming>EBPM_9e011815-a344-43c2-804b-3e07fa5042a1</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7ed026a6-eb37-42d5-beb4-48bd767b8302</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_8796a284-3697-407b-948b-c70e342bfde0" name="汇总分析修订意见并形成处理意见">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="编制工作组汇总征求意见、各级评审意见、审议意见和规划修编需求，逐条给出处理意见：采纳、部分采纳或不采纳，不采纳的写明理由。涉及目标、指标或重点方向调整的意见，提交分管领导确定。形成修订意见处理表，作为修订依据和后续评审的说明材料。" />
          <b2g:property name="输入" value="科技发展规划修订意见" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输入" value="党委会前置研究意见" />
          <b2g:property name="输入" value="总经理办公会审议意见" />
          <b2g:property name="输入" value="规划修编需求" />
          <b2g:property name="输出" value="修订意见处理表" />
          <b2g:property name="责任主体" value="规划编制工作组" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7ed026a6-eb37-42d5-beb4-48bd767b8302</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b6832c6a-be89-4244-a012-31da51c3ebed</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_287999f7-c46b-4076-b97c-4d2eee7111fb" name="修订规划文本并更新DOORS模块">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="按修订意见处理表直接在DOORS规划模块中修改对象，新增和删除对象按规范处理（删除采用软删除，保留历史）。改动较大的章节可以在DOORS外修改后对照更新，保证DOORS模块始终是规划文本的唯一权威版本。修订后与上一基线比较，导出修订对照表。" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="规划修订对照表" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b6832c6a-be89-4244-a012-31da51c3ebed</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7fb4f06d-17ef-40b3-80b8-df94e31bc6b6</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_95110ad3-2e65-4e3e-b535-2cfbace86b49" name="处理疑似链接并复核追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="规划或大纲对象修改后，DOORS会把相关链接标为疑似链接。逐条查看疑似链接，确认链接关系是否仍然成立：成立的清除疑似标记，不成立的删除或改建。为新增对象补建到大纲的链接，必要时复查大纲承接性。修订涉及大纲调整的，同步更新大纲模块并创建大纲新基线。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="规划修订对照表" />
          <b2g:property name="输出" value="规划至大纲追溯链接" />
          <b2g:property name="输出" value="追溯关系复核记录" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="责任主体" value="各专题组" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7fb4f06d-17ef-40b3-80b8-df94e31bc6b6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_840fb929-c09b-4fbd-b372-8e08b0b449e3</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_ec996ad8-5e9e-4396-81c1-cdac10871601" name="组织进行一级评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="科技管理部门组织专家组（内部专家，必要时邀请外部专家）评审规划修订稿。评审重点：形势判断是否准确、目标指标是否合理可达、技术和产品方向是否正确、任务能否落地、与上位规划和公司发展规划是否衔接。评审材料包括规划修订稿、修订意见处理表和追溯关系复核记录。形成一级评审意见。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="追溯关系复核记录" />
          <b2g:property name="输出" value="一级评审意见" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="专家组" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_840fb929-c09b-4fbd-b372-8e08b0b449e3</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a86e7ccf-5cde-454d-85b2-c9fba4572af0</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_fb130f3d-ca09-4481-a19d-0721a730c084" name="一级评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="判定标准：专家组结论为“通过”的进入二级评审。结论为“修改后通过”且只有文字性意见的，由科技管理部门确认修改到位后视为通过。结论为“不通过”或存在方向性意见的，退回汇总分析修订意见，修订后重新评审。" />
          <b2g:property name="责任主体" value="专家组" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a86e7ccf-5cde-454d-85b2-c9fba4572af0</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_595d9f70-2867-41fa-9d3d-a220d048ccd2</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_55332680-586a-4542-ad6f-1f6e4b2cf4fd</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_eb49956f-c751-44f5-b356-0af0de053396" name="组织进行二级评审">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="提交公司技术委员会评审，发挥其对科技战略、技术路线和重大事项的决策支撑作用。评审重点：规划与公司战略的一致性、重大方向和资源投入的合理性、主要指标的可行性、跨部门任务的责任分工。形成二级评审意见。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输出" value="二级评审意见" />
          <b2g:property name="责任主体" value="技术委员会" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_595d9f70-2867-41fa-9d3d-a220d048ccd2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_783074d7-f3f6-47d0-a115-07a71499f36a</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_584af85d-2fa7-4c66-8b82-5b5ff1151aa3" name="二级评审是否通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="判定标准：技术委员会结论为“通过”的进入上会准备。提出修改意见的，退回汇总分析修订意见，修订后视修改程度决定是否重新经过一级评审。" />
          <b2g:property name="责任主体" value="技术委员会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_783074d7-f3f6-47d0-a115-07a71499f36a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_a4963f92-342c-4651-ba7c-5835479fc19f</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_5d880146-bbcb-4e61-8b76-d30f36ac223c</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_25358668-c62d-4568-acbe-43ec0ee8a185" name="发布科技发展规划评审稿基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="二级评审通过后，对规划模块创建基线V0.9（评审稿），同时确认大纲和需求模块的基线状态，保证提交审议的版本可追溯。从基线导出评审稿文本用于上会。" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输出" value="科技发展规划基线V0.9（评审稿）" />
          <b2g:property name="输出" value="科技发展规划评审稿" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_a4963f92-342c-4651-ba7c-5835479fc19f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7f864566-9a3a-4b96-8192-43994ae40628</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_d3501168-e174-4568-a15b-3aa282172156" name="编写科技发展规划上会议案">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划修订评审" />
          <b2g:property name="步骤描述" value="按公司议案格式编写上会议案，内容包括编制背景和依据、编制过程（需求收集范围、征求意见和评审情况）、规划主要内容（目标、指标、重点任务）、需要会议决策的事项（如重大投入、组织调整）以及意见处理情况。" />
          <b2g:property name="输入" value="科技发展规划评审稿" />
          <b2g:property name="输入" value="修订意见处理表" />
          <b2g:property name="输入" value="一级评审意见" />
          <b2g:property name="输入" value="二级评审意见" />
          <b2g:property name="输出" value="科技发展规划上会议案" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_7f864566-9a3a-4b96-8192-43994ae40628</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b252a667-4d3c-4029-a089-3cf1002399f1</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_ce6fa7e2-2175-4c79-9161-e9f104d3ef09" name="提交党委会前置研究">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="按“三重一大”决策程序，把规划上会议案提交公司党委会前置研究，重点把关规划的方向和与公司战略的一致性，形成前置研究意见。" />
          <b2g:property name="输入" value="科技发展规划上会议案" />
          <b2g:property name="输入" value="科技发展规划评审稿" />
          <b2g:property name="输出" value="党委会前置研究意见" />
          <b2g:property name="责任主体" value="公司党委会" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b252a667-4d3c-4029-a089-3cf1002399f1</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_51a6a1cc-c486-40d9-b2be-93443192828a</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_1f862c5b-2e10-4f7a-8a2f-ad56bf4d7f91" name="党委会是否同意提交审议？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="判定标准：前置研究意见为同意提交审议的，进入总经理办公会审议。提出修改要求的，退回修订评审子流程汇总分析修订意见，修订后按修改程度决定是否重新评审。" />
          <b2g:property name="责任主体" value="公司党委会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_51a6a1cc-c486-40d9-b2be-93443192828a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_704ca6b9-b72e-4095-a457-167039c27a66</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_d307ef76-7a8d-4b7a-9b88-0f0e7ff5e85b</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_99e06bb3-6b61-4719-b66b-bffca13b312a" name="提交总经理办公会审议">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="把规划上会议案提交总经理办公会审议，重点审议目标指标、重点任务、资源投入和责任分工，形成审议决定或会议纪要。" />
          <b2g:property name="输入" value="科技发展规划上会议案" />
          <b2g:property name="输入" value="党委会前置研究意见" />
          <b2g:property name="输出" value="总经理办公会审议意见" />
          <b2g:property name="责任主体" value="总经理办公会" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_704ca6b9-b72e-4095-a457-167039c27a66</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_930d7a2b-3e6a-4531-bef6-6b328ba3ea37</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_405d053b-0589-40ef-a2c6-dbd8bb77e95a" name="总经理办公会是否审议通过？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="判定标准：审议通过或只有文字性修改要求的，进入印发。提出实质性修改要求的，退回修订评审子流程汇总分析修订意见。" />
          <b2g:property name="责任主体" value="总经理办公会" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_930d7a2b-3e6a-4531-bef6-6b328ba3ea37</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_b89f1ee1-dc31-451c-96a2-133f8a290166</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_b629d169-52ad-42aa-b45b-bfd87cefe26c</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_214a08ad-be30-4d6f-8b21-ffcb76f3801b" name="印发科技发展规划">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="根据审议意见完成最后的文字修改（如有，同步更新DOORS模块），按公司公文程序通过OA正式印发规划。" />
          <b2g:property name="输入" value="总经理办公会审议意见" />
          <b2g:property name="输入" value="科技发展规划评审稿" />
          <b2g:property name="输出" value="科技发展规划正式印发文件" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_b89f1ee1-dc31-451c-96a2-133f8a290166</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_8ffd74c3-242c-49bf-a4cc-3f33a9431075</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_1199ecd6-21b4-4a85-98e3-15723943b174" name="发布科技发展规划正式基线">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="对规划模块创建基线V1.0（正式版，滚动修编后为V1.x），内容与印发文本一致，同时锁定本轮使用的需求和大纲基线。正式基线是年度科研指南建立追溯链接的唯一依据，此后对规划的任何修改都须走滚动修编程序。" />
          <b2g:property name="输入" value="科技发展规划正式印发文件" />
          <b2g:property name="输入" value="科技发展规划DOORS模块" />
          <b2g:property name="输出" value="科技发展规划基线V1.0（正式版）" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_8ffd74c3-242c-49bf-a4cc-3f33a9431075</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f1f32981-4a50-4e3c-a1f9-7094eecfad04</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:manualTask id="EBPM_678056bc-a3b4-4a5e-b70d-5a638d2dd3be" name="开展规划宣贯与任务分解">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科技发展规划审议发布" />
          <b2g:property name="步骤描述" value="面向各部门、分子公司和研发人员开展规划宣贯。把规划重点任务清单分解到年度，按三阶段安排明确每年应启动和应完成的任务，明确牵头部门、协同单位和成果节点，形成规划任务分解表，纳入公司规划实施体系和年度调度。" />
          <b2g:property name="输入" value="科技发展规划基线V1.0（正式版）" />
          <b2g:property name="输入" value="规划重点任务清单" />
          <b2g:property name="输出" value="规划任务分解表" />
          <b2g:property name="输出" value="规划宣贯材料" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f1f32981-4a50-4e3c-a1f9-7094eecfad04</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_40d2edd8-43f6-4dd4-8ac9-345291c82488</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:exclusiveGateway id="EBPM_d51d3c92-8253-4f0a-97d7-6cf003549d99">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_40d2edd8-43f6-4dd4-8ac9-345291c82488</bpmn2:incoming>
      <bpmn2:incoming>EBPM_6b2e0e71-4ac8-496f-a15b-c34f20f1ceae</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_36de7210-3aad-4070-bc33-ec681621c548</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:manualTask id="EBPM_4733ae12-b47f-43c4-956d-9d0c1514999e" name="启动年度科研指南编制">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="每年按科研计划工作安排（一般在上一年第四季度）启动下一年度科研指南编制，通过OA发出编制通知，明确指南年度、编制节点和项目需求申报要求。首年依据新发布的规划启动，以后各年同时参考上年度规划实施评估结果。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="公司科研管理制度" />
          <b2g:property name="输出" value="年度科研指南编制通知" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="信息系统" value="OA" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_36de7210-3aad-4070-bc33-ec681621c548</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_296ac276-e618-489f-851b-708269102264</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_a35b967e-adc9-4887-a4b7-ba88c6efb8a9">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_296ac276-e618-489f-851b-708269102264</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_54dbd2b6-cf53-48e1-afe3-5def4caefa07</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_f4bcb471-fe67-4d1f-b9f1-3f6ded3cccc6</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_cc5b67a0-2416-42ff-9a1f-0e92a7a7824d</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_d378711c-2557-4011-ba1a-3bbff22c1b8b" name="分解规划年度任务">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="依据规划任务分解表和实施阶段安排，结合在研项目进展，确定本年度应通过科研项目启动或延续的规划任务，形成规划年度任务清单。基础和前沿研究按三至五年稳定支持的原则安排延续，工程开发任务按产品节点安排。" />
          <b2g:property name="输入" value="规划任务分解表" />
          <b2g:property name="输入" value="科技发展规划基线V1.0（正式版）" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输出" value="规划年度任务清单" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_54dbd2b6-cf53-48e1-afe3-5def4caefa07</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_76bab5d3-efb7-4222-8b7d-287ac22911a1</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_5634a826-e18a-4aae-8ec5-f2d17a64ebd0" name="收集年度科研项目需求">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="各单位按通知申报年度科研项目需求，说明需求来源（规划任务、产品开发、现场问题、用户需求）、研究内容、预期成果和资源需求，使自上而下的规划部署与现场需求反馈相结合。" />
          <b2g:property name="输入" value="年度科研指南编制通知" />
          <b2g:property name="输入" value="业务单位科技需求反馈" />
          <b2g:property name="输出" value="年度科研项目需求汇总表" />
          <b2g:property name="责任主体" value="各业务单位及分子公司" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f4bcb471-fe67-4d1f-b9f1-3f6ded3cccc6</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_152a72aa-4487-4b61-bed2-aa79b3bf885f</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_0da954de-25e3-46d5-a055-a6e6c3f37148" name="分析上年度规划实施评估结果">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="从上年度规划实施评估报告中提取对本年度指南的影响：进展滞后需要加强的方向、已完成可以退出的任务、偏离方向需要调整的项目、新出现的需求。首年没有上年度评估时，使用上一周期规划实施评估报告。" />
          <b2g:property name="输入" value="规划年度实施评估报告" />
          <b2g:property name="输入" value="《上一周期科技规划实施评估报告》" />
          <b2g:property name="输出" value="年度指南调整建议" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_cc5b67a0-2416-42ff-9a1f-0e92a7a7824d</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_7293d0c2-a8c3-4692-ae5c-d4489a50ddd9</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:parallelGateway id="EBPM_219f1db2-b225-45c0-8fa0-c046f716bd9f">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_76bab5d3-efb7-4222-8b7d-287ac22911a1</bpmn2:incoming>
      <bpmn2:incoming>EBPM_152a72aa-4487-4b61-bed2-aa79b3bf885f</bpmn2:incoming>
      <bpmn2:incoming>EBPM_7293d0c2-a8c3-4692-ae5c-d4489a50ddd9</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_116d3204-902e-4c71-ac30-2ce3733c17bd</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="EBPM_9bb1fce7-fcb1-4dca-a8bc-de36e4913239" name="确定年度指南方向与项目分类">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="综合规划年度任务清单、年度项目需求和调整建议，确定本年度指南支持方向，并按基础研究、共性技术、工程开发、成果转化分类，各类采用不同的支持方式和评价要求。结合年度科技投入预算确定各方向规模，保证基础研究及应用基础研究投入占比满足规划指标。" />
          <b2g:property name="输入" value="规划年度任务清单" />
          <b2g:property name="输入" value="年度科研项目需求汇总表" />
          <b2g:property name="输入" value="年度指南调整建议" />
          <b2g:property name="输入" value="年度科技投入预算" />
          <b2g:property name="输出" value="年度指南方向及项目分类表" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_116d3204-902e-4c71-ac30-2ce3733c17bd</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_f9d0a55e-1c1f-4bf6-9c81-b63043409e8a</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:manualTask id="EBPM_03c1da55-9f06-470a-9ecd-7451a5bde165" name="编制科研项目指南">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按方向编写指南条目，每个条目包括研究目标、已有成果、研究增量、建议承接主体、资源需求、预期成果与验收要求（含技术成熟度要求）以及依据的规划条目（对象标识）。条目要同步明确工程承接与应用场景，避免低水平重复投入。" />
          <b2g:property name="输入" value="年度指南方向及项目分类表" />
          <b2g:property name="输入" value="科技发展规划基线V1.0（正式版）" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输出" value="科研项目指南初稿" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="株机研究院" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_f9d0a55e-1c1f-4bf6-9c81-b63043409e8a</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_e4b0c7b6-fe0d-4309-9b06-99809b5823d2</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="EBPM_7c2851af-4988-46c4-ad82-0dcf25d66f10" name="科研项目指南规范性导入DOORS">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="在“04-科研项目指南”下按年度建立或更新指南模块并按规范导入，方向为标题对象，指南条目为正文对象，研究目标、承接主体、验收要求等可作为对象属性管理。" />
          <b2g:property name="输入" value="科研项目指南初稿" />
          <b2g:property name="输入" value="《DOORS规划数据管理规范》" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_e4b0c7b6-fe0d-4309-9b06-99809b5823d2</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_61c8f056-d83f-4119-a426-98290e52509e</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EBPM_4f97a4ac-85ac-43d2-a0ac-4b2e1ae2ea46" name="创建科研项目指南与科技发展规划的追溯关系">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="按指南条目注明的规划依据，从指南对象向规划正式基线中的对象创建链接（指南指向规划）。" />
          <b2g:property name="输入" value="科研项目指南DOORS模块" />
          <b2g:property name="输入" value="科技发展规划基线V1.0（正式版）" />
          <b2g:property name="输出" value="指南至规划追溯链接" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_61c8f056-d83f-4119-a426-98290e52509e</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_d08778ef-5f75-48c6-b6ca-02bf1b1b4f04</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_d12067f7-e609-4dbb-9874-40383eccf50f">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_d08778ef-5f75-48c6-b6ca-02bf1b1b4f04</bpmn2:incoming>
      <bpmn2:incoming>EBPM_9730757c-8b9e-475a-b58f-19bc896b895f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_3761cd81-e3c6-4489-b9bc-db7974d92b3f</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_f37faed3-108b-489e-b3ef-db0b4f2010d8" name="开展规划承接与重复性分析">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="在DOORS中检查三项内容。一是指南条目是否都有规划依据，没有依据的须说明来源（如现场紧急问题）。二是规划年度任务清单中本年应启动的任务是否都被指南覆盖，可以通过规划模块的入链统计各规划任务被历年指南承接的情况。三是与在研项目和历年指南对比，排除重复立项。" />
          <b2g:property name="输入" value="指南至规划追溯链接" />
          <b2g:property name="输入" value="规划年度任务清单" />
          <b2g:property name="输入" value="在研项目清单" />
          <b2g:property name="输出" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_3761cd81-e3c6-4489-b9bc-db7974d92b3f</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_008aa3a2-5018-484e-bb64-4d45d70cc613</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="EBPM_dfbc2551-369c-4ea4-bbff-e9d85dbf29c1" name="指南条目依据是否充分？">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="判定标准：指南条目都有规划依据或经认可的来源说明，本年应启动的规划任务都已覆盖或有推迟理由，与在研项目和历年指南无重复。" />
          <b2g:property name="责任主体" value="科技管理部门" />
        </b2g:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>EBPM_008aa3a2-5018-484e-bb64-4d45d70cc613</bpmn2:incoming>
      <bpmn2:outgoing>EBPM_5fe432af-618d-4d1a-a7a6-8cb503c1b540</bpmn2:outgoing>
      <bpmn2:outgoing>EBPM_72e75f87-22a8-42e0-9b52-f97b5c3f3600</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="EBPM_e819376f-4e8f-411e-83b4-4c8bfefc38cc" name="调整指南条目及链接">
      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="补充、修改或删除指南条目并补建链接，对推迟的规划任务记录理由并在下一年度优先考虑。调整后重新开展承接与重复性分析。" />
          <b2g:property name="输入" value="《指南规划承接与重复性分析报告》" />
          <b2g:property name="输出" value="科研项目指南DOORS模块" />
          <b2g:property name="输出" value="指南至规划追溯链接" />
          <b2g:property name="责任主体" value="科技管理部门" />
          <b2g:property name="责任主体" value="DOORS数据管理员" />
          <b2g:property name="信息系统" value="DOORS 9.7.2" />

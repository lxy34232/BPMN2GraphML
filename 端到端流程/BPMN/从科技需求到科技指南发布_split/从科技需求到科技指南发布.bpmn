      <bpmn2:extensionElements>
        <b2g:properties>
          <b2g:property name="来源流程" value="科研项目指南编制" />
          <b2g:property name="步骤描述" value="通过OA向各单位和专家发出指南征求意见通知并附征求意见稿，规定反馈期限和意见格式。" />
          <b2g:property name="输入" value="科研项目指南征求意见稿" />
